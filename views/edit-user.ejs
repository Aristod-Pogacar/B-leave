<%- include('partials/head.ejs') %>

    <body>
        <%- include('partials/sidebar.ejs') %>
            <%- include('partials/header.ejs') %>

                <main class="nxl-container">
                    <div class="nxl-content">

                        <div class="page-header">
                            <div class="page-header-left d-flex align-items-center">
                                <div class="page-header-title">
                                    <h5 class="m-b-10">B-Leave</h5>
                                </div>
                                <ul class="breadcrumb">
                                    <li class="breadcrumb-item">Users</li>
                                    <li class="breadcrumb-item">Edit User</li>
                                </ul>
                            </div>
                        </div>

                        <div class="main-content">
                            <div class="tab-content">
                                <div class="tab-pane fade active show">

                                    <div class="row">
                                        <div class="col-12">

                                            <div class="card stretch stretch-full d-flex">

                                                <!-- Header -->
                                                <div class="card-header border-bottom">
                                                    <div class="d-flex align-items-center">

                                                        <div>
                                                            <h3 class="mb-1">Edit User</h3>
                                                            <p class="text-muted mb-0">
                                                                Update user information and permissions.
                                                            </p>
                                                        </div>

                                                    </div>
                                                </div>

                                                <!-- Body -->
                                                <div class="card-body">

                                                    <% if (locals.error) { %>
                                                        <div class="alert alert-danger mb-4">
                                                            <%= error %>
                                                        </div>
                                                        <% } %>

                                                            <form id="userForm" method="POST"
                                                                action="/user/edit-user/<%= users.id %>">

                                                                <!-- Personal Information -->
                                                                <div class="mb-4">

                                                                    <h5 class="fw-semibold mb-3">
                                                                        <i class="bi bi-person me-2 text-primary"></i>
                                                                        Personal Information
                                                                    </h5>

                                                                    <div class="row">

                                                                        <div class="col-md-4 mb-3">
                                                                            <label class="form-label">
                                                                                Name *
                                                                            </label>
                                                                            <input type="text" class="form-control"
                                                                                id="name" name="name"
                                                                                value="<%= users.name %>" required>
                                                                        </div>

                                                                        <div class="col-md-4 mb-3">
                                                                            <label class="form-label">
                                                                                First Name *
                                                                            </label>
                                                                            <input type="text" class="form-control"
                                                                                id="firstName" name="firstName"
                                                                                value="<%= users.firstName %>" required>
                                                                        </div>

                                                                        <div class="col-md-4 mb-3">
                                                                            <label class="form-label">
                                                                                Phone Number *
                                                                            </label>
                                                                            <input type="text" class="form-control"
                                                                                id="phone" name="phone"
                                                                                value="<%= users.phone %>" required>
                                                                        </div>

                                                                    </div>

                                                                </div>

                                                                <!-- Account Information -->
                                                                <div>

                                                                    <h5 class="fw-semibold mb-3">
                                                                        <i
                                                                            class="bi bi-person-badge me-2 text-primary"></i>
                                                                        Access & Permissions
                                                                    </h5>

                                                                    <div class="row">

                                                                        <div class="col-md-4 mb-3">
                                                                            <label class="form-label">
                                                                                Email
                                                                            </label>
                                                                            <input type="email" class="form-control"
                                                                                id="email" name="email"
                                                                                value="<%= users.email %>">
                                                                        </div>

                                                                        <div class="col-md-4 mb-3">
                                                                            <label class="form-label">
                                                                                Role *
                                                                            </label>

                                                                            <select class="form-select" id="role"
                                                                                name="role" required>

                                                                                <% Object.keys(userRole).forEach(key=> {
                                                                                    %>

                                                                                    <% if(userRole[key]
                                                                                        !==userRole.SUPERADMIN) { %>

                                                                                        <option
                                                                                            value="<%= userRole[key] %>"
                                                                                            <%=userRole[key]===users.role
                                                                                            ? 'selected' : '' %>>
                                                                                            <%= userRole[key] %>
                                                                                        </option>

                                                                                        <% } %>

                                                                                            <% }) %>

                                                                            </select>
                                                                        </div>

                                                                        <div class="col-md-4 mb-3">
                                                                            <label class="form-label">
                                                                                Site *
                                                                            </label>

                                                                            <select class="form-select" id="site"
                                                                                name="site" required>

                                                                                <% Object.keys(site).forEach(key=> { %>

                                                                                    <option value="<%= site[key] %>"
                                                                                        <%=site[key]===users.site
                                                                                        ? 'selected' : '' %>>
                                                                                        <%= site[key] %>
                                                                                    </option>

                                                                                    <% }) %>

                                                                            </select>
                                                                        </div>

                                                                    </div>

                                                                </div>

                                                            </form>

                                                </div>

                                                <!-- Footer -->
                                                <div class="card-footer d-flex justify-content-end gap-2 bg-light">

                                                    <a href="/user/list" class="btn btn-light">
                                                        Cancel
                                                    </a>

                                                    <button type="submit" form="userForm" class="btn btn-primary">

                                                        <i class="feather-save me-2"></i>
                                                        Update User

                                                    </button>

                                                </div>

                                            </div>

                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>

                    </div>

                    <%- include('partials/footer.ejs') %>

                </main>

    </body>

    <script>
        const roleSelect = document.getElementById("role");
        const siteSelect = document.getElementById("site");

        const allSiteOptions = Array.from(siteSelect.options);

        function filterSites() {

            const role = roleSelect.value;

            const restrictedRoles = [
                "HR_LEAD",
                "MANAGER",
                "ADMIN",
                "PAYROLL"
            ];

            const allowedSites = [
                "TANA",
                "ABE 1",
                "ABE 2"
            ];

            siteSelect.innerHTML = "";

            let filteredOptions;

            if (restrictedRoles.includes(role)) {
                filteredOptions = allSiteOptions.filter(option =>
                    allowedSites.includes(option.value)
                );
            } else {
                filteredOptions = allSiteOptions;
            }

            filteredOptions.forEach(option => {
                siteSelect.appendChild(option.cloneNode(true));
            });

            siteSelect.value = "<%= users.site %>";
        }

        roleSelect.addEventListener("change", filterSites);

        filterSites();
    </script>

    </html>