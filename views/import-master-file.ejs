<%- include('partials/head.ejs') %>

    <body>
        <%- include('partials/sidebar.ejs') %>
            <%- include('partials/header.ejs') %>

                <main class="nxl-container">
                    <div class="nxl-content">

                        <div class="page-header">
                            <div class="page-header-left d-flex align-items-center">
                                <div class="page-header-title">
                                    <h5 class="m-b-10">B-Leave</h5>
                                </div>
                                <ul class="breadcrumb">
                                    <li class="breadcrumb-item">Employees</li>
                                    <li class="breadcrumb-item">Import Employees</li>
                                </ul>
                            </div>
                        </div>

                        <div class="main-content">
                            <div class="tab-content">
                                <div class="tab-pane fade active show">

                                    <div class="row">
                                        <div class="col-lg-8 mx-auto">

                                            <div class="card stretch stretch-full">

                                                <!-- Header -->
                                                <div class="card-header border-bottom">
                                                    <div
                                                        class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                                                        <div class="d-flex align-items-center">

                                                            <div class="avatar-text avatar-lg bg-soft-primary me-3">
                                                                <i class="feather-upload"></i>
                                                            </div>

                                                            <div>
                                                                <h4 class="mb-1">
                                                                    Import Employees
                                                                </h4>

                                                                <p class="text-muted mb-0">
                                                                    Upload an Excel file to create or update employee
                                                                    records.
                                                                </p>
                                                            </div>

                                                        </div>

                                                        <a href="/template/Import employees.xls" class="btn btn-primary"
                                                            download="employee_template.xls">

                                                            <i class="feather-download me-2"></i>
                                                            Download Template

                                                        </a>

                                                    </div>
                                                </div>

                                                <!-- Body -->
                                                <div class="card-body">

                                                    <% if (locals.error) { %>
                                                        <div class="alert alert-danger mb-4">

                                                            <i class="feather-alert-circle me-2"></i>

                                                            Error occurred while importing file:
                                                            <strong>
                                                                <%= error %>
                                                            </strong>

                                                        </div>
                                                        <% } %>

                                                            <form action="/employee/import-master-file" method="post"
                                                                enctype="multipart/form-data">

                                                                <div class="mb-4">

                                                                    <label class="form-label fw-semibold">
                                                                        Employee File
                                                                    </label>

                                                                    <div class="border rounded p-4 bg-light">

                                                                        <input type="file" class="form-control"
                                                                            id="file" name="file" accept=".xls,.xlsx"
                                                                            required>

                                                                        <small class="text-muted mt-2 d-block">
                                                                            Supported formats:
                                                                            .xls, .xlsx
                                                                        </small>

                                                                    </div>

                                                                </div>

                                                                <div class="d-flex justify-content-end gap-2">

                                                                    <a href="/employee/list" class="btn btn-light">

                                                                        Cancel

                                                                    </a>

                                                                    <button type="submit" class="btn btn-success"
                                                                        id="importBtn">

                                                                        <i class="feather-upload me-2"></i>
                                                                        Import Employees

                                                                    </button>

                                                                </div>

                                                            </form>

                                                </div>

                                                <div class="card-body border-top">

                                                    <h6 class="fw-bold mb-3">
                                                        Import Instructions
                                                    </h6>

                                                    <ul class="mb-0 text-muted">

                                                        <li>
                                                            Download the template before importing.
                                                        </li>

                                                        <li>
                                                            Do not modify column names.
                                                        </li>

                                                        <li>
                                                            Complete all mandatory fields.
                                                        </li>

                                                        <li>
                                                            Save the file in Excel format (.xls or .xlsx).
                                                        </li>

                                                    </ul>

                                                </div>

                                            </div>

                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>

                    </div>

                    <%- include('partials/footer.ejs') %>

                </main>

    </body>

    </html>