<style>
    .notification-message {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        word-break: break-word;
    }

    /* PC : ouverture au hover */
    @media (min-width: 992px) {
        .nxl-h-item:hover>.dropdown-menu {
            display: block;
        }
    }

    /* Téléphone/tablette : Bootstrap gère l'ouverture au clic */
    @media (max-width: 991.98px) {
        .nxl-h-item>.dropdown-menu {
            display: none;
        }

        .nxl-h-item>.dropdown-menu.show {
            display: block;
        }
    }

    /* Desktop */
    .grid-3 {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    /* Tablette */
    @media (max-width: 991px) {
        .grid-3 {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    /* Téléphone */
    @media (max-width: 576px) {
        .grid-3 {
            grid-template-columns: 1fr;
            width: 100%;
        }

        .grid-3 .card {
            width: 100%;
        }
    }

    @media (max-width: 768px) {
        .grid-3 {
            grid-template-columns: 1fr !important;
        }

        .grid-3 .card {
            width: 100%;
        }
    }

    /* Modal responsive sur téléphone */
    @media (max-width: 576px) {

        #medicalServiceModal {
            width: 100vw !important;
            max-width: 100vw !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        #medicalServiceModal .modal-dialog,
        #managerModal .modal-dialog {
            width: 100vw !important;
            max-width: 100vw !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        #medicalServiceModal .modal-content,
        #managerModal .modal-content {
            width: 100% !important;
            max-width: 100% !important;
            min-height: 100vh;
            border-radius: 0 !important;
        }
    }
</style>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const dropdowns = document.querySelectorAll(".nxl-h-item");

        dropdowns.forEach(function (dropdown) {
            const button = dropdown.querySelector('[data-bs-toggle="dropdown"]');

            if (!button) return;

            // Gestion du clic
            button.addEventListener("click", function (event) {
                event.preventDefault();
                event.stopPropagation();

                const bsDropdown = bootstrap.Dropdown.getOrCreateInstance(button);
                bsDropdown.toggle();
            });
        });
    });
</script>