<script>
    var message = "";

    const holidaysList = document.getElementById('holidaysList');

    const input1 = document.getElementById('employeeSearch1');
    const results1 = document.getElementById('employeeResults1');
    const hiddenInput1 = document.getElementById('employee1');
    const hiddenInputMatricule1 = document.getElementById('matricule1');
    const reasonInput1 = document.getElementById('reason1');
    // const simulateButton = document.getElementById('simulateButton');
    const simulateDate = document.getElementById('simulate_date');
    const returnDate = document.getElementById('return_date');
    const formSimulation = document.getElementById('formSimulation');
    const leaveType = document.getElementById('leave_type');
    const balance_type = document.getElementById('balance_type');

    const days_taken = document.getElementById('days_taken');
    const days_display = document.getElementById('days_display');

    const startDate1 = document.getElementById('startDate1');
    const endDate1 = document.getElementById('endDate1');
    const messageContainer = document.getElementById('message1');

    let timeout1 = null;
    // simulateButton.addEventListener('click', checkSimulationLeave);
    startDate1.addEventListener('change', checkSimulationLeave);
    endDate1.addEventListener('change', checkSimulationLeave);

    simulateDate.value = new Date().toISOString().slice(0, 10);
    returnDate.value = new Date(new Date().setDate(new Date().getDate() + 1)).toISOString().slice(0, 10);
    startDate1.value = new Date().toISOString().slice(0, 10);
    endDate1.value = new Date().toISOString().slice(0, 10);

    simulateDate.addEventListener('change', () => {
        startDate1.value = simulateDate.value;
        console.log("SIMULATE DATE", simulateDate.value)
        console.log("RETURN DATE", returnDate.value)
        returnDate.min = simulateDate.value;
        days_taken.value = getNumberOfDays(startDate1.value, returnDate.value) - 1;
        endDate1.value = new Date(new Date(simulateDate.value).setDate(new Date(simulateDate.value).getDate() + parseInt(days_taken.value) - 1)).toISOString().slice(0, 10);
        console.log("END DATE", endDate1.value)
        console.log("NUMBER OF DAYS:", days_taken.value)
        days_display.textContent = days_taken.value;
        checkSimulationLeave();
    });

    returnDate.addEventListener('change', () => {
        startDate1.value = simulateDate.value;
        console.log("SIMULATE DATE", simulateDate.value)
        console.log("RETURN DATE", returnDate.value)
        days_taken.value = getNumberOfDays(startDate1.value, returnDate.value) - 1;
        endDate1.value = new Date(new Date(simulateDate.value).setDate(new Date(simulateDate.value).getDate() + parseInt(days_taken.value) - 1)).toISOString().slice(0, 10);
        console.log("END DATE", endDate1.value)
        console.log("NUMBER OF DAYS:", days_taken.value)
        days_display.textContent = days_taken.value;
        checkSimulationLeave();
    });

    days_taken.addEventListener('change', () => {
        endDate1.value = new Date(new Date(startDate1.value).setDate(new Date(startDate1.value).getDate() + parseInt(days_taken.value) - 1)).toISOString().slice(0, 10);
        days_display.textContent = days_taken.value;
        checkSimulationLeave();
    });

    balance_type.addEventListener('change', () => {
        if (balance_type.value === 'Daily') {
            document.getElementsByName("entitlement-day").forEach((el) => el.className = "mb-2");
            document.getElementsByName("entitlement-month").forEach((el) => el.className = "d-none");
        } else {
            document.getElementsByName("entitlement-day").forEach((el) => el.className = "d-none");
            document.getElementsByName("entitlement-month").forEach((el) => el.className = "mb-2");
        }
    });

    const soldeCumule1 = document.getElementById('soldeCumule1');
    const soldeCumuleMensuel1 = document.getElementById('soldeCumuleMensuel1');
    const soldeDebut1 = document.getElementById('soldeDebut1');
    const soldePris1 = document.getElementById('soldePris1');
    const soldePermissions1 = document.getElementById('soldePermissions1');
    const soldeRestant1 = document.getElementById('soldeRestant1');
    const soldeRestantMensuel1 = document.getElementById('soldeRestantMensuel1');

    const soldeCumule2 = document.getElementById('soldeCumule2');
    const soldeCumuleMensuel2 = document.getElementById('soldeCumuleMensuel2');
    const soldeDebut2 = document.getElementById('soldeDebut2');
    const soldePris2 = document.getElementById('soldePris2');
    const soldePermissions2 = document.getElementById('soldePermissions2');
    const soldeRestant2 = document.getElementById('soldeRestant2');
    const soldeRestantMensuel2 = document.getElementById('soldeRestantMensuel2');

    let solde_simulate = 0;

    input1.addEventListener('input', () => {
        clearTimeout(timeout1);

        const query = input1.value.trim();
        if (query.length < 2) {
            results1.innerHTML = '';
            return;
        }

        timeout1 = setTimeout(async () => {
            try {
                const res = await fetch(`/employee/finding/search-list?q=${query}`);

                if (!res.ok) {
                    console.error('HTTP error', res.status);
                    return;
                }

                const data = await res.json();

                results1.innerHTML = '';
                // console.log("Data:", data);
                data.forEach(emp => {
                    const li = document.createElement('li');
                    li.classList.add('list-group-item');
                    li.textContent = `${emp.matricule} - ${emp.name + " " + emp.firstname}`;
                    li.onclick = () => {
                        input1.value = li.textContent;
                        hiddenInput1.value = emp.id;
                        hiddenInputMatricule1.value = emp.matricule;
                        if (leaveType.value === "Local_Leave_AMD") {
                            soldeCumule1.textContent = emp.solde_cumul;
                            soldeCumuleMensuel1.textContent = emp.solde_cumul_mensuel;
                            soldeCumule2.textContent = emp.solde_cumul;
                            soldeCumuleMensuel2.textContent = emp.solde_cumul_mensuel;
                            // document.getElementsByName("entitlement-day")[0].classList.add("d-none");
                            // document.getElementsByName("entitlement-month")[0].classList.remove("d-none");
                        } else {
                            soldeCumule1.textContent = emp.solde_cumul;
                            soldeCumuleMensuel1.textContent = emp.solde_cumul_mensuel;
                            soldeCumule2.textContent = emp.solde_cumul;
                            soldeCumuleMensuel2.textContent = emp.solde_cumul_mensuel;
                            // document.getElementsByName("entitlement-day")[0].classList.remove("d-none");
                            // document.getElementsByName("entitlement-month")[0].classList.add("d-none");
                        }
                        soldeDebut1.textContent = emp.solde_debut;
                        soldeDebut2.textContent = emp.solde_debut;
                        soldePris1.textContent = emp.solde_pris;
                        soldePermissions1.textContent = emp.solde_pris_permission;
                        soldeRestant1.textContent = emp.solde_restant;
                        soldeRestantMensuel1.textContent = emp.solde_restant_mensuel;
                        solde = emp.solde_restant;
                        results1.innerHTML = '';
                    };
                    results1.appendChild(li);
                });

            } catch (err) {
                console.error('Autocomplete error:', err);
            }
        }, 300);
    });

    function checkSimulationLeave() {
        let styleAlert = "danger";
        if (hiddenInputMatricule1.value === "") {
            messageContainer.innerHTML = "Choose an employee";
            styleAlert = "danger";
            messageContainer.className = "alert alert-" + styleAlert;
            return;
        }
        if (simulateDate.value === "") {
            messageContainer.innerHTML = "Choose a date for simulation";
            styleAlert = "danger";
            messageContainer.className = "alert alert-" + styleAlert;
            return;
        }
        const simulation = fetch('/leave/simulate-cumul-balance', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                matricule: hiddenInputMatricule1.value,
                date: simulateDate.value,
            }),
        }).then(res => res.json()).then(data => {
            fetch('/holiday/by-date/' + document.getElementById('startDate1').value + '/' + document.getElementById('endDate1').value).then(res => res.json()).then(holidays => {
                var htmlHolidays = "";
                if (holidays.length > 0) {
                    htmlHolidays += "<h4>List of holidays on this dates</h4>"
                } else {
                    htmlHolidays += "<h4>No holiday on this dates</h4>"
                }
                holidays.forEach(holiday => {
                    htmlHolidays += `
                    <div class="alert alert-info">
                        <strong>${holiday.name}</strong>
                        <span class="float-right">${new Date(holiday.date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}</span>
                    </div>
                    `;
                });
                holidaysList.innerHTML = htmlHolidays;
                console.log("Holidays:", holidays);
                // console.log("Data:", data);
                solde_simulate = data.solde_restant;
                solde_pris_simulate = data.solde_pris;
                solde_cumule_simulate = data.solde_cumul;
                solde_cumul_mensuel = data.solde_cumul_mensuel;
                const startDate = document.getElementById('startDate1').value;
                const endDate = document.getElementById('endDate1').value;

                let numberOfDays = getNumberOfDays(startDate, endDate);
                soldeCumule2.textContent = solde_cumule_simulate;
                soldeCumuleMensuel2.textContent = solde_cumul_mensuel;
                soldeRestantMensuel2.textContent = (data.solde_restant_mensuel - numberOfDays).toFixed(2);
                if (numberOfDays == NaN) {
                    numberOfDays = 0;
                }
                soldePris2.textContent = solde_pris_simulate + numberOfDays - holidays.length;
                soldePermissions2.textContent = soldePermissions1.textContent;
                soldeRestant2.textContent = (solde_simulate - numberOfDays + holidays.length).toFixed(2);
                // console.log("SOLDE SIMULATE:", solde_simulate);
                // console.log("SOLDE PRIS:", solde_pris_simulate);
                // console.log("SOLDE CUMULE:", solde_cumule_simulate);
                // console.log("NUMBER OF DAYS:", numberOfDays)
                if (numberOfDays > solde_simulate) {
                    // console.log("Solde de congé: " + solde_simulate + " jours. Insuffisant pour cette demande (" + numberOfDays + " jours)");
                }
                if (!checkDate(startDate, endDate) || numberOfDays <= 0) {
                    messageContainer.innerHTML = "Invalid number of days";
                    styleAlert = "warning";
                } else if ((solde === null || solde === undefined || solde === "")) {
                    messageContainer.innerHTML = "Choose an employee";
                    styleAlert = "danger";
                } else if (leaveType.value === 'Local_Leave_AMD' && numberOfDays > solde_simulate) {
                    messageContainer.innerHTML = "Leave balance: " + solde_simulate + " days. Insufficient for this request (" + numberOfDays + " days)";
                    styleAlert = "danger";
                } else {
                    styleAlert = "success";
                    messageContainer.innerHTML = "Leave is valid for the request of " + numberOfDays + " day(s).";
                }
                messageContainer.className = "alert alert-" + styleAlert;
            });
        });
    }
    function getNumberOfDays(startDateStr, endDateStr) {
        const start = new Date(startDateStr);
        const end = new Date(endDateStr);
        const diffTime = end - start;
        const diffDays = diffTime / (1000 * 60 * 60 * 24);
        return diffDays + 1;
    }
    function checkDate(startDate, endDate) {
        const startDateObj = new Date(startDate);
        const endDateObj = new Date(endDate);
        if (startDateObj <= endDateObj) {
            return true
        } else {
            return false
        }
    }
</script>