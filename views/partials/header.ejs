<header class="nxl-header">
    <div class="header-wrapper">
        <div class="header-left d-flex align-items-center gap-4">
            <a href="javascript:void(0);" class="nxl-head-mobile-toggler" id="mobile-collapse">
                <div class="hamburger hamburger--arrowturn">
                    <div class="hamburger-box">
                        <div class="hamburger-inner"></div>
                    </div>
                </div>
            </a>
            <div class="nxl-navigation-toggle">
                <a href="javascript:void(0);" id="menu-mini-button">
                    <i class="feather-align-left"></i>
                </a>
                <a href="javascript:void(0);" id="menu-expend-button" style="display: none">
                    <i class="feather-arrow-right"></i>
                </a>
            </div>
            <div class="nxl-lavel-mega-menu-toggle d-flex d-lg-none">
                <a href="javascript:void(0);" id="nxl-lavel-mega-menu-open">
                    <i class="feather-align-left"></i>
                </a>
            </div>
            <div class="nxl-drp-link nxl-lavel-mega-menu">
                <div class="nxl-lavel-mega-menu-toggle d-flex d-lg-none">
                    <a href="javascript:void(0)" id="nxl-lavel-mega-menu-hide">
                        <i class="feather-arrow-left me-2"></i>
                        <span>Back</span>
                    </a>
                </div>
            </div>
        </div>
        <div class="header-right ms-auto">
            <div class="d-flex align-items-center">
                <div class="dropdown nxl-h-item">
                    <a class="nxl-head-link me-3" data-bs-toggle="dropdown" href="#" role="button"
                        data-bs-auto-close="outside">
                        <i class="feather-bell"></i>
                        <% if(notificationCount> 0) { %>
                            <span class="badge bg-danger nxl-h-badge" id="count">
                                <%= notificationCount %>
                            </span>
                            <% } %>
                    </a>
                    <div class="dropdown-menu dropdown-menu-end nxl-h-dropdown nxl-notifications-menu">
                        <div class="d-flex justify-content-between align-items-center notifications-head">
                            <h6 class="fw-bold text-dark mb-0">Notifications</h6>
                            <a href="javascript:void(0);" class="fs-11 text-success text-end ms-auto"
                                data-bs-toggle="tooltip" title="Make all as Read" onclick="markAllAsRead()">
                                <i class="feather-check"></i>
                                <span>Make all as Read</span>
                            </a>
                        </div>
                        <% notifications.forEach(notification=> { %>
                            <div class="notifications-item <%= notification.isRead ? '' : 'bg-light' %>"
                                id="div-<%= notification.id %>">

                                <div class="d-flex align-items-start">

                                    <!-- Icône -->
                                    <!-- <div class="notifications-icon">
                                        <% if(notification.icon) { %>
                                            <i class="<%= notification.icon %> fs-18"></i>
                                            <% } else { %>
                                                <i class="feather-bell fs-18 text-primary"></i>
                                                <% } %>
                                    </div> -->

                                    <!-- Contenu -->
                                    <div class="notifications-desc flex-grow-1">

                                        <% if(notification.url) { %>
                                            <a href="/notification/redirect/<%= notification.id %>"
                                                class="fw-semibold text-dark">
                                                <%= notification.title %>
                                            </a>
                                            <% } else { %>
                                                <span class="text-dark fs-11">
                                                    <%= notification.title %>
                                                </span>
                                                <% } %>

                                                    <p class="mb-1 text-muted notification-message fs-11">
                                                        <%= notification.message %>
                                                    </p>

                                                    <div class="d-flex justify-content-between align-items-center">

                                                        <small class="text-muted fs-9">
                                                            <%= notification.createdAt.toLocaleString('fr-FR') %>
                                                        </small>

                                                        <div class="d-flex align-items-center gap-2">

                                                            <% if(!notification.isRead) { %>
                                                                <a href="#" id="<%= notification.id %>"
                                                                    onclick="markAsRead('<%= notification.id %>')"
                                                                    class="text-success" title="Mark as read">
                                                                    <i class="feather-check-circle"></i>
                                                                </a>
                                                                <% } %>

                                                                    <a href="/notifications/<%= notification.id %>/delete"
                                                                        class="text-danger" title="Delete">
                                                                        <i class="feather-trash-2"></i>
                                                                    </a>

                                                        </div>

                                                    </div>

                                    </div>

                                </div>

                            </div>
                            <% }) %>
                                <div class="text-center notifications-footer">
                                    <a href="javascript:void(0);" class="fs-13 fw-semibold text-dark">All
                                        notifications</a>
                                </div>
                    </div>
                </div>

                <div class="dropdown nxl-h-item">

                    <!-- Trigger: avatar avec initiales -->
                    <a href="javascript:void(0);" data-bs-toggle="dropdown" role="button" data-bs-auto-close="outside">
                        <div class="d-flex align-items-center justify-content-center rounded-circle"
                            style="width:36px; height:36px; background: linear-gradient(135deg, #1a56db, #1a56db); color:#fff; font-size:13px; font-weight:600; letter-spacing:-0.5px; cursor:pointer; flex-shrink:0;">
                            <%= user?.employee?.name.charAt(0).toUpperCase() %>
                                <%= user?.employee?.firstname.charAt(0).toUpperCase() %>
                        </div>
                    </a>

                    <!-- Dropdown -->
                    <div class="dropdown-menu dropdown-menu-end nxl-h-dropdown nxl-user-dropdown p-0"
                        style="min-width:260px; border-radius:12px; border:1px solid #e5e7eb; box-shadow:0 8px 24px rgba(0,0,0,.08); overflow:hidden;">

                        <!-- Header -->
                        <div class="px-3 py-3" style="background:#f9fafb; border-bottom:1px solid #f3f4f6;">
                            <div class="d-flex align-items-center gap-3">

                                <!-- Avatar large -->
                                <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
                                    style="width:46px; height:46px; background: linear-gradient(135deg, #1a56db, #1a56db); color:#fff; font-size:16px; font-weight:600; letter-spacing:-0.5px;">
                                    <%= user?.employee?.name.charAt(0).toUpperCase() %>
                                        <%= user?.employee?.firstname.charAt(0).toUpperCase() %>
                                </div>

                                <div class="overflow-hidden">
                                    <p class="mb-0 fw-semibold text-truncate" style="font-size:14px; color:#111827;">
                                        <%= user?.employee?.name %>
                                            <%= user?.employee?.firstname %>
                                    </p>
                                    <p class="mb-1 text-truncate" style="font-size:12px; color:#9ca3af;">
                                        <%= user.email %>
                                    </p>
                                    <div class="d-flex flex-wrap gap-1">
                                        <% var roleColor='primary' ; var roleBg='#eff6ff' ; var roleText='#1a56db' ; if
                                            (user.role==='SUPERADMIN' ) { roleBg='#fef2f2' ; roleText='#dc2626' ; } else
                                            if (user.role==='ADMIN' ) { roleBg='#fffbeb' ; roleText='#d97706' ; } else
                                            if (user.role==='PAYROLL' ) { roleBg='#eff6ff' ; roleText='#0ea5e9' ; } %>
                                            <span class="badge rounded-pill px-2"
                                                style="font-size:10px; font-weight:500; background:<%= roleBg %>; color:<%= roleText %>;">
                                                <%= user.role %>
                                            </span>
                                            <span class="badge rounded-pill px-2"
                                                style="font-size:10px; font-weight:500; background:#f0fdf4; color:#0e9f6e;">
                                                <%= user.site %>
                                            </span>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <!-- Menu items -->
                        <% if (user.id !=='superadmin' ) { %>
                            <div class="py-1">
                                <a href="/user/my-profil"
                                    class="dropdown-item d-flex align-items-center gap-2 px-3 py-2"
                                    style="font-size:13px; color:#374151;">
                                    <span
                                        class="d-flex align-items-center justify-content-center rounded-2 flex-shrink-0"
                                        style="width:28px; height:28px;">
                                        <i class="feather-user" style="font-size:14px; color:#6b7280;"></i>
                                    </span>
                                    My account
                                </a>
                                <a href="/user/edit-profil"
                                    class="dropdown-item d-flex align-items-center gap-2 px-3 py-2"
                                    style="font-size:13px; color:#374151;">
                                    <span
                                        class="d-flex align-items-center justify-content-center rounded-2 flex-shrink-0"
                                        style="width:28px; height:28px;">
                                        <i class="feather-settings" style="font-size:14px; color:#6b7280;"></i>
                                    </span>
                                    Account settings
                                </a>
                            </div>
                            <div style="border-top:1px solid #f3f4f6;"></div>
                            <% } %>

                                <!-- Logout -->
                                <div class="py-1">
                                    <a href="/logout" class="dropdown-item d-flex align-items-center gap-2 px-3 py-2"
                                        style="font-size:13px; color:#dc2626;">
                                        <span
                                            class="d-flex align-items-center justify-content-center rounded-2 flex-shrink-0"
                                            style="width:28px; height:28px;">
                                            <i class="feather-log-out" style="font-size:14px; color:#dc2626;"></i>
                                        </span>
                                        Déconnexion
                                    </a>
                                </div>

                    </div>
                </div>
            </div>

        </div>
    </div>
    <script>
        async function markAsRead(id) {
            const response = await fetch(`/notification/mark-as-read/${id}`);
            console.log("test", response);
            if (response.status === 200 || response.status === 201) {
                const count = document.getElementById("count");
                const notificationItem = document.getElementById("div-" + id);
                notificationItem.className = 'notifications-item';
                if (parseInt(count.innerText) - 1 > 0) {
                    count.innerText = parseInt(count.innerText) - 1;
                } else {
                    count.style.display = "none";
                }
            }
        }

        async function markAllAsRead() {
            const response = await fetch(`/notification/mark-all-as-read`);
            console.log("test", response);
            if (response.status === 200 || response.status === 201) {
                const count = document.getElementById("count");
                count.innerText = "0";
                count.style.display = "none";
            }
        }
    </script>
</header>