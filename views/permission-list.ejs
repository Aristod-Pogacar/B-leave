<%- include('partials/head.ejs') %>

    <body>
        <%- include('partials/sidebar.ejs') %>
            <%- include('partials/header.ejs') %>
                <main class="nxl-container">
                    <div class="nxl-content">
                        <div class="page-header">
                            <div class="page-header-left d-flex align-items-center">
                                <div class="page-header-title">
                                    <h5 class="m-b-10">B-Leave</h5>
                                </div>
                                <ul class="breadcrumb">
                                    <li class="breadcrumb-item">Permissions</li>
                                    <li class="breadcrumb-item">Permissions list</li>
                                </ul>
                            </div>
                            <div class="page-header-right ms-auto">
                                <div class="page-header-right-items">
                                    <div class="d-flex d-md-none">
                                        <a href="javascript:void(0)" class="page-header-right-close-toggle">
                                            <i class="feather-arrow-left me-2"></i>
                                            <span>Back</span>
                                        </a>
                                    </div>
                                </div>
                                <div class="d-md-none d-flex align-items-center">
                                    <a href="javascript:void(0)" class="page-header-right-open-toggle">
                                        <i class="feather-align-right fs-20"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <!-- [ page-header ] end -->
                        <div class="bg-white py-3 border-bottom rounded-0 p-md-0 mb-0">
                            <div class="d-md-none d-flex align-items-center justify-content-between">
                                <a href="javascript:void(0)" class="page-content-left-open-toggle">
                                    <i class="feather-align-left fs-20"></i>
                                </a>
                            </div>
                        </div>
                        <!-- [ Main Content ] start -->
                        <div class="main-content">
                            <div class="tab-content">
                                <div class="tab-pane fade active show" id="overviewTab">
                                    <div class="row">

                                        <div class="col-12">
                                            <div class="card stretch stretch-full">
                                                <div class="card-header">
                                                    <h5 class="card-title">Exceptional Permissions History</h5>

                                                    <!-- Filtres -->
                                                    <form method="GET" action=""
                                                        class="d-flex align-items-end gap-5 mt-2 flex-wrap">
                                                        <div>
                                                            <label class="form-label mb-1">Start date</label>
                                                            <input type="date" name="startDate" class="form-control"
                                                                value="<%= startDate %>" />
                                                        </div>
                                                        <div>
                                                            <label class="form-label mb-1">End date</label>
                                                            <input type="date" name="endDate" class="form-control"
                                                                value="<%= endDate %>" />
                                                        </div>
                                                        <div class="d-flex gap-2">
                                                            <button type="submit" class="btn btn-primary">
                                                                <i class="feather-search me-1"></i> Filtrer
                                                            </button>
                                                            <a href="?" class="btn btn-outline-secondary">
                                                                <i class="feather-x me-1"></i> Reset
                                                            </a>
                                                        </div>
                                                    </form>
                                                </div>
                                                <div class="card-body custom-card-action p-0">
                                                    <% if (locals.error) { %>
                                                        <div class="alert alert-danger" role="alert" id="message">
                                                            <%= error %>
                                                        </div>
                                                        <% } %>
                                                            <% if (locals.message) { %>
                                                                <div class="alert alert-success" role="alert"
                                                                    id="message">
                                                                    <%= message %>
                                                                </div>
                                                                <% } %>
                                                                    <div class="table-responsive mb-3">
                                                                        <table class="table table-hover mb-0">
                                                                            <thead>
                                                                                <tr>
                                                                                    <th style="width: 35%;">Employee
                                                                                    </th>

                                                                                    <th>Permission
                                                                                        Information</th>

                                                                                    <th>Schedule</th>
                                                                                    <th style="width:20%;">
                                                                                        Approved/Rejected by</th>
                                                                                </tr>
                                                                            </thead>
                                                                            <tbody>
                                                                                <% leaves.forEach(leave=> {

                                                                                    let leaveColor = "primary";

                                                                                    if(leave.leave_type ===
                                                                                    "Permission_AMD"){
                                                                                    leaveColor = "success";
                                                                                    }

                                                                                    if(leave.leave_type ===
                                                                                    "Indisponibilite_AMD"){
                                                                                    leaveColor = "danger";
                                                                                    }

                                                                                    const createdAt = new
                                                                                    Date(leave.created_at);
                                                                                    const startDate = new
                                                                                    Date(leave.start_date);

                                                                                    const diffDays =
                                                                                    (startDate - createdAt) /
                                                                                    (1000*60*60*24);

                                                                                    const returnDate = new
                                                                                    Date(leave.end_date);
                                                                                    returnDate.setDate(returnDate.getDate()
                                                                                    + 1);

                                                                                    const urgent = diffDays < 8; %>
                                                                                        <tr>
                                                                                            <td style="width: 35%;">

                                                                                                <div
                                                                                                    class="d-flex align-items-center">

                                                                                                    <div
                                                                                                        class="avatar-text avatar-md bg-soft-success text-success me-3">

                                                                                                        <%= leave.leave_type.charAt(0)
                                                                                                            %>

                                                                                                    </div>

                                                                                                    <div>

                                                                                                        <div
                                                                                                            class="fw-semibold">

                                                                                                            <a href="/employee/details/<%= leave.employee.id %>"
                                                                                                                class="text-decoration-none text-dark">

                                                                                                                <%= leave.employee.name
                                                                                                                    %>
                                                                                                                    <%= leave.employee.firstname
                                                                                                                        %>

                                                                                                            </a>

                                                                                                        </div>

                                                                                                        <small
                                                                                                            class="text-muted">

                                                                                                            <i
                                                                                                                class="feather-hash me-1"></i>

                                                                                                            <%= leave.employee.matricule
                                                                                                                %>

                                                                                                        </small>

                                                                                                    </div>

                                                                                                </div>

                                                                                            </td>
                                                                                            <td style="width: 30%;">
                                                                                                <a
                                                                                                    href="/employee/details/<%= leave.employee.id %>">
                                                                                                    <%= leave.employee.name
                                                                                                        %>
                                                                                                        <%= leave.employee.firstname
                                                                                                            %>
                                                                                                </a>
                                                                                            </td>

                                                                                            <td>
                                                                                                <div class="small">

                                                                                                    <div
                                                                                                        class="mb-1 mt-0 ms-4">
                                                                                                        <span
                                                                                                            class="badge bg-soft-<%= leaveColor %> text-<%= leaveColor %>">

                                                                                                            <%= leave.leave_type
                                                                                                                .replace("_AMD","")
                                                                                                                .replace("_"," ") %>
                                                                                                                    </span>

                                                                                                            </div>

                                                                                                            <div
                                                                                                                class="
                                                                                                                mb-1">

                                                                                                                <i
                                                                                                                    class="feather-message-circle text-success me-2"></i>

                                                                                                                <strong>Reason
                                                                                                                    :</strong>

                                                                                                                <%= leave.reason
                                                                                                                    %>

                                                                                                    </div>

                                                                                                    <div class="mb-1">

                                                                                                        <i
                                                                                                            class="feather-corner-down-right text-warning me-2"></i>

                                                                                                        <strong>Duration
                                                                                                            :</strong>

                                                                                                        <%= leave.duration
                                                                                                            %>
                                                                                                            day(s)

                                                                                                    </div>

                                                                                                </div>

                                                                                            </td>

                                                                                            <!-- Schedule -->

                                                                                            <td>

                                                                                                <div class="small">

                                                                                                    <div class="mb-1">

                                                                                                        <i
                                                                                                            class="feather-edit-3 text-primary me-2"></i>

                                                                                                        <strong>Applied
                                                                                                            :</strong>

                                                                                                        <span
                                                                                                            class="badge bg-soft-success text-success">
                                                                                                            <%= new
                                                                                                                Date(leave.created_at).toLocaleDateString("fr-FR")
                                                                                                                %>
                                                                                                        </span>

                                                                                                    </div>

                                                                                                    <div class="mb-1">

                                                                                                        <i
                                                                                                            class="feather-play text-success me-2"></i>

                                                                                                        <strong>Start
                                                                                                            :</strong>

                                                                                                        <%= new
                                                                                                            Date(leave.start_date).toLocaleDateString("fr-FR")
                                                                                                            %>

                                                                                                    </div>

                                                                                                    <div class="mb-1">

                                                                                                        <i
                                                                                                            class="feather-corner-down-right text-warning me-2"></i>

                                                                                                        <strong>Return
                                                                                                            :
                                                                                                            :</strong>

                                                                                                        <%= returnDate.toLocaleDateString("fr-FR")
                                                                                                            %>

                                                                                                    </div>

                                                                                                </div>

                                                                                            </td>
                                                                                            <td style="width: 10%;">
                                                                                                <%= leave.approver?.name
                                                                                                    %>
                                                                                                    <%= leave.approver?.firstName
                                                                                                        %>
                                                                                            </td>
                                                                                        </tr>
                                                                                        <% }) %>
                                                                            </tbody>
                                                                        </table>
                                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <%- include('partials/footer.ejs') %>