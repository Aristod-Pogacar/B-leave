                <script>
                    // Types de congés : clé renvoyée par l'API → libellé affiché
                    const LEAVE_TYPES = [
                        { key: 'Local_Leave_AMD', label: 'Local Leave' },
                        { key: 'Permission_AMD', label: 'Permission' },
                        { key: 'Indisponibilite_AMD', label: 'Indisponibilite' }
                    ];
                    const FIELDS = ['DM', 'DNM', 'IND', 'SUBTOTAL'];
                    const FIELD_LABELS = { DM: 'DM', DNM: 'DNM', IND: 'IND', SUBTOTAL: 'SUB' };
                    const START_COL_WIDTH = 150;
                    const VALUE_COL_WIDTH = 30;

                    const table = document.getElementById('leaveTable');
                    const statusEl = document.getElementById('reportStatus');

                    // petit helper pour créer un élément
                    function el(tag, className, text) {
                        const e = document.createElement(tag);
                        if (className) e.className = className;
                        if (text !== undefined) e.textContent = text;
                        return e;
                    }

                    // '2026-10-01' → '01/10/2026'
                    function formatDate(iso) {
                        const [y, m, d] = iso.split('-');
                        return `${d}/${m}/${y}`;
                    }

                    function renderTable(data) {
                        const dates = Object.keys(data).sort();

                        table.innerHTML = '';

                        if (dates.length === 0) {
                            statusEl.textContent = 'Aucune donnée pour cette période.';
                            return;
                        }
                        statusEl.textContent = '';

                        // largeur de la table = 150 + nbDates * 4 * 30
                        const totalWidth = START_COL_WIDTH + dates.length * FIELDS.length * VALUE_COL_WIDTH;
                        table.style.setProperty('width', totalWidth + 'px', 'important');

                        // ----- COLGROUP -----
                        const colgroup = el('colgroup');
                        colgroup.appendChild(el('col', 'col-start'));
                        dates.forEach(() => {
                            FIELDS.forEach(() => colgroup.appendChild(el('col', 'col-value')));
                        });
                        table.appendChild(colgroup);

                        // ----- THEAD -----
                        const thead = el('thead');

                        const trDates = el('tr');
                        const thType = el('th', 'start-col', 'LEAVE TYPE');
                        thType.rowSpan = 2;
                        trDates.appendChild(thType);
                        dates.forEach(date => {
                            const th = el('th', 'date', formatDate(date));
                            th.colSpan = FIELDS.length;
                            trDates.appendChild(th);
                        });
                        thead.appendChild(trDates);

                        const trFields = el('tr');
                        dates.forEach(() => {
                            FIELDS.forEach(f => {
                                const cls = 'value type' + (f === 'SUBTOTAL' ? ' subtotal' : '');
                                trFields.appendChild(el('th', cls, FIELD_LABELS[f]));
                            });
                        });
                        thead.appendChild(trFields);
                        table.appendChild(thead);

                        // ----- TBODY -----
                        const tbody = el('tbody');

                        // cumul pour la ligne TOTAL : totals[date][champ]
                        const totals = {};
                        dates.forEach(d => {
                            totals[d] = { DM: 0, DNM: 0, IND: 0, SUBTOTAL: 0 };
                        });

                        LEAVE_TYPES.forEach(({ key, label }) => {
                            const tr = el('tr');
                            tr.appendChild(el('td', 'start-col', label));

                            dates.forEach(date => {
                                const row = (data[date] && data[date][key]) || {};
                                FIELDS.forEach(f => {
                                    const value = Number(row[f]) || 0;
                                    totals[date][f] += value;
                                    const cls = 'value' + (f === 'SUBTOTAL' ? ' subtotal' : '');
                                    tr.appendChild(el('td', cls, value));
                                });
                            });
                            tbody.appendChild(tr);
                        });

                        // ligne TOTAL
                        const trTotal = el('tr', 'total');
                        trTotal.appendChild(el('td', 'start-col', 'TOTAL'));
                        dates.forEach(date => {
                            FIELDS.forEach(f => {
                                trTotal.appendChild(el('td', 'value', totals[date][f]));
                            });
                        });
                        tbody.appendChild(trTotal);

                        table.appendChild(tbody);
                    }

                    async function loadPreview() {
                        const startDate = document.getElementById('startDate').value;
                        const endDate = document.getElementById('endDate').value;

                        if (!startDate || !endDate) {
                            statusEl.textContent = 'Veuillez renseigner les deux dates.';
                            return;
                        }
                        if (startDate > endDate) {
                            statusEl.textContent = 'La date de début doit être avant la date de fin.';
                            return;
                        }

                        statusEl.textContent = 'Chargement...';
                        table.innerHTML = '';

                        try {
                            const url = `/leave/global-report/preview?startDate=${encodeURIComponent(startDate)}&endDate=${encodeURIComponent(endDate)}`;
                            const response = await fetch(url);
                            if (!response.ok) throw new Error('Erreur HTTP ' + response.status);
                            const data = await response.json();
                            renderTable(data);
                        } catch (err) {
                            console.error(err);
                            statusEl.textContent = 'Erreur lors du chargement du rapport.';
                        }
                    }

                    const startInput = document.getElementById('startDate');
                    const endInput = document.getElementById('endDate');

                    // Synchronise le min de la date de fin avec la date de début
                    function syncEndMin() {
                        endInput.min = startInput.value;

                        // Si la date de fin est devenue antérieure au début, on la remonte
                        if (startInput.value && endInput.value && endInput.value < startInput.value) {
                            endInput.value = startInput.value;
                        }
                    }

                    startInput.addEventListener('change', () => {
                        syncEndMin();
                        loadPreview();
                    });

                    endInput.addEventListener('change', loadPreview);
                    // Date locale → 'YYYY-MM-DD' (sans passer par toISOString, voir remarque)
                    function toInputDate(date) {
                        const y = date.getFullYear();
                        const m = String(date.getMonth() + 1).padStart(2, '0');
                        const d = String(date.getDate()).padStart(2, '0');
                        return `${y}-${m}-${d}`;
                    }

                    // Valeurs par défaut : 1er et dernier jour du mois en cours
                    const now = new Date();
                    startInput.value = toInputDate(new Date(now.getFullYear(), now.getMonth(), 1));
                    endInput.value = toInputDate(new Date(now.getFullYear(), now.getMonth() + 1, 0));
                    // Initialisation
                    syncEndMin();
                    loadPreview();

                    // chargement initial avec les dates par défaut
                    // loadPreview();
                </script>


