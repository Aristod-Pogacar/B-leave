<%- include('partials/head.ejs') %>

    <style>
        .report-card .leave-table-wrapper {
            width: 100%;
            overflow-x: auto;
        }

        .report-card .leave-table-wrapper .leave-table {
            width: max-content !important;
            /* la table prend la taille de son contenu */
            max-width: none !important;
            table-layout: auto !important;
            border-collapse: collapse;
            margin: 0;
        }

        /* Toutes les cellules */
        .report-card .leave-table-wrapper .leave-table th,
        .report-card .leave-table-wrapper .leave-table td {
            padding: 4px 6px !important;
            font-size: 0.8rem !important;
            line-height: 1.2 !important;
            text-align: center;
            white-space: nowrap;
            border: 1px solid #dee2e6;
        }

        /* Sous-colonnes DM / DNM / IND / SUB : assez larges pour "DNM" et "IND" */
        .report-card .leave-table-wrapper .leave-table th.value,
        .report-card .leave-table-wrapper .leave-table td.value {
            min-width: 88px !important;
            width: 88px;
        }

        /* Première colonne : 100px à 200px */
        .report-card .leave-table-wrapper .leave-table .start-col {
            min-width: 100px !important;
            max-width: 200px !important;
            width: 100px;
            text-align: left;
            white-space: normal;
            overflow-wrap: break-word;
        }

        /* Première colonne fixe pendant le scroll horizontal */
        .report-card .leave-table-wrapper .leave-table th.start-col,
        .report-card .leave-table-wrapper .leave-table td.start-col {
            position: sticky;
            left: 0;
            z-index: 2;
            background: #fff;
            /* obligatoire : sinon on voit les colonnes passer dessous */
            /* remplace les bordures, qui ne suivent pas une cellule sticky avec border-collapse */
            box-shadow: inset -1px 0 0 #dee2e6, inset 0 -1px 0 #dee2e6;
        }

        /* L'en-tête "LEAVE TYPE" au-dessus des autres cellules fixes */
        .report-card .leave-table-wrapper .leave-table th.start-col {
            z-index: 3;
            background: #f8f9fa;
        }

        /* Ligne TOTAL : garder son fond si elle en a un */
        .report-card .leave-table-wrapper .leave-table tr.total td.start-col {
            background: #f1f3f5;
        }
    </style>

    <body>

