<%- include('partials/head.ejs') %>

    <style>
        .report-card {
            background: white;
            padding: 25px;
            border-radius: 10px;
        }

        /* Zone qui permet le scroll horizontal */
        .table-wrapper {
            width: 100%;
            overflow-x: auto;
            border: 1px solid #ddd;
        }

        /* Tableau */
        .report-table {
            border-collapse: collapse;
            width: max-content;
        }

        /* Toutes les cellules */
        .report-table th,
        .report-table td {
            border: 1px solid #ddd;
            text-align: center;
            height: 40px;
            padding: 5px;
        }

        /* Première colonne */
        .report-table th:first-child,
        .report-table td:first-child {
            width: 100px;
            min-width: 100px;
        }

        /* Cellules de données */
        .report-table .value {
            width: 50px;
            min-width: 50px;
        }

        /* Dates */
        .report-table .date {
            background: #cfe2ff;
            font-weight: bold;
        }

        /* Sous-en-tête */
        .report-table .type {
            background: #e7f1ff;
            font-size: 12px;
        }

        /* Subtotal */
        .report-table .subtotal {
            background: #fff3cd;
            font-weight: bold;
        }

        /* Total */
        .report-table .total {
            background: #d1e7dd;
            font-weight: bold;
        }
    </style>


