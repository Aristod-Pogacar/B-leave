<%- include('partials/head.ejs') %>
    <link rel="stylesheet" type="text/css" href="/assets/css/dashboard.css">

    <body>
        <style>
            .bar-chart {
                height: 260px;
                display: flex;
                align-items: flex-end;
                gap: 14px;
            }

            .bar-col {
                flex: 1;
                height: 100%;
            }

            .bar-label-x {
                display: block;
                text-align: center;
                margin-top: 8px;
                font-size: 12px;
            }

            .bar-pending {
                background: var(--border) !important;
                opacity: .7;
            }

            .bar-chart>.bar-col div {
                transition: height .4s ease;
            }
        </style>
        <%- include('partials/sidebar.ejs') %>
            <%- include('partials/header.ejs') %>
                <main class="nxl-container">
                    <!-- <main class="main"> -->
                    <div class="nxl-content">
                        <div class="page-header">
                            <div class="page-header-left d-flex align-items-center">
                                <div class="page-header-title">
                                    <h5 class="m-b-10">B-Leave</h5>
                                </div>
                                <ul class="breadcrumb">
                                    <li class="breadcrumb-item">Dashboard</li>
                                    <!-- <li class="breadcrumb-item">Overview</li> -->
                                </ul>
                            </div>
                            <div class="page-header-right ms-auto">
                                <div class="page-header-right-items">
                                    <div class="d-flex d-md-none">
                                        <a href="javascript:void(0)" class="page-header-right-close-toggle">
                                            <i class="feather-arrow-left me-2"></i>
                                            <span>Back</span>
                                        </a>
                                    </div>
                                </div>
                                <div class="d-md-none d-flex align-items-center">
                                    <a href="javascript:void(0)" class="page-header-right-open-toggle">
                                        <i class="feather-align-right fs-20"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <!-- <div class="content"> -->

                        <div class="main-content">
                            <!-- KPI CARDS -->
                            <div class="kpi-grid">
                                <!-- Employés -->
                                <div class="kpi-card">
                                    <div class="kpi-top">
                                        <div class="kpi-icon" style="background:var(--primary-light)">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="#1a56db" stroke-width="2">
                                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                                                <circle cx="9" cy="7" r="4" />
                                                <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                                                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                                            </svg>
                                        </div>
                                        <svg class="kpi-more" width="16" height="16" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2">
                                            <circle cx="12" cy="12" r="1" />
                                            <circle cx="19" cy="12" r="1" />
                                            <circle cx="5" cy="12" r="1" />
                                        </svg>
                                    </div>
                                    <div class="kpi-value">
                                        <%= totalEmployees %>
                                    </div>
                                    <div class="kpi-label">Total active employees</div>
                                    <div class="kpi-footer">
                                        <div class="kpi-progress-wrap">
                                            <div class="kpi-progress-label"><span>Present today</span><span>
                                                    <%= activeEmployees %> /
                                                        <%= totalEmployees %>
                                                </span></div>
                                            <div class="progress-bar">
                                                <div class="progress-fill"
                                                    style="width:<%= (activeEmployees / totalEmployees) * 100 %>%;background:#1a56db">
                                                </div>
                                            </div>
                                        </div>
                                        <% if (diff> 0) { %>
                                            <span class="trend trend-up" style="margin-left:12px">+<%= diff %>
                                            </span>
                                            <% } else if (diff < 0) { %>
                                                <span class="trend trend-down" style="margin-left:12px">
                                                    <%= diff %>
                                                </span>
                                                <% } else { %>
                                                    <span class="trend trend-neutral" style="margin-left:12px">
                                                        <%= diff %>
                                                    </span>
                                                    <% } %>
                                    </div>
                                </div>

                                <!-- Taux d'absence -->
                                <div class="kpi-card">
                                    <div class="kpi-top">
                                        <div class="kpi-icon" style="background:var(--danger-light)">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="#c81e1e" stroke-width="2">
                                                <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
                                            </svg>
                                        </div>
                                        <svg class="kpi-more" width="16" height="16" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2">
                                            <circle cx="12" cy="12" r="1" />
                                            <circle cx="19" cy="12" r="1" />
                                            <circle cx="5" cy="12" r="1" />
                                        </svg>
                                    </div>
                                    <div class="kpi-value">
                                        <%= currentRate %>%
                                    </div>
                                    <div class="kpi-label">Overall absence rate</div>
                                    <div class="kpi-footer">
                                        <div class="kpi-progress-wrap">
                                            <div class="kpi-progress-label"><span>Objective &lt; 5%</span><span>
                                                    <%= variation> 0 ? '+' : '-' %><%= variation %>% vs
                                                            <span id="kpi-month"></span>
                                                </span></div>
                                            <div class="progress-bar">
                                                <div class="progress-fill"
                                                    style="width:<%= currentRate %>%;background:#c81e1e"></div>
                                            </div>
                                        </div>
                                        <span class="trend trend-down" style="margin-left:12px">
                                            <%= variation> 0 ? '↑' : '↓' %>
                                        </span>
                                    </div>
                                </div>

                                <!-- Leaves en cours -->
                                <div class="kpi-card">
                                    <div class="kpi-top">
                                        <div class="kpi-icon" style="background:var(--warning-light)">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="#b45309" stroke-width="2">
                                                <rect x="3" y="4" width="18" height="18" rx="2" />
                                                <line x1="16" y1="2" x2="16" y2="6" />
                                                <line x1="8" y1="2" x2="8" y2="6" />
                                                <line x1="3" y1="10" x2="21" y2="10" />
                                            </svg>
                                        </div>
                                        <svg class="kpi-more" width="16" height="16" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2">
                                            <circle cx="12" cy="12" r="1" />
                                            <circle cx="19" cy="12" r="1" />
                                            <circle cx="5" cy="12" r="1" />
                                        </svg>
                                    </div>
                                    <div class="kpi-value">
                                        <%= ongoingLeaves %>
                                    </div>
                                    <div class="kpi-label">Ongoing leaves</div>
                                    <div class="kpi-footer">
                                        <div class="kpi-progress-wrap">
                                            <div class="kpi-progress-label"><span>All categories</span><span>
                                                    <%= approvedLeaves %>
                                                        approved
                                                </span></div>
                                            <div class="progress-bar">
                                                <div class="progress-fill"
                                                    style="width:<%= approvalRate %>%;background:#b45309"></div>
                                            </div>
                                        </div>
                                        <span class="trend trend-neu" style="margin-left:12px">
                                            <%= totalLeaves %>
                                        </span>
                                    </div>
                                </div>

                                <!-- Demandes en attente -->
                                <div class="kpi-card">
                                    <div class="kpi-top">
                                        <div class="kpi-icon" style="background:var(--success-light)">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="#057a55" stroke-width="2">
                                                <path d="M9 11l3 3L22 4" />
                                                <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
                                            </svg>
                                        </div>
                                        <svg class="kpi-more" width="16" height="16" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2">
                                            <circle cx="12" cy="12" r="1" />
                                            <circle cx="19" cy="12" r="1" />
                                            <circle cx="5" cy="12" r="1" />
                                        </svg>
                                    </div>
                                    <div class="kpi-value">
                                        <%= pendingLeaves %>
                                    </div>
                                    <div class="kpi-label">Pending leaves</div>
                                    <div class="kpi-footer">
                                        <div class="kpi-progress-wrap">
                                            <div class="kpi-progress-label"><span>Leaves</span><span></span></div>
                                            <div class="progress-bar">
                                                <div class="progress-fill"
                                                    style="width:<%= pendingRate %>%;background:#057a55"></div>
                                            </div>
                                        </div>
                                        <span class="trend <%= pendingLeaves > 10 ? 'trend-down' : 'trend-up' %>"
                                            style="margin-left:12px">
                                            !
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <!-- ROW: Bar chart + Donut -->
                            <div class="grid-8-4">
                                <!-- Bar chart absences par mois -->

                                <div class="card">
                                    <div class="card-header">
                                        <div>
                                            <div class="card-title">Monthly Absences — <span id="yearTitle"></span>
                                            </div>
                                            <div class="card-subtitle">Cumulative absence days by category</div>
                                        </div>
                                        <div class="card-actions">
                                            <div class="card-dot" style="background:#ef4444" title="Supprimer">
                                            </div>
                                            <div class="card-dot" style="background:#f59e0b" title="Actualiser">
                                            </div>
                                            <div class="card-dot" style="background:#10b981" title="Agrandir"></div>
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        <div
                                            style="display:flex;align-items:center;gap:20px;margin-bottom:16px;flex-wrap:wrap;">
                                            <span
                                                style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text-2)"><span
                                                    style="width:10px;height:10px;border-radius:2px;background:#1a56db;display:inline-block"></span>Local
                                                Leave</span>
                                            <span
                                                style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text-2)"><span
                                                    style="width:10px;height:10px;border-radius:2px;background:#059669;display:inline-block"></span>Permission</span>
                                            <span
                                                style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text-2)"><span
                                                    style="width:10px;height:10px;border-radius:2px;background:#f59e0b;display:inline-block"></span>Indisponibilite</span>
                                        </div>
                                        <div id="absence-chart" class="bar-chart"></div>
                                        <div style="margin-top:4px;font-size:11px;color:var(--text-3);text-align:right">
                                            Colored segments are approved, gray segments are pending</div>
                                        <!-- Footer stats -->
                                        <div
                                            style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:16px;padding-top:16px;border-top:1px solid var(--border)">

                                            <!-- En attente -->
                                            <div
                                                style="padding:10px;background:var(--surface-2);border-radius:var(--radius-sm)">
                                                <div style="font-size:11px;color:var(--text-3);margin-bottom:4px">
                                                    Waiting
                                                </div>

                                                <div style="font-size:16px;font-weight:600">
                                                    <%= leaveStatus.totalFuture %> day(s)
                                                </div>

                                                <div class="progress-bar" style="margin-top:6px">
                                                    <div class="progress-fill"
                                                        style="width:<%= leaveStatus.totalFuturePct %>%;background:#7c008f">
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Complété -->
                                            <div
                                                style="padding:10px;background:var(--surface-2);border-radius:var(--radius-sm)">
                                                <div style="font-size:11px;color:var(--text-3);margin-bottom:4px">
                                                    Complete
                                                </div>

                                                <div style="font-size:16px;font-weight:600">
                                                    <%= leaveStatus.totalPast %> day(s)
                                                </div>

                                                <div class="progress-bar" style="margin-top:6px">
                                                    <div class="progress-fill"
                                                        style="width:<%= leaveStatus.totalPastPct %>%;background:#8f0000">
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Rejeté -->
                                            <!-- <div
                                                style="padding:10px;background:var(--surface-2);border-radius:var(--radius-sm)">
                                                <div style="font-size:11px;color:var(--text-3);margin-bottom:4px">
                                                    Rejeté
                                                </div>

                                                <div style="font-size:16px;font-weight:600">
                                                    <%= leaveStatus.totalRejected %> jour(s)
                                                </div>

                                                <div class="progress-bar" style="margin-top:6px">
                                                    <div class="progress-fill"
                                                        style="width:<%= leaveStatus.totalRejectedPct %>%;background:#c81e1e">
                                                    </div>
                                                </div>
                                            </div> -->

                                            <!-- Total -->
                                            <div
                                                style="padding:10px;background:var(--surface-2);border-radius:var(--radius-sm)">
                                                <div style="font-size:11px;color:var(--text-3);margin-bottom:4px">
                                                    Total
                                                </div>

                                                <div style="font-size:16px;font-weight:600">
                                                    <%= leaveStatus.total %> day(s)
                                                </div>

                                                <div class="progress-bar" style="margin-top:6px">
                                                    <div class="progress-fill" style="width:100%;background:#374151">
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>

                                <!-- Donut -->
                                <% const radius=90; const circumference=2 * Math.PI * radius; const
                                    localDash=(leaveTypes.localLeave / leaveTypes.total) * circumference; const
                                    permissionDash=(leaveTypes.permissionAMD / leaveTypes.total) * circumference; const
                                    indispoDash=(leaveTypes.indispo / leaveTypes.total) * circumference; const
                                    permission2hDash=(leaveTypes.permission2h / leaveTypes.total) * circumference; %>

                                    <div class="card">
                                        <div class="card-header">
                                            <div>
                                                <div class="card-title">Leave types</div>
                                                <div class="card-subtitle">Breakdown — <span
                                                        id="leave-types-month"></span>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="card-body">
                                            <div class="donut-wrap" style="flex-direction:column;gap:16px">
                                                <svg width="240" height="240" viewBox="0 0 240 240"
                                                    style="display:block;margin:0 auto">

                                                    <circle cx="120" cy="120" r="90" fill="none" stroke="var(--bg)"
                                                        stroke-width="28" />

                                                    <circle cx="120" cy="120" r="90" fill="none" stroke="#1a56db"
                                                        stroke-width="28"
                                                        stroke-dasharray="<%= localDash %> <%= circumference %>"
                                                        transform="rotate(-90 120 120)" />

                                                    <circle cx="120" cy="120" r="90" fill="none" stroke="#059669"
                                                        stroke-width="28"
                                                        stroke-dasharray="<%= permissionDash %> <%= circumference %>"
                                                        stroke-dashoffset="-<%= localDash %>"
                                                        transform="rotate(-90 120 120)" />

                                                    <circle cx="120" cy="120" r="90" fill="none" stroke="#f59e0b"
                                                        stroke-width="28"
                                                        stroke-dasharray="<%= indispoDash %> <%= circumference %>"
                                                        stroke-dashoffset="-<%= localDash + permissionDash %>"
                                                        transform="rotate(-90 120 120)" />

                                                    <text x="120" y="115" text-anchor="middle" font-size="30"
                                                        font-weight="600">
                                                        <%= leaveTypes.total %>
                                                    </text>

                                                    <text x="120" y="140" text-anchor="middle" font-size="15">
                                                        days total
                                                    </text>
                                                </svg>
                                            </div>
                                        </div>

                                        <div class="card-footer">

                                            <div class="legend-list" style="width:100%">
                                                <div class="legend-item">
                                                    <span class="legend-dot" style="background:#1a56db"></span>
                                                    Local Leave
                                                    <span class="legend-val">
                                                        <%= leaveTypes.localLeave %>j
                                                            <span class="legend-pct">
                                                                <%= leaveTypes.localPct %>%
                                                            </span>
                                                    </span>
                                                </div>

                                                <div class="legend-item">
                                                    <span class="legend-dot" style="background:#059669"></span>
                                                    Permission
                                                    <span class="legend-val">
                                                        <%= leaveTypes.permissionAMD %>j
                                                            <span class="legend-pct">
                                                                <%= leaveTypes.permissionPct %>%
                                                            </span>
                                                    </span>
                                                </div>

                                                <div class="legend-item">
                                                    <span class="legend-dot" style="background:#f59e0b"></span>
                                                    Indisponibilite
                                                    <span class="legend-val">
                                                        <%= leaveTypes.indispo %>j
                                                            <span class="legend-pct">
                                                                <%= leaveTypes.indispoPct %>%
                                                            </span>
                                                    </span>
                                                </div>

                                            </div>
                                            <!-- Voir le rapport complet -->
                                        </div>
                                    </div>
                            </div>

                            <!-- ROW: Dernières demandes + Planning -->
                            <div class="grid-8">
                                <div class="card stretch stretch-full d-flex">
                                    <div class="card-header">
                                        <div>
                                            <div class="card-title">Planning this month</div>
                                            <!-- <div class="card-subtitle">Nombre de jours d'absence cumulés par
                                                catégorie</div> -->
                                        </div>
                                        <!-- </div> -->
                                        <% if(user.role==='MANAGER' ) { %>
                                            <div class="col-md-2 <% if (title == 'Dashboard') { %> d-none<% } %>">
                                                <label for="startDateFilter" class="form-label ms-3">Start:</label>
                                                <input type="date" class="form-control mx-3" name="startDateFilter"
                                                    id="startDateFilter">
                                            </div>
                                            <div class="col-md-2 <% if (title == 'Dashboard') { %> d-none<% } %>">
                                                <label for="endDateFilter" class="form-label ms-3">End:</label>
                                                <input type="date" class="form-control mx-3" name="endDateFilter"
                                                    id="endDateFilter">
                                            </div>
                                            <% } %>
                                                <div>
                                                    <label class="form-label mb-1">Search</label>
                                                    <input type="text" name="search" id="search" class="form-control"
                                                        placeholder="Matricule, name..." />
                                                </div>
                                                <!-- </div> -->
                                    </div>
                                    <div class="card-body p-0 m-0">
                                        <div
                                            class="col-12 mb-3 task-header d-md-flex align-items-center justify-content-between">
                                            <div class="me-4 w-100 no-global-wrap">
                                                <div class="d-flex align-items-center no-global-wrap row g-1">
                                                    <div class="col-md-3 mt-3">
                                                        <label for="sectionFilter"
                                                            class="form-label ms-3 <% if(user.role==='MANAGER' ) { %>d-none<% } %>">
                                                            Section:
                                                        </label>
                                                        <select
                                                            class="form-select mx-3 <% if(user.role==='MANAGER' ) { %>d-none<% } %>"
                                                            name="sectionFilter" id="sectionFilter">

                                                            <% sectionList.forEach(function(section) { %>
                                                                <% if(section==='HR' ) { %>
                                                                    <option value="<%= section %>" selected>
                                                                        <%= section %>
                                                                    </option>
                                                                    <% } else { %>
                                                                        <option value="<%= section %>">
                                                                            <%= section %>
                                                                        </option>
                                                                        <% } %>
                                                                            <% }); %>

                                                        </select>
                                                    </div>
                                                    <div class="col-md-3 mt-3">
                                                        <label for="divisionFilter"
                                                            class="form-label ms-3 <% if(user.role==='MANAGER' ) { %>d-none<% } %>">Division:</label>
                                                        <select
                                                            class="form-select mx-3 <% if(user.role==='MANAGER' ) { %>d-none<% } %>"
                                                            name="divisionFilter" id="divisionFilter">
                                                            <% divisionList.forEach(function(division) { %>
                                                                <% if(division==='Administration' ) { %>
                                                                    <option value="<%= division %>" selected>
                                                                        <%= division %>
                                                                    </option>
                                                                    <% } else { %>
                                                                        <option value="<%= division %>">
                                                                            <%= division %>
                                                                        </option>
                                                                        <% } %>
                                                                            <% }); %>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-2 mt-3 d-none">
                                                        <label for="departementFilter"
                                                            class="form-label ms-3">Departement:</label>
                                                        <select class="form-select mx-3 d-none" name="departementFilter"
                                                            id="departementFilter">
                                                            <% departementList.forEach(function(departement) { %>
                                                                <% if(departement==='HR' ) { %>
                                                                    <option value="<%= departement %>" selected>
                                                                        <%= departement %>
                                                                    </option>
                                                                    <% } else { %>
                                                                        <option value="<%= departement %>">
                                                                            <%= departement %>
                                                                        </option>
                                                                        <% } %>
                                                                            <% }); %>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-2 mt-3">
                                                        <label for="lineFilter"
                                                            class="form-label ms-3
                                                                <% if(user.role==='MANAGER' ) { %>d-none<% } %>">Line:</label>
                                                        <select
                                                            class="form-select mx-3 <% if(user.role==='MANAGER' ) { %>d-none<% } %>"
                                                            name="lineFilter" id="lineFilter">
                                                            <% lineList.forEach(line=> { %>
                                                                <% if (line==='NULL' ) { %>
                                                                    <option value="<%= line %>" selected>
                                                                        <%= line %>
                                                                    </option>
                                                                    <% } else { %>
                                                                        <option value="<%= line %>">
                                                                            <%= line %>
                                                                        </option>
                                                                        <% } %>
                                                                            <% }) %>
                                                        </select>
                                                    </div>
                                                    <div
                                                        class="col-md-2 <% if(user.role!=='SUPERADMIN' ) { %>d-none<% } %>">
                                                        <label for="siteFilter" class="form-label ms-3">Site:</label>
                                                        <select class="form-select mx-3" name="siteFilter"
                                                            id="siteFilter">
                                                            <% allowedSites.forEach(function(site) { %>
                                                                <% const maValeur=site ; const
                                                                    index=allowedSites.indexOf(maValeur); const
                                                                    maCle=(index !==-1) ? KEYS[index] : "Inconnu" ; %>
                                                                    <% if(site===user.site) { %>
                                                                        <option value="<%= site %>" selected>
                                                                            <%= maCle %>
                                                                        </option>
                                                                        <% } else { %>
                                                                            <option value="<%= site %>">
                                                                                <%= maCle %>
                                                                            </option>
                                                                            <% } %>
                                                                                <% }); %>
                                                        </select>
                                                    </div>
                                                    <% if(user.role!=='MANAGER' ) { %>
                                                        <div
                                                            class="col-md-2 <% if (title == 'Dashboard') { %> d-none<% } %>">
                                                            <label for="startDateFilter"
                                                                class="form-label ms-3">Start:</label>
                                                            <input type="date" class="form-control mx-3"
                                                                name="startDateFilter" id="startDateFilter">
                                                        </div>
                                                        <div
                                                            class="col-md-2 <% if (title == 'Dashboard') { %> d-none<% } %>">
                                                            <label for="endDateFilter"
                                                                class="form-label ms-3">End:</label>
                                                            <input type="date" class="form-control mx-3"
                                                                name="endDateFilter" id="endDateFilter">
                                                        </div>
                                                        <% } %>

                                                </div>
                                            </div>
                                        </div>
                                        <%- include('partials/planning-calendar') %>
                                    </div>
                                </div>
                            </div>

                            <!-- ROW: Statut projets + Progrès équipe + Utilisateurs -->
                            <div class="grid-3">
                                <!-- Département absences -->
                                <div class="card">
                                    <div class="card-header">
                                        <div class="card-title">
                                            Absences by section
                                        </div>
                                    </div>

                                    <div class="card-body">

                                        <% const colors=[ "#1a56db" , "#059669" , "#f59e0b" , "#c81e1e" , "#8b5cf6" ];
                                            %>

                                            <% sectionStats.forEach((section, i)=> { %>

                                                <div class="progress-row">

                                                    <div class="progress-info">
                                                        <div class="progress-logo">
                                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                                                stroke="currentColor" stroke-width="2">
                                                                <circle cx="12" cy="12" r="10" />
                                                            </svg>
                                                        </div>

                                                        <div>
                                                            <div class="progress-name">
                                                                <%= section.section %>
                                                            </div>

                                                            <div class="progress-sub">
                                                                <%= section.employees %> employees • <%= section.absent
                                                                        %>
                                                                        absents
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="progress-track">
                                                        <div class="progress-fill2" style="
                            width:<%= section.pct %>%;
                            background:<%= colors[i % colors.length] %>
                        ">
                                                        </div>
                                                    </div>

                                                    <div class="progress-pct" style="
                        color:<%= colors[i % colors.length] %>
                    ">
                                                        <%= section.pct %>%
                                                    </div>

                                                </div>

                                                <% }) %>

                                    </div>
                                    <!-- <div class="card-footer">
                                        <a href="/leave/planning-view">Voir dans le planning</a>
                                    </div> -->
                                </div>

                                <!-- Service médical stats -->
                                <div class="card">
                                    <div class="card-header">
                                        <div class="card-title">
                                            Medical consultations by section
                                        </div>
                                    </div>

                                    <div class="card-body">

                                        <% medicalStats.forEach((section, i)=> { %>

                                            <div class="progress-row">

                                                <div class="progress-info">
                                                    <div class="progress-logo">
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                                            stroke="currentColor" stroke-width="2">
                                                            <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
                                                        </svg>
                                                    </div>

                                                    <div>
                                                        <div class="progress-name">
                                                            <%= section.section %>
                                                        </div>

                                                        <div class="progress-sub">
                                                            <%= section.consultation %> consultation(s)
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="progress-track">
                                                    <div class="progress-fill2" style="
                            width:<%= section.pct %>%;
                            background:<%= colors[i % colors.length] %>;
                        ">
                                                    </div>
                                                </div>

                                                <div class="progress-pct" style="
                        color:<%= colors[i % colors.length] %>;
                    ">
                                                    <%= section.pct %>%
                                                </div>

                                            </div>

                                            <% }) %>

                                    </div>

                                    <!-- <div class="card-footer">
                                        <a href="/smia-ostie/list">Voir toutes les consultations</a>
                                    </div> -->
                                </div>

                                <!-- Utilisateurs système -->
                                <% function getInitials(user){ return `${user.name?.[0] || "" }${user.firstName?.[0]
                                    || "" }`.toUpperCase(); } function getAvatarClass(i){ const colors=[ "av-blue"
                                    , "av-green" , "av-amber" , "av-purple" ]; return colors[i % colors.length]; }
                                    function getStatusColor(user){ if(user.isBlocked) return "#c81e1e" ;
                                    if(user.isSuspended) return "#f59e0b" ; if(user.isActive) return "#059669" ;
                                    return "#9ca3af" ; } %>
                                    <div class="card">
                                        <div class="card-header">
                                            <div class="card-title">
                                                App users
                                            </div>
                                        </div>

                                        <div class="card-body">

                                            <% userStats.users.forEach((user, i)=> { %>

                                                <div class="team-row">
                                                    <div class="team-info">

                                                        <div class="avatar <%= getAvatarClass(i) %>">
                                                            <%= getInitials(user) %>
                                                        </div>

                                                        <div>
                                                            <div class="team-name">
                                                                <%= user.name %>
                                                                    <%= user.firstName || "" %>
                                                            </div>

                                                            <div class="team-role">
                                                                <%= user.role %>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <svg width="8" height="8"
                                                        style="fill:<%= getStatusColor(user) %>;flex-shrink:0">
                                                        <circle cx="4" cy="4" r="4" />
                                                    </svg>
                                                </div>

                                                <% }) %>

                                                    <div style="
                margin-top:12px;
                padding:10px;
                background:var(--surface-2);
                border-radius:var(--radius-sm);
                border:1px solid var(--border)
            ">

                                                        <div
                                                            style="display:flex;justify-content:space-between;font-size:12px;">
                                                            <span style="color:var(--text-3)">
                                                                Administrators
                                                            </span>
                                                            <span style="font-weight:600">
                                                                <%= userStats.stats.admins %>
                                                            </span>
                                                        </div>

                                                        <div style="
                    display:flex;
                    justify-content:space-between;
                    font-size:12px;
                    margin-top:4px;
                ">
                                                            <span style="color:var(--text-3)">
                                                                HR Leads
                                                            </span>
                                                            <span style="font-weight:600">
                                                                <%= userStats.stats.hrManagers %>
                                                            </span>
                                                        </div>

                                                        <div style="
                    display:flex;
                    justify-content:space-between;
                    font-size:12px;
                    margin-top:4px;
                ">
                                                            <span style="color:var(--text-3)">
                                                                Payrolls
                                                            </span>
                                                            <span style="font-weight:600">
                                                                <%= userStats.stats.payrolls %>
                                                            </span>
                                                        </div>

                                                        <div style="
                    display:flex;
                    justify-content:space-between;
                    font-size:12px;
                    margin-top:4px;
                ">
                                                            <span style="color:var(--text-3)">
                                                                Managers
                                                            </span>
                                                            <span style="font-weight:600">
                                                                <%= userStats.stats.managers %>
                                                            </span>
                                                        </div>

                                                    </div>

                                        </div>

                                        <!-- <div class="card-footer">
                                            <a href="/user/list">Gérer les utilisateurs</a>
                                        </div> -->
                                    </div>
                            </div>

                        </div>

                    </div>

                    <!-- FOOTER -->
                    <%- include('partials/footer.ejs') %>
                </main>
                <script>
                    document.addEventListener("DOMContentLoaded", () => {
                        const labelSpan = document.querySelector('.kpi-progress-label span:last-child');
                        const yearTitle = document.getElementById('yearTitle');
                        const leaveTypesMonth = document.getElementById('leave-types-month');

                        if (yearTitle) {
                            const year = new Date().getFullYear();
                            yearTitle.textContent = year;
                        }
                        if (labelSpan) {
                            const date = new Date();
                            date.setMonth(date.getMonth() - 1);
                            const previousMonthName = date.toLocaleString('en-US', { month: 'long' }).toLowerCase();
                            document.getElementById('kpi-month').textContent = previousMonthName;
                        }
                        if (leaveTypesMonth) {
                            const date = new Date();
                            date.setMonth(date.getMonth());
                            const previousMonthName = date.toLocaleString('en-US', { month: 'long' }).toLowerCase();
                            document.getElementById('leave-types-month').textContent = previousMonthName + ' ' + date.getFullYear();
                        }
                        const monthlyStats = JSON.parse('<%- JSON.stringify(monthlyStats) %>');
                        console.log('monthlyStats', monthlyStats);
                        const chart = document.getElementById("absence-chart");

                        const months = [
                            "Jan", "Feb", "Mar", "Apr", "May", "Jun",
                            "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
                        ];

                        const currentMonth = new Date().getMonth();

                        const max = Math.max(
                            ...monthlyStats.map(m =>
                                m.leaveApproved +
                                m.leavePending +
                                m.permissionApproved +
                                m.permissionPending +
                                m.indispoApproved +
                                m.indispoPending
                            ),
                            1
                        );
                        monthlyStats.forEach((m, i) => {

                            const isFuture = i > currentMonth;

                            const barCol = document.createElement("div");
                            barCol.className = "bar-col";

                            const wrapper = document.createElement("div");
                            wrapper.style.cssText = `
            width:100%;
            display:flex;
            flex-direction:column;
            gap:2px;
            height:100%;
            justify-content:flex-end;
        `;

                            const leaveApproved = document.createElement("div");
                            leaveApproved.style.cssText = `
    width:100%;
    height:${(m.leaveApproved / max) * 100}%;
    background:#1a56db;
    opacity:.85;
`;

                            const leavePending = document.createElement("div");
                            leavePending.style.cssText = `
    width:100%;
    height:${(m.leavePending / max) * 100}%;
    background:var(--border);
    opacity:.85;
`;

                            const permissionApproved = document.createElement("div");
                            permissionApproved.style.cssText = `
    width:100%;
    height:${(m.permissionApproved / max) * 100}%;
    background:#059669;
    opacity:.85;
`;

                            const permissionPending = document.createElement("div");
                            permissionPending.style.cssText = `
    width:100%;
    height:${(m.permissionPending / max) * 100}%;
    background:var(--border);
    opacity:.85;
`;

                            const indispoApproved = document.createElement("div");
                            indispoApproved.style.cssText = `
    width:100%;
    height:${(m.indispoApproved / max) * 100}%;
    background:#f59e0b;
    opacity:.85;
`;

                            const indispoPending = document.createElement("div");
                            indispoPending.style.cssText = `
    width:100%;
    height:${(m.indispoPending / max) * 100}%;
    background:var(--border);
    opacity:.85;
`;

                            const label = document.createElement("span");
                            label.className = "bar-label-x";
                            label.innerText = months[i];

                            if (i === currentMonth) {
                                label.style.fontWeight = "600";
                                label.style.color = "var(--primary)";
                            }

                            leavePending.classList.add("bar-pending");
                            permissionPending.classList.add("bar-pending");
                            indispoPending.classList.add("bar-pending");

                            leavePending.title = `${m.leavePending}day(s) Leaves Pending`;
                            permissionPending.title = `${m.permissionPending}day(s) Permissions Pending`;
                            indispoPending.title = `${m.indispoPending}day(s) Indisponibilities Pending`;

                            leaveApproved.title = `${m.leaveApproved}day(s) Leaves Approved`;
                            permissionApproved.title = `${m.permissionApproved}day(s) Permissions Approved`;
                            indispoApproved.title = `${m.indispoApproved}day(s) Indisponibilities Approved`;

                            wrapper.appendChild(indispoPending);
                            wrapper.appendChild(permissionPending);
                            wrapper.appendChild(leavePending);
                            wrapper.appendChild(indispoApproved);
                            wrapper.appendChild(permissionApproved);
                            wrapper.appendChild(leaveApproved);

                            barCol.appendChild(wrapper);
                            barCol.appendChild(label);

                            chart.appendChild(barCol);
                        });

                    });
                </script>
    </body>

    </html>