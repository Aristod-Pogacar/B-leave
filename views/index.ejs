<%- include('partials/head.ejs') %>
    <link rel="stylesheet" type="text/css" href="/assets/css/dashboard.css">

    <body>
        <style>
            .bar-chart {
                height: 260px;
                display: flex;
                align-items: flex-end;
                gap: 14px;
            }

            .bar-col {
                flex: 1;
                height: 100%;
            }

            .bar-label-x {
                display: block;
                text-align: center;
                margin-top: 8px;
                font-size: 12px;
            }

            .bar-pending {
                background: var(--border) !important;
                opacity: .7;
            }

            .bar-chart>.bar-col div {
                transition: height .4s ease;
            }

            .chart-wrapper {
                display: flex;
                gap: 12px;
                align-items: stretch;
                height: 260px;
            }

            .chart-y-axis {
                width: 40px;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                font-size: 11px;
                color: var(--text-3);
                text-align: right;
                padding-bottom: 24px;
            }

            .bar-chart {
                flex: 1;
                display: flex;
                align-items: flex-end;
                gap: 14px;
                height: 100%;
            }

            .bar-col {
                flex: 1;
                display: flex;
                flex-direction: column;
                align-items: center;
                height: 100%;
            }

            .bar-group {
                width: 100%;
                height: 100%;
                display: flex;
                align-items: flex-end;
                gap: 4px;
            }

            .bar {
                flex: 1;
                border-radius: 4px 4px 0 0;
                min-height: 4px;
                transition: height .3s;
            }

            .bar-label-x {
                margin-top: 8px;
                font-size: 12px;
            }

            /* 
            .modal-overlay {
                position: fixed;
                inset: 0;
                background: rgba(0, 0, 0, .4);
                display: none;
                justify-content: center;
                align-items: center;
                z-index: 9999;
            }

            .modal-overlay.show {
                display: flex;
            }

            .modal-content {
                width: 900px;
                max-width: 90%;
                background: white;
                border-radius: 10px;
                padding: 20px;
            }

            .modal-header {
                display: flex;
                justify-content: space-between;
                margin-bottom: 20px;
            } */

            .manager-row {
                transition: all .2s;
            }

            .manager-row:hover {
                background: var(--surface-2);
                border-radius: var(--radius-sm);
            }

            .modal-transparente {
                background-color: rgba(0, 0, 0, 0) !important;
                /* Fond noir à 50% de transparence */
                border: none;
                /* Supprime la bordure par défaut de Bootstrap */
                backdrop-filter: blur(5px);
                /* Optionnel : ajoute un effet de flou super moderne à l'arrière-plan */
            }

            .kpi-card-modal {
                background: rgba(255, 255, 255, .04);
                border: 1px solid rgba(255, 255, 255, .08);
                border-radius: 18px;
                padding: 20px;
                transition: all .2s ease;
                height: 100%;
            }

            .kpi-card-modal:hover {
                transform: translateY(-4px);
                border-color: rgba(255, 255, 255, .15);
            }

            .kpi-header-modal {
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .kpi-title-modal {
                color: #d1d5db;
                font-size: .9rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: .5px;
            }

            .kpi-value-modal {
                font-size: 2.3rem;
                font-weight: 700;
                color: #fff;
                margin-top: 15px;
                line-height: 1;
            }

            .kpi-subtitle-modal {
                color: #9ca3af;
                margin-top: 6px;
                font-size: .85rem;
            }

            .kpi-footer-modal {
                margin-top: 24px;
            }

            .kpi-progress-label-modal {
                display: flex;
                justify-content: space-between;
                margin-bottom: 8px;
                color: #9ca3af;
                font-size: .8rem;
            }

            .progress-bar-modal {
                height: 8px;
                background: rgba(255, 255, 255, .08);
                border-radius: 999px;
                overflow: hidden;
            }

            .progress-fill-modal {
                height: 100%;
                border-radius: 999px;
                transition: width .4s ease;
            }

            .kpi-card-modal {
                background: #fff;
                border: none;
                border-radius: 18px;
                padding: 20px;
                height: 100%;

                box-shadow:
                    0 4px 12px rgba(0, 0, 0, .08),
                    0 2px 4px rgba(0, 0, 0, .04);

                transition: all .25s ease;
            }

            .kpi-card-modal:hover {
                transform: translateY(-4px);

                box-shadow:
                    0 12px 24px rgba(0, 0, 0, .12),
                    0 4px 8px rgba(0, 0, 0, .08);
            }

            .kpi-title-modal {
                color: #6b7280;
                font-size: .85rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: .5px;
            }

            .kpi-value-modal {
                font-size: 2.5rem;
                font-weight: 700;
                color: #111827;
                margin-top: 15px;
                line-height: 1;
            }

            .kpi-subtitle-modal {
                color: #9ca3af;
                margin-top: 6px;
                font-size: .85rem;
            }

            .progress-bar-modal {
                height: 8px;
                background: #e5e7eb;
                border-radius: 999px;
                overflow: hidden;
            }

            .modal-transparente .modal-header {
                border-bottom: none !important;
            }

            .modal-transparente .modal-footer {
                border-top: none !important;
            }

            .modal-transparente .modal-body,
            .modal-transparente .card-body {
                background: transparent;
            }

            .kpi-card-hover:hover {
                cursor: pointer;
                transform: translateY(-4px);

                box-shadow:
                    0 4px 8px rgba(0, 0, 0, .12),
                    0 2px 4px rgba(0, 0, 0, .08);
            }

            /* Modal */
            #employeeCountModal .modal-content {
                background: transparent;
                border: none;
                box-shadow: none !important;
            }

            /* Supprime les traits Bootstrap */
            #employeeCountModal .modal-header {
                border-bottom: none;
                padding-bottom: 0;
            }

            #employeeCountModal .modal-footer {
                border-top: none;
                background: transparent;
            }

            #employeeCountModal .modal-body,
            #employeeCountModal .card-body {
                background: transparent;
            }

            /* Bouton fermeture visible sur fond sombre */
            #employeeCountModal .btn-close {
                filter: invert(1);
            }
        </style>
        <%- include('partials/sidebar.ejs') %>
            <%- include('partials/header.ejs') %>
                <main class="nxl-container">
                    <!-- <main class="main"> -->
                    <div class="nxl-content">
                        <div class="page-header">
                            <div class="page-header-left d-flex align-items-center">
                                <div class="page-header-title">
                                    <h5 class="m-b-10">B-Leave</h5>
                                </div>
                                <ul class="breadcrumb">
                                    <li class="breadcrumb-item">Dashboard</li>
                                    <!-- <li class="breadcrumb-item">Overview</li> -->
                                </ul>
                            </div>
                            <div class="page-header-right ms-auto">
                                <div class="page-header-right-items">
                                    <div class="d-flex d-md-none">
                                        <a href="javascript:void(0)" class="page-header-right-close-toggle">
                                            <i class="feather-arrow-left me-2"></i>
                                            <span>Back</span>
                                        </a>
                                    </div>
                                </div>
                                <div class="d-md-none d-flex align-items-center">
                                    <a href="javascript:void(0)" class="page-header-right-open-toggle">
                                        <i class="feather-align-right fs-20"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <!-- <div class="content"> -->

                        <div class="main-content">
                            <!-- KPI CARDS -->
                            <div class="kpi-grid">
                                <!-- Employés -->
                                <div class="kpi-card kpi-card-hover" data-bs-toggle="modal"
                                    data-bs-target="#employeeCountModal" style="cursor:pointer">
                                    <div class="kpi-top">
                                        <div class="kpi-icon" style="background:var(--primary-light)">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="#01057d" stroke-width="2">
                                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                                                <circle cx="9" cy="7" r="4" />
                                                <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                                                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                                            </svg>
                                        </div>
                                    </div>
                                    <div class="kpi-value">
                                        <%= totalEmployees %>
                                    </div>
                                    <div class="kpi-label">Total active employees</div>
                                    <div class="kpi-footer">
                                        <div class="kpi-progress-wrap">
                                            <div class="kpi-progress-label"><span>Present today</span><span>
                                                    <%= activeEmployees %> /
                                                        <%= totalEmployees %>
                                                </span></div>
                                            <div class="progress-bar">
                                                <div class="progress-fill"
                                                    style="width:<%= (activeEmployees / totalEmployees) * 100 %>%;background:#01057d">
                                                </div>
                                            </div>
                                        </div>
                                        <% if (diff> 0) { %>
                                            <span class="trend trend-up" style="margin-left:12px">+<%= diff %>
                                            </span>
                                            <% } else if (diff < 0) { %>
                                                <span class="trend trend-down" style="margin-left:12px">
                                                    <%= diff %>
                                                </span>
                                                <% } else { %>
                                                    <span class="trend trend-neutral" style="margin-left:12px">
                                                        <%= diff %>
                                                    </span>
                                                    <% } %>
                                    </div>
                                </div>

                                <!-- Taux d'absence -->
                                <div class="kpi-card kpi-card-hover" data-bs-toggle="modal"
                                    data-bs-target="#absenceRateModal" style="cursor:pointer">
                                    <div class="kpi-top">
                                        <div class="kpi-icon" style="background:var(--danger-light)">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="#c81e1e" stroke-width="2">
                                                <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
                                            </svg>
                                        </div>
                                    </div>
                                    <div class="kpi-value">
                                        <%= monthlyGlobalAbsenceRate.currentRate %>%
                                    </div>
                                    <div class="kpi-label">This month absence rate</div>
                                    <div class="kpi-footer">
                                        <div class="kpi-progress-wrap">
                                            <div class="kpi-progress-label"><span>Objective &lt; 5%</span><span>
                                                    <%= monthlyGlobalAbsenceRate.variation> 0 ? '+' : '' %><%=
                                                            monthlyGlobalAbsenceRate.variation %>% vs
                                                            <span id="kpi-month"></span>
                                                </span></div>
                                            <div class="progress-bar">
                                                <div class="progress-fill"
                                                    style="width:<%= monthlyGlobalAbsenceRate.currentRate %>%;background:#c81e1e">
                                                </div>
                                            </div>
                                        </div>
                                        <span
                                            class="trend trend-<%= monthlyGlobalAbsenceRate.variation> 0 ? 'down' : 'up' %>"
                                            style="margin-left:12px">
                                            <%= monthlyGlobalAbsenceRate.variation> 0 ? '↑' : '↓' %>
                                        </span>
                                    </div>
                                </div>

                                <!-- Leaves en cours -->
                                <div class="kpi-card kpi-card-hover" data-bs-toggle="modal"
                                    data-bs-target="#ongoingLeavesModal" style="cursor:pointer">
                                    <div class="kpi-top">
                                        <div class="kpi-icon" style="background:var(--warning-light)">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="#b45309" stroke-width="2">
                                                <rect x="3" y="4" width="18" height="18" rx="2" />
                                                <line x1="16" y1="2" x2="16" y2="6" />
                                                <line x1="8" y1="2" x2="8" y2="6" />
                                                <line x1="3" y1="10" x2="21" y2="10" />
                                            </svg>
                                        </div>
                                    </div>
                                    <div class="kpi-value">
                                        <%= ongoingLeaves %>
                                    </div>
                                    <div class="kpi-label">Employees on Leave</div>
                                    <div class="kpi-footer">
                                        <div class="kpi-progress-wrap">
                                            <div class="kpi-progress-label"><span>All categories</span><span>
                                                    <%= approvedLeaves %>
                                                        approved
                                                </span></div>
                                            <div class="progress-bar">
                                                <div class="progress-fill"
                                                    style="width:<%= approvalRate %>%;background:#b45309"></div>
                                            </div>
                                        </div>
                                        <span class="trend trend-neu" style="margin-left:12px">
                                            <%= totalLeaves %>
                                        </span>
                                    </div>
                                </div>

                                <!-- Demandes en attente -->
                                <div class="kpi-card kpi-card-hover" data-bs-toggle="modal"
                                    data-bs-target="#pendingLeavesModal" style="cursor:pointer">
                                    <div class="kpi-top">
                                        <div class="kpi-icon" style="background:var(--success-light)">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="#057a55" stroke-width="2">
                                                <path d="M9 11l3 3L22 4" />
                                                <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
                                            </svg>
                                        </div>
                                    </div>
                                    <div class="kpi-value">
                                        <%= pendingLeaves %>
                                    </div>
                                    <div class="kpi-label">Pending leaves</div>
                                    <div class="kpi-footer">
                                        <div class="kpi-progress-wrap">
                                            <div class="kpi-progress-label"><span>Leaves</span><span></span></div>
                                            <div class="progress-bar">
                                                <div class="progress-fill"
                                                    style="width:<%= pendingRate %>%;background:#057a55"></div>
                                            </div>
                                        </div>
                                        <span class="trend <%= pendingLeaves > 10 ? 'trend-down' : 'trend-up' %>"
                                            style="margin-left:12px">
                                            !
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <!-- ROW: Bar chart + Donut -->
                            <div class="grid-8-4">
                                <!-- Bar chart absences par mois -->

                                <div class="card">
                                    <div class="card-header">
                                        <div>
                                            <div class="card-title">Monthly Absences — <span id="yearTitle"></span>
                                            </div>
                                            <div class="card-subtitle">Cumulative absence days by category</div>
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        <div
                                            style="display:flex;align-items:center;gap:20px;margin-bottom:16px;flex-wrap:wrap;">
                                            <span
                                                style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text-2)"><span
                                                    style="width:10px;height:10px;border-radius:2px;background:#01057d;display:inline-block"></span>Local
                                                Leave</span>
                                            <span
                                                style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text-2)"><span
                                                    style="width:10px;height:10px;border-radius:2px;background:#108e05;display:inline-block"></span>Permission</span>
                                            <span
                                                style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text-2)"><span
                                                    style="width:10px;height:10px;border-radius:2px;background:#b00718;display:inline-block"></span>Indisponibilite</span>
                                        </div>
                                        <div class="chart-wrapper">
                                            <div class="chart-y-axis" id="chart-y-axis"></div>
                                            <div id="absence-chart" class="bar-chart"></div>
                                        </div>
                                        <div style="margin-top:4px;font-size:11px;color:var(--text-3);text-align:right">
                                            Colored segments are approved, gray segments are pending</div>
                                        <!-- Footer stats -->
                                        <div
                                            style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:16px;padding-top:16px;border-top:1px solid var(--border)">

                                            <!-- En attente -->
                                            <div
                                                style="padding:10px;background:var(--surface-2);border-radius:var(--radius-sm)">
                                                <div style="font-size:11px;color:var(--text-3);margin-bottom:4px">
                                                    Waiting
                                                </div>

                                                <div style="font-size:16px;font-weight:600">
                                                    <%= leaveStatus.totalFuture %> day(s)
                                                </div>

                                                <div class="progress-bar" style="margin-top:6px">
                                                    <div class="progress-fill"
                                                        style="width:<%= leaveStatus.totalFuturePct %>%;background:#7c008f">
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Complété -->
                                            <div
                                                style="padding:10px;background:var(--surface-2);border-radius:var(--radius-sm)">
                                                <div style="font-size:11px;color:var(--text-3);margin-bottom:4px">
                                                    Complete
                                                </div>

                                                <div style="font-size:16px;font-weight:600">
                                                    <%= leaveStatus.totalPast %> day(s)
                                                </div>

                                                <div class="progress-bar" style="margin-top:6px">
                                                    <div class="progress-fill"
                                                        style="width:<%= leaveStatus.totalPastPct %>%;background:#8f0000">
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Rejeté -->
                                            <!-- <div
                                                style="padding:10px;background:var(--surface-2);border-radius:var(--radius-sm)">
                                                <div style="font-size:11px;color:var(--text-3);margin-bottom:4px">
                                                    Rejeté
                                                </div>

                                                <div style="font-size:16px;font-weight:600">
                                                    <%= leaveStatus.totalRejected %> jour(s)
                                                </div>

                                                <div class="progress-bar" style="margin-top:6px">
                                                    <div class="progress-fill"
                                                        style="width:<%= leaveStatus.totalRejectedPct %>%;background:#c81e1e">
                                                    </div>
                                                </div>
                                            </div> -->

                                            <!-- Total -->
                                            <div
                                                style="padding:10px;background:var(--surface-2);border-radius:var(--radius-sm)">
                                                <div style="font-size:11px;color:var(--text-3);margin-bottom:4px">
                                                    Total
                                                </div>

                                                <div style="font-size:16px;font-weight:600">
                                                    <%= leaveStatus.total %> day(s)
                                                </div>

                                                <div class="progress-bar" style="margin-top:6px">
                                                    <div class="progress-fill" style="width:100%;background:#374151">
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>

                                <!-- Donut -->
                                <% const radius=90; const circumference=2 * Math.PI * radius; const
                                    localDash=(leaveTypes.localLeave / leaveTypes.total) * circumference; const
                                    permissionDash=(leaveTypes.permissionAMD / leaveTypes.total) * circumference; const
                                    indispoDash=(leaveTypes.indispo / leaveTypes.total) * circumference; const
                                    permission2hDash=(leaveTypes.permission2h / leaveTypes.total) * circumference; %>

                                    <div class="card">
                                        <div class="card-header">
                                            <div>
                                                <div class="card-title">Leave types</div>
                                                <div class="card-subtitle">Breakdown — <span
                                                        id="leave-types-month"></span>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="card-body">
                                            <div class="donut-wrap" style="flex-direction:column;gap:16px">
                                                <svg width="240" height="240" viewBox="0 0 240 240"
                                                    style="display:block;margin:0 auto">

                                                    <circle cx="120" cy="120" r="90" fill="none" stroke="var(--bg)"
                                                        stroke-width="28" />

                                                    <circle cx="120" cy="120" r="90" fill="none" stroke="#01057d"
                                                        stroke-width="28"
                                                        stroke-dasharray="<%= localDash %> <%= circumference %>"
                                                        transform="rotate(-90 120 120)" title="Local Leave" />

                                                    <circle cx="120" cy="120" r="90" fill="none" stroke="#108e05"
                                                        stroke-width="28"
                                                        stroke-dasharray="<%= permissionDash %> <%= circumference %>"
                                                        stroke-dashoffset="-<%= localDash %>"
                                                        transform="rotate(-90 120 120)" title="Permission" />

                                                    <circle cx="120" cy="120" r="90" fill="none" stroke="#b00718"
                                                        stroke-width="28"
                                                        stroke-dasharray="<%= indispoDash %> <%= circumference %>"
                                                        stroke-dashoffset="-<%= localDash + permissionDash %>"
                                                        transform="rotate(-90 120 120)" title="Indisponibilite" />

                                                    <text x="120" y="115" text-anchor="middle" font-size="30"
                                                        font-weight="600">
                                                        <%= leaveTypes.total %>
                                                    </text>

                                                    <text x="120" y="140" text-anchor="middle" font-size="15">
                                                        days total
                                                    </text>
                                                </svg>
                                            </div>
                                        </div>

                                        <div class="card-footer">

                                            <div class="legend-list" style="width:100%">
                                                <div class="legend-item">
                                                    <span class="legend-dot" style="background:#01057d"></span>
                                                    Local Leave
                                                    <span class="legend-val">
                                                        <%= leaveTypes.localLeave %>j
                                                            <span class="legend-pct">
                                                                <%= leaveTypes.localPct %>%
                                                            </span>
                                                    </span>
                                                </div>

                                                <div class="legend-item">
                                                    <span class="legend-dot" style="background:#108e05"></span>
                                                    Permission
                                                    <span class="legend-val">
                                                        <%= leaveTypes.permissionAMD %>j
                                                            <span class="legend-pct">
                                                                <%= leaveTypes.permissionPct %>%
                                                            </span>
                                                    </span>
                                                </div>

                                                <div class="legend-item">
                                                    <span class="legend-dot" style="background:#b00718"></span>
                                                    Indisponibilite
                                                    <span class="legend-val">
                                                        <%= leaveTypes.indispo %>j
                                                            <span class="legend-pct">
                                                                <%= leaveTypes.indispoPct %>%
                                                            </span>
                                                    </span>
                                                </div>

                                            </div>
                                            <!-- Voir le rapport complet -->
                                        </div>
                                    </div>
                            </div>

                            <!-- ROW: Dernières demandes + Planning -->
                            <div class="grid-8">
                                <div class="card stretch stretch-full d-flex">
                                    <div class="card-header">
                                        <div>
                                            <div class="card-title">Planning this month</div>
                                            <!-- <div class="card-subtitle">Nombre de jours d'absence cumulés par
                                                catégorie</div> -->
                                        </div>
                                        <!-- </div> -->
                                        <% if(user.role==='MANAGER' ) { %>
                                            <div class="col-md-2 <% if (title == 'Dashboard') { %> d-none<% } %>">
                                                <label for="startDateFilter" class="form-label ms-3">Start:</label>
                                                <input type="date" class="form-control mx-3" name="startDateFilter"
                                                    id="startDateFilter">
                                            </div>
                                            <div class="col-md-2 <% if (title == 'Dashboard') { %> d-none<% } %>">
                                                <label for="endDateFilter" class="form-label ms-3">End:</label>
                                                <input type="date" class="form-control mx-3" name="endDateFilter"
                                                    id="endDateFilter">
                                            </div>
                                            <% } %>
                                                <div>
                                                    <label class="form-label mb-1">Search</label>
                                                    <input type="text" name="search" id="search" class="form-control"
                                                        placeholder="Matricule, name..." />
                                                </div>
                                                <!-- </div> -->
                                    </div>
                                    <div class="card-body p-0 m-0">
                                        <div
                                            class="col-12 mb-3 task-header d-md-flex align-items-center justify-content-between">
                                            <div class="me-4 w-100 no-global-wrap">
