                                const medicalServiceId = row.dataset.medicalServiceId;
                                const medicalServiceName = row.dataset.medicalServiceName;

                                document.getElementById('medicalServiceModalTitle')
                                    .innerText = "Consultations in the team of " + medicalServiceName;

                                const response = await fetch(
                                    `/smia-ostie/manager/${medicalServiceId}/medical-services`
                                );

                                const data = await response.json();

                                const body =
                                    document.getElementById('medicalServiceModalBody');

                                body.innerHTML = '';
                                if (data.length == 0) {
                                    body.innerHTML = `
                                        <div class="text-center">
                                            <p>No consultations found for this team</p>
                                        </div>
                                    `;
                                    return;
                                }
                                data.forEach(medicalService => {

                                    body.innerHTML = `
    <table class="table table-striped table-hover mb-0">
        <thead>
            <tr>
                <th>Employee</th>
                <th>Reason</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            ${data.map(medicalService => `
                <tr>
                    <td>${medicalService.employee.firstname} ${medicalService.employee.name}</td>
                    <td>${medicalService.reason}</td>
                    <td>${new Date(medicalService.date).toLocaleDateString('fr-FR')}</td>
