<%- include('partials/head.ejs') %>

    <body>
        <%- include('partials/sidebar.ejs') %>
            <%- include('partials/header.ejs') %>
                <main class="nxl-container">
                    <div class="nxl-content">
                        <div class="page-header">
                            <div class="page-header-left d-flex align-items-center">
                                <div class="page-header-title">
                                    <h5 class="m-b-10">B-Leave</h5>
                                </div>
                                <ul class="breadcrumb">
                                    <li class="breadcrumb-item">Leaves</li>
                                    <li class="breadcrumb-item">Planning</li>
                                </ul>
                            </div>
                            <div class="page-header-right ms-auto">
                                <div class="page-header-right-items">
                                    <div class="d-flex d-md-none">
                                        <a href="javascript:void(0)" class="page-header-right-close-toggle">
                                            <i class="feather-arrow-left me-2"></i>
                                            <span>Back</span>
                                        </a>
                                    </div>
                                </div>
                                <div class="d-md-none d-flex align-items-center">
                                    <a href="javascript:void(0)" class="page-header-right-open-toggle">
                                        <i class="feather-align-right fs-20"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <!-- [ page-header ] end -->
                        <div class="bg-white py-3 border-bottom rounded-0 p-md-0 mb-0">
                            <div class="d-md-none d-flex align-items-center justify-content-between">
                                <a href="javascript:void(0)" class="page-content-left-open-toggle">
                                    <i class="feather-align-left fs-20"></i>
                                </a>
                            </div>
                        </div>
                        <!-- [ Main Content ] start -->
                        <div class="main-content">
                            <div class="tab-content">
                                <div class="tab-pane fade active show" id="overviewTab">
                                    <div class="row">

                                        <div class="col-xl-12">
                                            <div class="card stretch stretch-full d-flex">
                                                <div class="card-header">
                                                    <div class="d-flex align-items-center">
                                                        <div class="avatar-text avatar-lg bg-soft-primary me-3">
                                                            <i class="feather-calendar"></i>
                                                        </div>

                                                        <div>
                                                            <h4 class="mb-1">Leave Planning</h4>
                                                            <p class="text-muted mb-0">
                                                                Plan and manage employee leave.
                                                            </p>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="card-body border-bottom bg-light">

                                                    <!-- ===== LEFT: FORM ===== -->
                                                    <div class="col-md-12">

                                                        <!-- Recherche Employé -->
                                                        <div class="mb-0">
                                                            <div class="row">
                                                                <div class="col-md-12 mb-3">
                                                                    <label class=" form-label">Search</label>
                                                                    <input type="text" class="form-control" id="search"
                                                                        name="search" autocomplete="off"
                                                                        placeholder="Employee ID, name...">
                                                                </div>
                                                                <div class="col-md-3 mb-3">
                                                                    <label for="sectionFilter"
                                                                        class="form-label <% if(user.role==='MANAGER' ) { %>d-none<% } %>">
                                                                        Section:
                                                                    </label>
                                                                    <select
                                                                        class="form-select <% if(user.role==='MANAGER' ) { %>d-none<% } %>"
                                                                        name="sectionFilter" id="sectionFilter">

                                                                        <% sectionList.forEach(function(section) { %>
                                                                            <% if(section==='HR' ) { %>
                                                                                <option value="<%= section %>" selected>
                                                                                    <%= section %>
                                                                                </option>
                                                                                <% } else { %>
                                                                                    <option value="<%= section %>">
                                                                                        <%= section %>
                                                                                    </option>
                                                                                    <% } %>
                                                                                        <% }); %>

                                                                    </select>
                                                                </div>
                                                                <div class="col-md-3 mb-3">
                                                                    <label for="divisionFilter"
                                                                        class="form-label <% if(user.role==='MANAGER' ) { %>d-none<% } %>">Division:</label>
                                                                    <select
                                                                        class="form-select <% if(user.role==='MANAGER' ) { %>d-none<% } %>"
                                                                        name="divisionFilter" id="divisionFilter">
                                                                        <% divisionList.forEach(function(division) { %>
                                                                            <% if(division==='Administration' ) { %>
                                                                                <option value="<%= division %>"
                                                                                    selected>
                                                                                    <%= division %>
                                                                                </option>
                                                                                <% } else { %>
                                                                                    <option value="<%= division %>">
                                                                                        <%= division %>
                                                                                    </option>
                                                                                    <% } %>
                                                                                        <% }); %>
                                                                    </select>
                                                                </div>
                                                                <div class="col-md-3 mb-3 d-none">
                                                                    <label for="departementFilter"
                                                                        class="form-label">Departement:</label>
                                                                    <select class="form-select d-none"
                                                                        name="departementFilter" id="departementFilter">
                                                                        <% departementList.forEach(function(departement)
                                                                            { %>
                                                                            <% if(departement==='HR' ) { %>
                                                                                <option value="<%= departement %>"
                                                                                    selected>
                                                                                    <%= departement %>
                                                                                </option>
                                                                                <% } else { %>
                                                                                    <option value="<%= departement %>">
                                                                                        <%= departement %>
                                                                                    </option>
                                                                                    <% } %>
                                                                                        <% }); %>
                                                                    </select>
                                                                </div>
                                                                <div class="col-md-3 mb-3">
                                                                    <label for="lineFilter"
                                                                        class="form-label <% if(user.role==='MANAGER' ) { %>d-none<% } %>">Line:</label>
                                                                    <select
                                                                        class="form-select <% if(user.role==='MANAGER' ) { %>d-none<% } %>"
                                                                        name="lineFilter" id="lineFilter">
                                                                        <% lineList.forEach(line=> { %>
                                                                            <% if (line==='NULL' ) { %>
                                                                                <option value="<%= line %>" selected>
                                                                                    <%= line %>
                                                                                </option>
                                                                                <% } else { %>
                                                                                    <option value="<%= line %>">
                                                                                        <%= line %>
                                                                                    </option>
                                                                                    <% } %>
                                                                                        <% }) %>
                                                                    </select>
                                                                </div>
                                                                <div
                                                                    class="col-md-3 mb-3 <% if(user.role!=='SUPERADMIN' ) { %>d-none<% } %>">
                                                                    <label for="siteFilter"
                                                                        class="form-label">Site:</label>
                                                                    <select class="form-select" name="siteFilter"
                                                                        id="siteFilter">
                                                                        <% allowedSites.forEach(function(site) { %>
                                                                            <% const maValeur=site ; const
                                                                                index=allowedSites.indexOf(maValeur);
                                                                                const maCle=(index !==-1) ? KEYS[index]
                                                                                : "Inconnu" ; %>
                                                                                <% if(site===user.site) { %>
                                                                                    <option value="<%= site %>"
                                                                                        selected>
                                                                                        <%= maCle %>
                                                                                    </option>
                                                                                    <% } else { %>
                                                                                        <option value="<%= site %>">
                                                                                            <%= maCle %>
                                                                                        </option>
                                                                                        <% } %>
                                                                                            <% }); %>
                                                                    </select>
                                                                </div>
                                                                <div class="col-md-6 mb-3">
                                                                    <label for="startDateFilter"
                                                                        class="form-label">Start:</label>
                                                                    <input type="date" class="form-control"
                                                                        name="startDateFilter" id="startDateFilter">
                                                                </div>
                                                                <div class="col-md-6 mb-3">
                                                                    <label for="endDateFilter"
                                                                        class="form-label">End:</label>
                                                                    <input type="date" class="form-control"
                                                                        name="endDateFilter" id="endDateFilter">
                                                                </div>
                                                            </div>
                                                        </div>

                                                    </div>

                                                    <div class="row mt-2 d-none">
                                                        <div class="col-md-12 text-center">
                                                            <p id="message" class="fw-bold"></p>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="card-body p-0 m-0">
                                                    <%- include('partials/planning-calendar') %>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <%- include('partials/footer.ejs') %>
    </body>

    </html>