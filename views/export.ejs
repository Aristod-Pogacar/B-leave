<%- include('partials/head.ejs') %>

    <body>
        <%- include('partials/sidebar.ejs') %>
            <%- include('partials/header.ejs') %>
                <main class="nxl-container">
                    <div class="nxl-content">
                        <div class="page-header">
                            <div class="page-header-left d-flex align-items-center">
                                <div class="page-header-title">
                                    <h5 class="m-b-10">B-Leave</h5>
                                </div>
                                <ul class="breadcrumb">
                                    <li class="breadcrumb-item">Leaves</li>
                                    <li class="breadcrumb-item">Export</li>
                                </ul>
                            </div>
                            <div class="page-header-right ms-auto">
                                <div class="page-header-right-items">
                                    <div class="d-flex d-md-none">
                                        <a href="javascript:void(0)" class="page-header-right-close-toggle">
                                            <i class="feather-arrow-left me-2"></i>
                                            <span>Back</span>
                                        </a>
                                    </div>
                                </div>
                                <div class="d-md-none d-flex align-items-center">
                                    <a href="javascript:void(0)" class="page-header-right-open-toggle">
                                        <i class="feather-align-right fs-20"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <!-- [ page-header ] end -->
                        <div class="bg-white py-3 border-bottom rounded-0 p-md-0 mb-0">
                            <div class="d-md-none d-flex align-items-center justify-content-between">
                                <a href="javascript:void(0)" class="page-content-left-open-toggle">
                                    <i class="feather-align-left fs-20"></i>
                                </a>
                            </div>
                        </div>
                        <!-- [ Main Content ] start -->
                        <div class="main-content">
                            <div class="tab-content">
                                <div class="tab-pane fade active show" id="overviewTab">
                                    <div class="row">

                                        <div class="col-12">
                                            <div class="card stretch stretch-full d-flex">
                                                <div class="card-header">
                                                    <div class="d-flex align-items-center">
                                                        <div class="avatar-text avatar-lg bg-soft-primary me-3">
                                                            <i class="feather-download"></i>
                                                        </div>

                                                        <div>
                                                            <h4 class="mb-1">Export leaves</h4>
                                                            <p class="text-muted mb-0">
                                                                Export leaves into Excel format.
                                                            </p>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="card-body border-bottom bg-light">
                                                    <div class="col-md-12">

                                                        <div class="mb-0">
                                                            <form id="userForm" method="POST"
                                                                action="/leave/export-planning">
                                                                <div class="row">
                                                                    <div class="col-md-3 mb-3">
                                                                        <label class="form-label">Section</label>
                                                                        <select class="form-select" name="section"
                                                                            id="sectionFilter">
                                                                            <% sectionList.forEach(function(section) {
                                                                                %>
                                                                                <% if(section==='HR' ) { %>
                                                                                    <option value="<%= section %>"
                                                                                        selected>
                                                                                        <%= section %>
                                                                                    </option>
                                                                                    <% } else { %>
                                                                                        <option value="<%= section %>">
                                                                                            <%= section %>
                                                                                        </option>
                                                                                        <% } %>
                                                                                            <% }); %>
                                                                        </select>
                                                                    </div>
                                                                    <div class="col-md-3 mb-3">
                                                                        <label class="form-label">Division</label>
                                                                        <select class="form-select" name="division"
                                                                            id="divisionFilter">
                                                                            <% divisionList.forEach(function(division) {
                                                                                %>
                                                                                <% if(division==='HR' ) { %>
                                                                                    <option value="<%= division %>"
                                                                                        selected>
                                                                                        <%= division %>
                                                                                    </option>
                                                                                    <% } else { %>
                                                                                        <option value="<%= division %>">
                                                                                            <%= division %>
                                                                                        </option>
                                                                                        <% } %>
                                                                                            <% }); %>
                                                                        </select>
                                                                    </div>
                                                                    <div class="col-md-3 mb-3">
                                                                        <label class="form-label">Line</label>
                                                                        <select class="form-select" name="line"
                                                                            id="lineFilter">
                                                                            <% lineList.forEach(line=> { %>
                                                                                <% if (line==='NULL' ) { %>
                                                                                    <option value="<%= line %>"
                                                                                        selected>
                                                                                        <%= line %>
                                                                                    </option>
                                                                                    <% } else { %>
                                                                                        <option value="<%= line %>">
                                                                                            <%= line %>
                                                                                        </option>
                                                                                        <% } %>
                                                                                            <% }) %>
                                                                        </select>
                                                                    </div>
                                                                    <div class="col-md-3 mb-3">
                                                                        <label class="form-label">Site</label>
                                                                        <select class="form-select" name="site"
                                                                            id="siteFilter">
                                                                            <% allowedSites.forEach(function(site) { %>
                                                                                <% const maValeur=site ; const
                                                                                    index=allowedSites.indexOf(maValeur);
                                                                                    const maCle=(index !==-1) ?
                                                                                    KEYS[index] : "Inconnu" ; %>
                                                                                    <% if(site===user.site) { %>
                                                                                        <option value="<%= site %>"
                                                                                            selected>
                                                                                            <%= maCle %>
                                                                                        </option>
                                                                                        <% } else { %>
                                                                                            <option value="<%= site %>">
                                                                                                <%= maCle %>
                                                                                            </option>
                                                                                            <% } %>
                                                                                                <% }); %>
                                                                        </select>
                                                                    </div>
                                                                </div>
                                                                <div class="row">
                                                                    <div class="col-md-4 mb-3">
                                                                        <label class="form-label">Start
                                                                            date</label>
                                                                        <input type="date" class="form-control"
                                                                            id="startDate" name="startDate"
                                                                            placeholder="Enter your start date"
                                                                            required>
                                                                    </div>
                                                                    <div class="col-md-4 mb-3">
                                                                        <label class="form-label">End
                                                                            date</label>
                                                                        <input type="date" class="form-control"
                                                                            id="endDate" name="endDate"
                                                                            placeholder="Enter your end date" required>
                                                                    </div>
                                                                    <div class="col-md-4">
                                                                        <label for="status"
                                                                            class="form-label">Status</label>
                                                                        <select name="status" id="status"
                                                                            class="form-select">
                                                                            <option value="approved">Approved
                                                                            </option>
                                                                            <option value="pending">Pending
                                                                            </option>
                                                                            <option value="rejected">Rejected
                                                                            </option>
                                                                            <option value="all">All</option>
                                                                        </select>
                                                                    </div>
                                                                </div>
                                                            </form>
                                                        </div>

                                                    </div>

                                                </div>

                                                <div class="card-footer">
                                                    <button type="submit" form="userForm" class="btn btn-primary"
                                                        id="submit">
                                                        <i class="feather-download me-2"></i>
                                                        Export
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <%- include('partials/new-leave-modal-test') %>
                        <%- include('partials/footer.ejs') %>
    </body>

    </html>