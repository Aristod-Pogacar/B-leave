<%- include('partials/head.ejs') %>

    <body>
        <%- include('partials/sidebar.ejs') %>
            <%- include('partials/header.ejs') %>
                <main class="nxl-container">
                    <div class="nxl-content">
                        <div class="page-header">
                            <div class="page-header-left d-flex align-items-center">
                                <div class="page-header-title">
                                    <h5 class="m-b-10">B-Leave</h5>
                                </div>
                                <ul class="breadcrumb">
                                    <li class="breadcrumb-item">Medical service</li>
                                    <li class="breadcrumb-item">Employee consultations list</li>
                                </ul>
                            </div>
                        </div>

                        <div class="main-content">

                            <!-- Results -->
                            <div class="card border-0 shadow-sm">
                                <div class="card-body border-bottom">
                                    <div
                                        class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">

                                        <div>
                                            <h3 class="fw-bold mb-1">
                                                Employee Consultations
                                            </h3>

                                            <p class="text-muted mb-0">
                                                Search, filter and export employee medical consultations.
                                            </p>
                                        </div>

                                        <div class="d-flex gap-2">

                                            <div class="badge bg-soft-primary text-primary px-3 py-2">
                                                <%= total %> Records
                                            </div>

                                        </div>

                                    </div>
                                </div>
                                <div class="card-body border-bottom bg-light">
                                    <form method="GET" action="/smia-ostie/list">

                                        <div class="row g-3">

                                            <div class="col-lg-4">
                                                <label class="form-label">
                                                    Employee Search
                                                </label>

                                                <input type="text" name="search" class="form-control"
                                                    placeholder="Employee ID, employee name..." value="<%= search %>">
                                            </div>

                                            <div class="col-lg-3">
                                                <label class="form-label">
                                                    Start Date
                                                </label>

                                                <input type="date" name="startDate" class="form-control"
                                                    value="<%= startDate %>">
                                            </div>

                                            <div class="col-lg-3">
                                                <label class="form-label">
                                                    End Date
                                                </label>

                                                <input type="date" name="endDate" class="form-control"
                                                    value="<%= endDate %>">
                                            </div>

                                            <div class="col-lg-2 d-flex align-items-end">

                                                <div class="d-grid gap-2 w-100">

                                                    <button type="submit" class="btn btn-primary">

                                                        <i class="feather-search me-2"></i>
                                                        Search

                                                    </button>

                                                </div>

                                            </div>

                                        </div>

                                        <div class="mt-3">

                                            <a href="/smia-ostie/list" class="btn btn-light">

                                                <i class="feather-rotate-ccw me-2"></i>
                                                Reset Filters

                                            </a>

                                        </div>

                                    </form>
                                </div>
                                <!-- <div class="card-header bg-transparent border-bottom">

                                    <div class="d-flex justify-content-between align-items-center">

                                        <div>
                                            <h5 class="mb-0">
                                                Consultation Records
                                            </h5>

                                            <small class="text-muted">
                                                <%= total %> consultation(s) found
                                            </small>
                                        </div>

                                    </div> -->

                                <!-- </div> -->

                                <div class="card-body p-0">

                                    <div class="table-responsive">

                                        <table class="table table-hover align-middle mb-0">

                                            <thead class="table-light">

                                                <tr>
                                                    <th>Employee ID</th>
                                                    <th>Employee</th>
                                                    <th>Date</th>
                                                    <th>Reason</th>
                                                    <th>Status</th>
                                                </tr>

                                            </thead>

                                            <tbody>

                                                <% data.forEach(d=> { %>

                                                    <tr>

                                                        <td>
                                                            <span class="fw-semibold">
                                                                <%= d.employee.matricule %>
                                                            </span>
                                                        </td>

                                                        <td>
                                                            <div class="fw-semibold">
                                                                <%= d.employee.name %>
                                                                    <%= d.employee.firstname %>
                                                            </div>
                                                        </td>

                                                        <td>
                                                            <%= d.date.toLocaleDateString('en-GB',{ weekday:'short',
                                                                year:'numeric', month:'short', day:'numeric' }) %>
                                                        </td>

                                                        <td>
                                                            <%= d.reason %>
                                                        </td>

                                                        <td>

                                                            <% if(d.status==="normal" ){ %>

                                                                <span class="badge bg-soft-primary text-primary">
                                                                    Normal
                                                                </span>

                                                                <% } else { %>

                                                                    <span class="badge bg-soft-danger text-danger">
                                                                        Emergency
                                                                    </span>

                                                                    <% } %>

                                                        </td>

                                                    </tr>

                                                    <% }) %>

                                                        <% if(data.length===0){ %>

                                                            <tr>

                                                                <td colspan="5" class="text-center py-5">

                                                                    <i class="feather-inbox fs-1 text-muted"></i>

                                                                    <div class="mt-2 text-muted">
                                                                        No consultation records found
                                                                    </div>

                                                                </td>

                                                            </tr>

                                                            <% } %>

                                            </tbody>

                                        </table>

                                    </div>

                                </div>

                                <div class="card-footer bg-white">

                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                                        <small class="text-muted">
                                            Total: <strong>
                                                <%= total %>
                                            </strong> record(s)
                                        </small>

                                        <!-- Pagination ici sans modification -->

                                    </div>

                                </div>

                            </div>

                            <!-- Export -->
                            <div class="card border-0 shadow-sm mt-4">

                                <div class="card-body">

                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                                        <div>

                                            <h6 class="mb-1">
                                                Export Data
                                            </h6>

                                            <small class="text-muted">
                                                Download filtered consultation records.
                                            </small>

                                        </div>

                                        <form action="/smia-ostie/export" method="get">

                                            <input type="hidden" name="search" value="<%= search %>">
                                            <input type="hidden" name="startDate" value="<%= startDate %>">
                                            <input type="hidden" name="endDate" value="<%= endDate %>">

                                            <button class="btn btn-success" type="submit">

                                                <i class="feather-download me-2"></i>
                                                Export Excel

                                            </button>

                                        </form>

                                    </div>

                                </div>

                            </div>

                        </div>
                    </div>
                    <%- include('partials/footer.ejs') %>
                </main>
    </body>