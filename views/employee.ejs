<%- include('partials/head.ejs') %>

    <style>
        .modal {
            z-index: 1060 !important;
        }

        .modal-backdrop {
            z-index: 1055 !important;
        }

        .nxl-overlay,
        .offcanvas-backdrop {
            z-index: 1040 !important;
        }

        .nxl-container,
        .nxl-content {
            transform: none !important;
        }

        .modal-backdrop {
            pointer-events: none !important;
        }

        .modal.show .modal-dialog {
            z-index: 100000 !important;
            position: relative;
        }

        .modal {
            position: fixed !important;
        }

        .modal-backdrop.show {
            z-index: 1040 !important;
        }
    </style>

    <body>
        <%- include('partials/sidebar.ejs') %>
            <%- include('partials/header.ejs') %>
                <main class="nxl-container">
                    <div class="nxl-content">
                        <div class="page-header">
                            <div class="page-header-left d-flex align-items-center">
                                <div class="page-header-title">
                                    <h5 class="m-b-10">Be-Leave</h5>
                                </div>
                                <ul class="breadcrumb">
                                    <li class="breadcrumb-item">Employee</li>
                                    <li class="breadcrumb-item">Employee details</li>
                                </ul>
                            </div>
                            <div class="page-header-right ms-auto">
                                <div class="page-header-right-items">
                                    <div class="d-flex d-md-none">
                                        <a href="javascript:void(0)" class="page-header-right-close-toggle">
                                            <i class="feather-arrow-left me-2"></i>
                                            <span>Back</span>
                                        </a>
                                    </div>
                                </div>
                                <div class="d-md-none d-flex align-items-center">
                                    <a href="javascript:void(0)" class="page-header-right-open-toggle">
                                        <i class="feather-align-right fs-20"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <!-- [ page-header ] end -->
                        <div class="bg-white py-3 border-bottom rounded-0 p-md-0 mb-0">
                            <div class="d-md-none d-flex align-items-center justify-content-between">
                                <a href="javascript:void(0)" class="page-content-left-open-toggle">
                                    <i class="feather-align-left fs-20"></i>
                                </a>
                            </div>
                        </div>
                        <!-- [ Main Content ] start -->
                        <div class="container-fluid py-4">

                            <% if (locals.error) { %>
                                <div class="alert alert-danger">
                                    <%= error %>
                                </div>
                                <% } %>

                                    <!-- Header -->
                                    <div class="card shadow-sm border-0 mb-4">
                                        <div class="card-body">
                                            <div
                                                class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">

                                                <div>
                                                    <div class="d-flex">
                                                        <h2 class="mb-1 me-2">
                                                            <%= employee.name %>
                                                                <%= employee.firstname %>
                                                        </h2>
                                                        <div class="p-2">
                                                            <% if(employee.is_active==true) { %>
                                                                <span class="badge bg-success">
                                                                    Active
                                                                </span>
                                                                <% } else { %>
                                                                    <span class="badge bg-danger">
                                                                        Archived
                                                                    </span>
                                                                    <% } %>
                                                        </div>
                                                    </div>

                                                    <div class="d-flex flex-wrap gap-2">
                                                        <span class="badge bg-primary">
                                                            <%= employee.matricule %>
                                                        </span>

                                                        <span class="badge bg-secondary">
                                                            <%= employee.gender %>
                                                        </span>

                                                        <span class="badge bg-info text-dark">
                                                            <% if (employee.job_level !='NULL' ) { %>
                                                                Level <%= employee.job_level.substring(1) %>
                                                                    <% } else { %>
                                                                        <%= employee.job_level %>
                                                                            <% } %>
                                                        </span>
                                                    </div>
                                                </div>

                                                <% if(user.role==='SUPERADMIN' || user.role==='ADMIN' ) { %>
                                                    <div class="d-flex gap-2">
                                                        <a href="/employee/edit/<%= employee.id %>"
                                                            class="btn btn-primary">
                                                            <i class="bi bi-pencil-square me-2"></i>
                                                            Edit
                                                        </a>
                                                        <% if(employee.is_active==true) { %>
                                                            <a href="/employee/confirm-archive/<%= employee.id %>"
                                                                class="btn btn-danger">
                                                                <i class="bi bi-archive me-2"></i>
                                                                Archive
                                                            </a>
                                                            <% } %>
                                                    </div>
                                                    <% } %>

                                            </div>
                                        </div>
                                    </div>

                                    <div class="row g-4">

                                        <!-- Organisation -->
                                        <div class="col-lg-6">
                                            <div class="card shadow-sm h-100">
                                                <div class="card-header bg-primary">
                                                    <h5 class="mb-0 text-white">Organisation</h5>
                                                </div>

                                                <div class="card-body">

                                                    <div class="row gy-3">

                                                        <div class="col-md-6">
                                                            <small class="text-muted">Site</small>
                                                            <div class="fw-semibold">
                                                                <%= employee.site %>
                                                            </div>
                                                        </div>

                                                        <div class="col-md-6">
                                                            <small class="text-muted">Department</small>
                                                            <div class="fw-semibold">
                                                                <%= employee.departement %>
                                                            </div>
                                                        </div>

                                                        <div class="col-md-6">
                                                            <small class="text-muted">Section</small>
                                                            <div class="fw-semibold">
                                                                <%= employee.section %>
                                                            </div>
                                                        </div>

                                                        <div class="col-md-6">
                                                            <small class="text-muted">Division</small>
                                                            <div class="fw-semibold">
                                                                <%= employee.division %>
                                                            </div>
                                                        </div>

                                                        <div class="col-md-6">
                                                            <small class="text-muted">Designation</small>
                                                            <div class="fw-semibold">
                                                                <%= employee.designation %>
                                                            </div>
                                                        </div>

                                                        <div class="col-md-6">
                                                            <small class="text-muted">Line</small>
                                                            <div class="fw-semibold">
                                                                <%= employee.line %>
                                                            </div>
                                                        </div>

                                                    </div>

                                                </div>
                                            </div>
                                        </div>

                                        <!-- RH -->
                                        <div class="col-lg-6">
                                            <div class="card shadow-sm h-100">
                                                <div class="card-header bg-primary">
                                                    <h5 class="mb-0 text-white">HR informations</h5>
                                                </div>

                                                <div class="card-body">

                                                    <div class="row gy-3">

                                                        <div class="col-md-6">
                                                            <small class="text-muted">Type</small>
                                                            <div class="fw-semibold">
                                                                <%= employee.type %>
                                                            </div>
                                                        </div>

                                                        <div class="col-md-6">
                                                            <small class="text-muted">Job Level</small>
                                                            <div class="fw-semibold">
                                                                <%= employee.job_level %>
                                                            </div>
                                                        </div>

                                                        <div class="col-md-6">
                                                            <small class="text-muted">Date of entry</small>
                                                            <div class="fw-semibold">
                                                                <%= new Date(employee.DOE).toLocaleDateString("en-US",{
                                                                    year: "numeric" , month: "short" , day: "numeric" })
                                                                    %>
                                                            </div>
                                                        </div>

                                                        <div class="col-md-6">
                                                            <small class="text-muted">Date of resignation</small>
                                                            <div class="fw-semibold">
                                                                <%= employee.DOR? new
                                                                    Date(employee.DOR).toLocaleDateString("en-US",{
                                                                    year: "numeric" , month: "short" , day: "numeric" })
                                                                    : 'Not specified' %>
                                                            </div>
                                                        </div>

                                                        <div class="col-12">
                                                            <small class="text-muted">Manager</small>

                                                            <div class="border rounded p-3 bg-light">
                                                                <%= employee.manager ? employee.manager.matricule
                                                                    + " - " + employee.manager.firstName + " " +
                                                                    employee.manager.name : "-" %>
                                                            </div>
                                                        </div>

                                                    </div>

                                                </div>
                                            </div>
                                        </div>

                                    </div>

                        </div>
                    </div>
                    <%- include('partials/new-leave-modal-test') %>
                        <%- include('partials/footer.ejs') %>

                            <!-- Archive Modal -->
                            <div class="modal fade" id="archiveModal" tabindex="-1" aria-labelledby="archiveModalLabel"
                                aria-hidden="true" style="z-index: 900000;">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content border-0 shadow">

                                        <div class="modal-header">
                                            <h5 class="modal-title" id="archiveModalLabel">
                                                Archive Employee
                                            </h5>

                                            <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                aria-label="Close">
                                            </button>
                                        </div>

                                        <div class="modal-body text-center py-4">

                                            <div class="mb-3">
                                                <i class="bi bi-exclamation-triangle-fill text-warning fs-1"></i>
                                            </div>

                                            <h5 class="mb-3">
                                                Are you sure?
                                            </h5>

                                            <p class="text-muted mb-0">
                                                You are about to archive
                                                <strong>
                                                    <%= employee.name %>
                                                        <%= employee.firstname %>
                                                </strong>.
                                            </p>

                                            <p class="text-muted">
                                                The employee will no longer appear in active employee lists.
                                            </p>

                                        </div>

                                        <div class="modal-footer">

                                            <button type="button" class="btn btn-outline-secondary"
                                                data-bs-dismiss="modal">
                                                Cancel
                                            </button>

                                            <form action="/employee/archive/<%= employee.id %>" method="POST"
                                                class="d-inline">

                                                <button type="submit" class="btn btn-danger">

                                                    <i class="bi bi-archive me-2"></i>
                                                    Archive Employee

                                                </button>

                                            </form>

                                        </div>

                                    </div>
                                </div>
                            </div>
    </body>

    </html>