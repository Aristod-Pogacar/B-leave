<%- include('partials/head.ejs') %>

    <body>
        <%- include('partials/sidebar.ejs') %>
            <%- include('partials/header.ejs') %>
                <main class="nxl-container">
                    <div class="nxl-content">
                        <div class="page-header">
                            <div class="page-header-left d-flex align-items-center">
                                <div class="page-header-title">
                                    <h5 class="m-b-10">Be-Leave</h5>
                                </div>
                                <ul class="breadcrumb">
                                    <li class="breadcrumb-item">Employee</li>
                                    <li class="breadcrumb-item">My Team</li>
                                </ul>
                            </div>
                            <div class="page-header-right ms-auto">
                                <div class="page-header-right-items">
                                    <div class="d-flex d-md-none">
                                        <a href="javascript:void(0)" class="page-header-right-close-toggle">
                                            <i class="feather-arrow-left me-2"></i>
                                            <span>Back</span>
                                        </a>
                                    </div>
                                </div>
                                <div class="d-md-none d-flex align-items-center">
                                    <a href="javascript:void(0)" class="page-header-right-open-toggle">
                                        <i class="feather-align-right fs-20"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <!-- [ page-header ] end -->
                        <div class="bg-white py-3 border-bottom rounded-0 p-md-0 mb-0">
                            <div class="d-md-none d-flex align-items-center justify-content-between">
                                <a href="javascript:void(0)" class="page-content-left-open-toggle">
                                    <i class="feather-align-left fs-20"></i>
                                </a>
                            </div>
                        </div>
                        <!-- [ Main Content ] start -->
                        <div class="main-content">
                            <div class="tab-content">
                                <div class="tab-pane fade active show" id="overviewTab">
                                    <div class="row">

                                        <div class="col-xl-12">
                                            <div class="card stretch stretch-full d-flex">
                                                <div class="card-header">
                                                    <h4 class="header">My Team</h4>
                                                    <!-- Filtres -->
                                                    <form method="GET" action="/employee/my-team"
                                                        class="d-flex align-items-end gap-3 mt-2 flex-wrap">
                                                        <div>
                                                            <label class="form-label mb-1">Recherche</label>
                                                            <input type="text" name="search" class="form-control"
                                                                placeholder="Matricule, nom..." value="<%= search %>" />
                                                        </div>
                                                        <div class="d-flex gap-2">
                                                            <button type="submit" class="btn btn-primary">
                                                                <i class="feather-search me-1"></i> Filtrer
                                                            </button>
                                                            <a href="/employee/my-team"
                                                                class="btn btn-outline-secondary ms-2">
                                                                <i class="feather-x me-1"></i> Reset
                                                            </a>
                                                        </div>
                                                    </form>
                                                </div>
                                                <div class="card-body">

                                                    <div class="modal-body">
                                                        <div class="row">

                                                            <!-- ===== LEFT: FORM ===== -->
                                                            <div class="col-md-12">
                                                                <div class="row">
                                                                    <div class="col-12">
                                                                        <div class="row">
                                                                            <div class="col-12">
                                                                                <div class="table-responsive overflow-y-auto"
                                                                                    style="max-height: 500px;" id="">
                                                                                    <table
                                                                                        class="table table-sm table-hover table-bordered align-middle"
                                                                                        id="">
                                                                                        <thead
                                                                                            class="table-light z-100 w-100">
                                                                                            <tr>
                                                                                                <th style="width: 10%;">
                                                                                                    Matricule</th>
                                                                                                <th style="width: 30%;">
                                                                                                    Fullname</th>
                                                                                                <th style="width: 10%;">
                                                                                                    Section</th>
                                                                                                <th style="width: 10%;">
                                                                                                    Designation</th>
                                                                                                <th style="width: 30%;">
                                                                                                    Manager</th>
                                                                                            </tr>
                                                                                        </thead>
                                                                                        <tbody
                                                                                            id="assignedEmployeesList"
                                                                                            class="employee-list-body-2">
                                                                                            <% employees.forEach(emp=> {
                                                                                                %>
                                                                                                <tr>
                                                                                                    <td
                                                                                                        style="width: 10%;">
                                                                                                        <%= emp.matricule
                                                                                                            %>
                                                                                                    </td>
                                                                                                    <td
                                                                                                        style="width: 30%;">
                                                                                                        <a
                                                                                                            href="/employee/details/<%= emp.id %>">
                                                                                                            <%= emp.name
                                                                                                                %>
                                                                                                                <%= emp.firstname
                                                                                                                    %>
                                                                                                        </a>
                                                                                                    </td>
                                                                                                    <td
                                                                                                        style="width: 10%;">
                                                                                                        <%= emp.section
                                                                                                            %>
                                                                                                    </td>
                                                                                                    <td
                                                                                                        style="width: 10%;">
                                                                                                        <%= emp.designation
                                                                                                            %>
                                                                                                    </td>
                                                                                                    <td
                                                                                                        style="width: 30%;">
                                                                                                        <%= emp.manager?.firstName
                                                                                                            %>
                                                                                                            <%= emp.manager?.lastName
                                                                                                                %>
                                                                                                    </td>
                                                                                                </tr>
                                                                                                <% }) %>
                                                                                                    <% if
                                                                                                        (employees.length===0)
                                                                                                        { %>
                                                                                                        <tr>
                                                                                                            <td colspan="5"
                                                                                                                class="text-center text-muted py-4">
                                                                                                                Aucun
                                                                                                                résultat
                                                                                                                trouvé.
                                                                                                            </td>
                                                                                                        </tr>
                                                                                                        <% } %>
                                                                                        </tbody>
                                                                                    </table>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>

                                                            </div>

                                                        </div>

                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <%- include('partials/footer.ejs') %>
    </body>

    </html>