<%- include('partials/head.ejs') %>

    <body>
        <%- include('partials/sidebar.ejs') %>
            <%- include('partials/header.ejs') %>

                <main class="nxl-container">
                    <div class="nxl-content">

                        <div class="page-header">
                            <div class="page-header-left d-flex align-items-center">
                                <div class="page-header-title">
                                    <h5 class="m-b-10">Be-Leave</h5>
                                </div>
                                <ul class="breadcrumb">
                                    <li class="breadcrumb-item">Account</li>
                                    <li class="breadcrumb-item">Change password</li>
                                </ul>
                            </div>
                        </div>

                        <div class="container-fluid py-4">

                            <form id="userForm" method="POST" action="/user/save-password">

                                <input type="hidden" name="matricule" value="<%= user.matricule %>">

                                <!-- Header -->
                                <div class="card shadow-sm border-0 mb-4">

                                    <div class="card-body">

                                        <div
                                            class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">

                                            <div class="d-flex align-items-center gap-3">

                                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold"
                                                    style="width:70px;height:70px;font-size:1.5rem;">

                                                    <%= user.firstName.charAt(0).toUpperCase() %>
                                                        <%= user.name.charAt(0).toUpperCase() %>

                                                </div>

                                                <div>

                                                    <h2 class="mb-1">
                                                        Change Password
                                                    </h2>

                                                    <p class="text-muted mb-0">
                                                        Choose a strong and unique password.
                                                    </p>

                                                </div>

                                            </div>

                                            <a href="/user/edit-profil" class="btn btn-outline-secondary">
                                                Back
                                            </a>

                                        </div>

                                    </div>

                                </div>

                                <div class="row g-4">

                                    <!-- Account Information -->
                                    <div class="col-lg-4">

                                        <div class="card shadow-sm border-0 h-100">

                                            <div class="card-header bg-primary">
                                                <h5 class="mb-0 text-white">
                                                    Account Information
                                                </h5>
                                            </div>

                                            <div class="card-body">

                                                <div class="mb-3">

                                                    <label class="form-label text-muted">
                                                        Matricule
                                                    </label>

                                                    <div class="fw-semibold">
                                                        <%= user.matricule %>
                                                    </div>

                                                </div>

                                                <div class="mb-3">

                                                    <label class="form-label text-muted">
                                                        User
                                                    </label>

                                                    <div class="fw-semibold">
                                                        <%= user.firstName %>
                                                            <%= user.name %>
                                                    </div>

                                                </div>

                                                <div>

                                                    <label class="form-label text-muted">
                                                        Role
                                                    </label>

                                                    <div>
                                                        <span class="badge bg-primary">
                                                            <%= user.role %>
                                                        </span>
                                                    </div>

                                                </div>

                                            </div>

                                        </div>

                                    </div>

                                    <!-- Password Security -->
                                    <div class="col-lg-8">

                                        <div class="card shadow-sm border-0">

                                            <div class="card-header bg-primary">
                                                <h5 class="mb-0 text-white">
                                                    Password Security
                                                </h5>
                                            </div>

                                            <div class="card-body">

                                                <div class="row g-3">

                                                    <div class="col-12">

                                                        <label class="form-label">
                                                            Current Password
                                                        </label>

                                                        <div class="input-group">

                                                            <input type="password" class="form-control"
                                                                id="actualPassword" name="actualPassword" required>

                                                            <button type="button" class="btn btn-outline-secondary"
                                                                onclick="togglePassword('actualPassword', this)">

                                                                <i class="feather-eye"></i>

                                                            </button>

                                                        </div>

                                                    </div>

                                                    <div class="col-12">

                                                        <label class="form-label">
                                                            New Password
                                                        </label>

                                                        <div class="input-group">

                                                            <input type="password" class="form-control" id="newPassword"
                                                                name="newPassword" required
                                                                oninput="checkStrength(this.value)">

                                                            <button type="button" class="btn btn-outline-secondary"
                                                                onclick="togglePassword('newPassword', this)">

                                                                <i class="feather-eye"></i>

                                                            </button>

                                                        </div>

                                                        <div id="strengthWrap" class="mt-3" style="display:none;">

                                                            <div class="progress">

                                                                <div id="strengthBar" class="progress-bar"
                                                                    role="progressbar">
                                                                </div>

                                                            </div>

                                                            <small id="strengthLabel" class="text-muted">
                                                            </small>

                                                        </div>

                                                    </div>

                                                    <div class="col-12">

                                                        <label class="form-label">
                                                            Confirm Password
                                                        </label>

                                                        <div class="input-group">

                                                            <input type="password" class="form-control"
                                                                id="confirmPassword" name="confirmPassword" required
                                                                oninput="checkMatch()">

                                                            <button type="button" class="btn btn-outline-secondary"
                                                                onclick="togglePassword('confirmPassword', this)">

                                                                <i class="feather-eye"></i>

                                                            </button>

                                                        </div>

                                                        <small id="matchMsg" class="mt-2 d-block">
                                                        </small>

                                                    </div>

                                                </div>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                                <!-- Footer -->
                                <div class="d-flex justify-content-end gap-2 mt-4">

                                    <a href="/user/edit-profil" class="btn btn-outline-secondary">
                                        Cancel
                                    </a>

                                    <button type="submit" class="btn btn-primary">
                                        Save Changes
                                    </button>

                                </div>

                            </form>

                        </div>

                    </div>
                    <%- include('partials/footer.ejs') %>
                </main>

                <script>
                    function togglePassword(id, btn) {
                        const input = document.getElementById(id);
                        const isText = input.type === 'text';
                        input.type = isText ? 'password' : 'text';
                        btn.innerHTML = isText ? '<i class="feather-eye"></i>' : '<i class="feather-eye-off"></i>';
                    }

                    function checkStrength(val) {
                        const wrap = document.getElementById('strengthWrap');
                        const bar = document.getElementById('strengthBar');
                        const label = document.getElementById('strengthLabel');
                        if (!val) { wrap.style.display = 'none'; return; }
                        wrap.style.display = 'block';
                        let score = 0;
                        if (val.length >= 8) score++;
                        if (/[A-Z]/.test(val)) score++;
                        if (/[0-9]/.test(val)) score++;
                        if (/[^A-Za-z0-9]/.test(val)) score++;
                        const levels = [
                            { pct: '25%', color: '#e24b4a', text: 'Très faible' },
                            { pct: '50%', color: '#ef9f27', text: 'Faible' },
                            { pct: '75%', color: '#1a56db', text: 'Correct' },
                            { pct: '100%', color: '#0e9f6e', text: 'Fort' },
                        ];
                        const l = levels[score - 1] || levels[0];
                        bar.style.width = l.pct;
                        bar.style.background = l.color;
                        label.textContent = l.text;
                        label.style.color = l.color;
                    }

                    function checkMatch() {
                        const np = document.getElementById('newPassword').value;
                        const cp = document.getElementById('confirmPassword').value;
                        const msg = document.getElementById('matchMsg');
                        if (!cp) { msg.style.display = 'none'; return; }
                        msg.style.display = 'block';
                        if (np === cp) {
                            msg.textContent = '✓ Les mots de passe correspondent';
                            msg.style.color = '#0e9f6e';
                        } else {
                            msg.textContent = '✗ Les mots de passe ne correspondent pas';
                            msg.style.color = '#e24b4a';
                        }
                    }
                </script>

    </body>

    </html>