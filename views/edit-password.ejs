<%- include('partials/head.ejs') %>

    <body>
        <%- include('partials/sidebar.ejs') %>
            <%- include('partials/header.ejs') %>

                <main class="nxl-container">
                    <div class="nxl-content">

                        <div class="page-header">
                            <div class="page-header-left d-flex align-items-center">
                                <div class="page-header-title">
                                    <h5 class="m-b-10">Be-Leave</h5>
                                </div>
                                <ul class="breadcrumb">
                                    <li class="breadcrumb-item">Account</li>
                                    <li class="breadcrumb-item">Change password</li>
                                </ul>
                            </div>
                        </div>

                        <div class="main-content py-4">
                            <div class="container-fluid">
                                <div class="row justify-content-center">
                                    <div class="col-12 col-lg-9 col-xl-7">

                                        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

                                            <!-- Banner -->
                                            <div class="position-relative"
                                                style="height:110px; background: linear-gradient(135deg, #1a56db 0%, #0091ff 100%);">
                                                <div class="position-absolute" style="bottom:-40px; left:32px;">
                                                    <div class="d-flex align-items-center justify-content-center rounded-circle border border-4 border-white shadow-sm"
                                                        style="width:80px; height:80px; background:#1a56db; color:#fff; font-size:26px; font-weight:600; letter-spacing:-1px;">
                                                        <%= user.firstName.charAt(0).toUpperCase() %>
                                                            <%= user.name.charAt(0).toUpperCase() %>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Card header -->
                                            <div class="card-body pt-5 pb-3 px-4">
                                                <div class="d-flex align-items-center justify-content-between mt-2">
                                                    <div>
                                                        <h4 class="mb-1 fw-semibold" style="font-size:1.2rem;">Change
                                                            password</h4>
                                                        <p class="mb-0" style="font-size:13px; color:#9ca3af;">
                                                            Choose a strong and unique password</p>
                                                    </div>
                                                    <a href="/user/edit-profil"
                                                        class="btn btn-outline-secondary btn-sm rounded-3 px-3"
                                                        style="font-size:13px;">
                                                        <i class="feather-arrow-left me-1" style="font-size:13px;"></i>
                                                        Back
                                                    </a>
                                                </div>
                                            </div>

                                            <hr class="mx-4 my-0" style="opacity:.08;">

                                            <!-- Form -->
                                            <div class="card-body px-4 py-3">

                                                <!-- Matricule info pill -->
                                                <div class="mb-4 p-3 rounded-3 d-flex align-items-center gap-3"
                                                    style="background:#f9fafb; border:1px solid #f3f4f6;">
                                                    <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
                                                        style="width:36px; height:36px; background:#eff6ff;">
                                                        <i class="feather-tag"
                                                            style="font-size:15px; color:#1a56db;"></i>
                                                    </div>
                                                    <div>
                                                        <p class="mb-0"
                                                            style="font-size:11px; color:#9ca3af; font-weight:500; text-transform:uppercase; letter-spacing:.05em;">
                                                            Matricule</p>
                                                        <p class="mb-0 fw-medium"
                                                            style="font-size:14px; color:#111827;">
                                                            <%= user.matricule %>
                                                        </p>
                                                    </div>
                                                </div>

                                                <p class="text-uppercase mb-3"
                                                    style="font-size:11px; letter-spacing:.07em; color:#9ca3af; font-weight:500;">
                                                    Security
                                                </p>

                                                <form id="userForm" method="POST" action="/user/save-password">
                                                    <input type="hidden" name="matricule" value="<%= user.matricule %>">

                                                    <div class="row g-3">

                                                        <div class="col-12">
                                                            <label class="form-label"
                                                                style="font-size:12px; color:#6b7280; font-weight:500;">Current
                                                                password</label>
                                                            <div class="input-group">
                                                                <input type="password"
                                                                    class="form-control rounded-start-3"
                                                                    id="actualPassword" name="actualPassword"
                                                                    placeholder="Your current password" required
                                                                    style="font-size:14px; border-color:#e5e7eb; border-right:none;">
                                                                <button type="button"
                                                                    class="btn btn-outline-secondary rounded-end-3"
                                                                    style="border-color:#e5e7eb; font-size:13px;"
                                                                    onclick="togglePassword('actualPassword', this)">
                                                                    <i class="feather-eye"></i>
                                                                </button>
                                                            </div>
                                                        </div>

                                                        <div class="col-12">
                                                            <label class="form-label"
                                                                style="font-size:12px; color:#6b7280; font-weight:500;">New
                                                                password</label>
                                                            <div class="input-group">
                                                                <input type="password"
                                                                    class="form-control rounded-start-3"
                                                                    id="newPassword" name="newPassword"
                                                                    placeholder="Your new password" required
                                                                    style="font-size:14px; border-color:#e5e7eb; border-right:none;"
                                                                    oninput="checkStrength(this.value)">
                                                                <button type="button"
                                                                    class="btn btn-outline-secondary rounded-end-3"
                                                                    style="border-color:#e5e7eb; font-size:13px;"
                                                                    onclick="togglePassword('newPassword', this)">
                                                                    <i class="feather-eye"></i>
                                                                </button>
                                                            </div>
                                                            <!-- Password strength bar -->
                                                            <div class="mt-2" id="strengthWrap" style="display:none;">
                                                                <div class="progress rounded-pill"
                                                                    style="height:4px; background:#f3f4f6;">
                                                                    <div id="strengthBar"
                                                                        class="progress-bar rounded-pill"
                                                                        style="width:0%; transition:width .3s;"></div>
                                                                </div>
                                                                <p id="strengthLabel" class="mb-0 mt-1"
                                                                    style="font-size:11px; color:#9ca3af;"></p>
                                                            </div>
                                                        </div>

                                                        <div class="col-12">
                                                            <label class="form-label"
                                                                style="font-size:12px; color:#6b7280; font-weight:500;">Confirm
                                                                password</label>
                                                            <div class="input-group">
                                                                <input type="password"
                                                                    class="form-control rounded-start-3"
                                                                    id="confirmPassword" name="confirmPassword"
                                                                    placeholder="Confirm new password" required
                                                                    style="font-size:14px; border-color:#e5e7eb; border-right:none;"
                                                                    oninput="checkMatch()">
                                                                <button type="button"
                                                                    class="btn btn-outline-secondary rounded-end-3"
                                                                    style="border-color:#e5e7eb; font-size:13px;"
                                                                    onclick="togglePassword('confirmPassword', this)">
                                                                    <i class="feather-eye"></i>
                                                                </button>
                                                            </div>
                                                            <p id="matchMsg" class="mb-0 mt-1"
                                                                style="font-size:11px; display:none;"></p>
                                                        </div>

                                                    </div>
                                                </form>
                                            </div>

                                            <!-- Footer -->
                                            <div
                                                class="card-footer bg-transparent border-0 px-4 pb-4 pt-2 d-flex gap-2 justify-content-end">
                                                <a href="/user/edit-profil"
                                                    class="btn btn-outline-secondary rounded-3 px-4"
                                                    style="font-size:13px;">
                                                    Cancel
                                                </a>
                                                <button type="submit" form="userForm"
                                                    class="btn btn-primary rounded-3 px-4" style="font-size:13px;">
                                                    <i class="feather-save me-1" style="font-size:13px;"></i>
                                                    Save
                                                </button>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                    <%- include('partials/footer.ejs') %>
                </main>

                <script>
                    function togglePassword(id, btn) {
                        const input = document.getElementById(id);
                        const isText = input.type === 'text';
                        input.type = isText ? 'password' : 'text';
                        btn.innerHTML = isText ? '<i class="feather-eye"></i>' : '<i class="feather-eye-off"></i>';
                    }

                    function checkStrength(val) {
                        const wrap = document.getElementById('strengthWrap');
                        const bar = document.getElementById('strengthBar');
                        const label = document.getElementById('strengthLabel');
                        if (!val) { wrap.style.display = 'none'; return; }
                        wrap.style.display = 'block';
                        let score = 0;
                        if (val.length >= 8) score++;
                        if (/[A-Z]/.test(val)) score++;
                        if (/[0-9]/.test(val)) score++;
                        if (/[^A-Za-z0-9]/.test(val)) score++;
                        const levels = [
                            { pct: '25%', color: '#e24b4a', text: 'Très faible' },
                            { pct: '50%', color: '#ef9f27', text: 'Faible' },
                            { pct: '75%', color: '#1a56db', text: 'Correct' },
                            { pct: '100%', color: '#0e9f6e', text: 'Fort' },
                        ];
                        const l = levels[score - 1] || levels[0];
                        bar.style.width = l.pct;
                        bar.style.background = l.color;
                        label.textContent = l.text;
                        label.style.color = l.color;
                    }

                    function checkMatch() {
                        const np = document.getElementById('newPassword').value;
                        const cp = document.getElementById('confirmPassword').value;
                        const msg = document.getElementById('matchMsg');
                        if (!cp) { msg.style.display = 'none'; return; }
                        msg.style.display = 'block';
                        if (np === cp) {
                            msg.textContent = '✓ Les mots de passe correspondent';
                            msg.style.color = '#0e9f6e';
                        } else {
                            msg.textContent = '✗ Les mots de passe ne correspondent pas';
                            msg.style.color = '#e24b4a';
                        }
                    }
                </script>

    </body>

    </html>