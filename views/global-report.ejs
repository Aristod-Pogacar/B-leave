<%- include('partials/head.ejs') %>

    <style>
        .app-password {
            font-size: 2rem;
            letter-spacing: 0.5rem;
            font-family: monospace;
            font-weight: 600;
            text-align: center;
            padding: 1rem;
            border: 2px solid #000000;
            border-radius: 6px;
            background: #ffffff;
            color: #000000;
            user-select: none;
        }
    </style>
    <style>
        /* =========================================
   App Password - Code de sécurité
   ========================================= */

        .app-password-container {
            position: relative;
        }

        .app-password-input {
            height: 70px;
            font-size: 36px;
            font-weight: 700;
            letter-spacing: 12px;
            text-align: center;
            color: #212529;
            background-color: #f8f9fa;
            border: 2px solid #ffc107;
            border-radius: 10px;
            padding-left: 18px;
            cursor: default;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }

        .app-password-input:focus {
            background-color: #fff;
            border-color: #ffc107;
            box-shadow: 0 0 0 0.2rem rgba(255, 193, 7, 0.20);
            outline: none;
        }

        .app-password-label {
            font-weight: 600;
        }

        .app-password-warning {
            font-size: 13px;
            line-height: 1.4;
            border-radius: 8px;
        }

        .app-password-warning strong {
            font-weight: 700;
        }
    </style>

    <body>
        <%- include('partials/sidebar.ejs') %>
            <%- include('partials/header.ejs') %>
                <main class="nxl-container">
                    <div class="nxl-content">
                        <div class="page-header">
                            <div class="page-header-left d-flex align-items-center">
                                <div class="page-header-title">
                                    <h5 class="m-b-10">B-Leave</h5>
                                </div>
                                <ul class="breadcrumb">
                                    <li class="breadcrumb-item">Employee</li>
                                    <li class="breadcrumb-item">New employee</li>
                                </ul>
                            </div>
                            <div class="page-header-right ms-auto">
                                <div class="page-header-right-items">
                                    <div class="d-flex d-md-none">
                                        <a href="javascript:void(0)" class="page-header-right-close-toggle">
                                            <i class="feather-arrow-left me-2"></i>
                                            <span>Back</span>
                                        </a>
                                    </div>
                                </div>
                                <div class="d-md-none d-flex align-items-center">
                                    <a href="javascript:void(0)" class="page-header-right-open-toggle">
                                        <i class="feather-align-right fs-20"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <!-- [ page-header ] end -->
                        <div class="bg-white py-3 border-bottom rounded-0 p-md-0 mb-0">
                            <div class="d-md-none d-flex align-items-center justify-content-between">
                                <a href="javascript:void(0)" class="page-content-left-open-toggle">
                                    <i class="feather-align-left fs-20"></i>
                                </a>
                            </div>
                        </div>
                        <!-- [ Main Content ] start -->
                        <div class="main-content py-4">
                            <div class="container-fluid">


                                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                                    <div class="card-body border-bottom border-1">
                                        <div
                                            class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">

                                            <div>
                                                <h3 class="fw-bold mb-1">
                                                    Global report
                                                </h3>

                                                <p class="text-muted mb-0">
                                                    Download global report for IE.
                                                </p>
                                            </div>

                                            <div class="d-flex gap-2">

                                                <div class="rounded-circle d-flex align-items-center justify-content-center"
                                                    style="width:64px;height:64px;">
                                                    <i class="bi bi-files fs-3"></i>
                                                </div>

                                            </div>

                                        </div>
                                    </div>

                                    <div class="card-body p-4">

                                        <form id="userForm" method="POST" action="/leave/global-report">

                                            <!-- Personal Information -->
                                            <div class="mb-4">
                                                <h5 class="fw-semibold mb-3">
                                                    <i class="bi bi-person me-2 text-primary"></i>
                                                    Report date
                                                </h5>

                                                <div class="row g-3">

                                                    <div class="col-lg-2">
                                                        <label class="form-label fw-medium">
                                                            Start date
                                                        </label>
                                                        <input type="date" class="form-control" id="startDate"
                                                            name="startDate" required>
                                                    </div>

                                                    <div class="col-lg-4">
                                                        <label class="form-label fw-medium">
                                                            End date
                                                        </label>
                                                        <input type="date" class="form-control" id="endDate"
                                                            name="endDate" required>
                                                    </div>

                                                </div>
                                            </div>

                                        </form>

                                    </div>

                                    <div class="card-footer bg-light border-0 p-4">
                                        <div class="d-flex justify-content-end gap-2">

                                            <button type="submit" form="userForm" class="btn btn-primary px-4"
                                                id="submit">
                                                <i class="bi bi-download me-2"></i>
                                                Download
                                            </button>

                                        </div>
                                    </div>

                                </div>

                            </div>
                        </div>
                    </div>
                    <%- include('partials/new-leave-modal-test') %>
                        <%- include('partials/footer.ejs') %>
    </body>

    </html>