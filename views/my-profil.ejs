<%- include('partials/head.ejs') %>

    <body>
        <%- include('partials/sidebar.ejs') %>
            <%- include('partials/header.ejs') %>

                <main class="nxl-container">
                    <div class="nxl-content">

                        <!-- Page header -->
                        <div class="page-header">
                            <div class="page-header-left d-flex align-items-center">
                                <div class="page-header-title">
                                    <h5 class="m-b-10">B-Leave</h5>
                                </div>
                                <ul class="breadcrumb">
                                    <li class="breadcrumb-item">Account</li>
                                    <li class="breadcrumb-item">My profile</li>
                                </ul>
                            </div>
                        </div>

                        <!-- Main content -->
                        <div class="container-fluid py-4">

                            <!-- Header -->
                            <div class="card shadow-sm border-0 mb-4">
                                <div class="card-body">

                                    <div
                                        class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">

                                        <div class="d-flex align-items-center gap-3">

                                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold"
                                                style="width:70px;height:70px;font-size:1.5rem;">

                                                <%= user.employee?.firstname.charAt(0).toUpperCase() %>
                                                    <%= user.employee?.name.charAt(0).toUpperCase() %>

                                            </div>

                                            <div>
                                                <h2 class="mb-1">
                                                    <%= user.employee?.firstname %>
                                                        <%= user.employee?.name %>
                                                </h2>

                                                <div class="d-flex flex-wrap gap-2">

                                                    <span class="badge bg-primary">
                                                        <%= user.role %>
                                                    </span>

                                                    <span class="badge bg-secondary">
                                                        <%= user.site %>
                                                    </span>

                                                </div>
                                            </div>

                                        </div>

                                        <a href="/user/edit-profil" class="btn btn-primary">
                                            Edit Profile
                                        </a>

                                    </div>

                                </div>
                            </div>

                            <div class="row g-4">

                                <!-- Informations personnelles -->
                                <div class="col-lg-6">

                                    <div class="card shadow-sm border-0 h-100">

                                        <div class="card-header bg-primary">
                                            <h5 class="mb-0 text-white">
                                                Personal informations
                                            </h5>
                                        </div>

                                        <div class="card-body">

                                            <div class="row g-3">

                                                <div class="col-12">
                                                    <label class="form-label text-muted">
                                                        Full name
                                                    </label>

                                                    <div class="fw-semibold">
                                                        <%= user.employee?.firstname %>
                                                            <%= user.employee?.name %>
                                                    </div>
                                                </div>

                                                <div class="col-12">
                                                    <label class="form-label text-muted">
                                                        Phone
                                                    </label>

                                                    <div class="fw-semibold">
                                                        <%= user.phone || '-' %>
                                                    </div>
                                                </div>

                                                <div class="col-12">
                                                    <label class="form-label text-muted">
                                                        Email
                                                    </label>

                                                    <div class="fw-semibold">
                                                        <%= user.email %>
                                                    </div>
                                                </div>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                                <!-- Compte -->
                                <div class="col-lg-6">

                                    <div class="card shadow-sm border-0 h-100">

                                        <div class="card-header bg-primary">
                                            <h5 class="mb-0 text-white">
                                                Account informations
                                            </h5>
                                        </div>

                                        <div class="card-body">

                                            <div class="row g-3">

                                                <div class="col-12">
                                                    <label class="form-label text-muted">
                                                        Role
                                                    </label>

                                                    <div>
                                                        <span class="badge bg-primary">
                                                            <%= user.role %>
                                                        </span>
                                                    </div>
                                                </div>

                                                <div class="col-12">
                                                    <label class="form-label text-muted">
                                                        Site
                                                    </label>

                                                    <div class="fw-semibold">
                                                        <%= user.site %>
                                                    </div>
                                                </div>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                    <%- include('partials/new-leave-modal-test') %>
                        <%- include('partials/footer.ejs') %>
                </main>

    </body>

    </html>