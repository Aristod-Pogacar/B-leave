<%- include('partials/head.ejs') %>

    <body>
        <%- include('partials/sidebar.ejs') %>
            <%- include('partials/header.ejs') %>
                <main class="nxl-container">
                    <div class="nxl-content">
                        <div class="page-header">
                            <div class="page-header-left d-flex align-items-center">
                                <div class="page-header-title">
                                    <h5 class="m-b-10">B-Leave</h5>
                                </div>
                                <ul class="breadcrumb">
                                    <li class="breadcrumb-item">Employee</li>
                                    <li class="breadcrumb-item">List</li>
                                </ul>
                            </div>
                        </div>

                        <div class="main-content">
                            <div class="tab-content">
                                <div class="tab-pane fade active show" id="overviewTab">
                                    <div class="row">
                                        <div class="col-12">
                                            <div class="card stretch stretch-full">
                                                <div class="card-body border-bottom">
                                                    <div
                                                        class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                                                        <div class="d-flex align-items-center">
                                                            <div class="avatar-text avatar-lg bg-soft-primary me-3">
                                                                <i class="feather-users"></i>
                                                            </div>

                                                            <div>
                                                                <h4 class="mb-1">Employee Directory</h4>
                                                                <p class="text-muted mb-0">
                                                                    Browse and search employee information.
                                                                </p>
                                                            </div>
                                                        </div>

                                                        <div>
                                                            <span class="badge bg-soft-primary text-primary">
                                                                <%= total %> Employees
                                                            </span>
                                                        </div>

                                                    </div>
                                                </div>
                                                <div class="card-body border-bottom bg-light">
                                                    <form method="GET" action="/employee/list">

                                                        <div class="row g-3 align-items-end">

                                                            <div class="col-md-6">
                                                                <label class="form-label">
                                                                    Search Employee
                                                                </label>

                                                                <div class="input-group">

                                                                    <span class="input-group-text">
                                                                        <i class="feather-search"></i>
                                                                    </span>

                                                                    <input type="text" name="search"
                                                                        class="form-control"
                                                                        placeholder="Matricule, name, firstname..."
                                                                        value="<%= search %>">
                                                                </div>
                                                            </div>

                                                            <div class="col-md-6">
                                                                <div class="d-flex gap-2">

                                                                    <button type="submit" class="btn btn-primary">

                                                                        <i class="feather-search me-2"></i>
                                                                        Search
                                                                    </button>

                                                                    <a href="/employee/list" class="btn btn-light">

                                                                        Reset
                                                                    </a>

                                                                </div>
                                                            </div>

                                                        </div>

                                                    </form>
                                                </div>
                                                <div class="card-body custom-card-action p-0">
                                                    <div class="table-responsive mb-3">
                                                        <table class="table table-hover align-middle mb-0">
                                                            <thead>
                                                                <tr>
                                                                    <th style="width: 50%;">Fullname</th>
                                                                    <th style="width: 10%;" class="text-center">Section
                                                                    </th>
                                                                    <th style="width: 10%;" class="text-center">
                                                                        Designation</th>
                                                                    <th style="width: 30%;">Manager</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <% data.forEach(employee=> { %>
                                                                    <tr>
                                                                        <td>
                                                                            <a href="/employee/details/<%= employee.id %>"
                                                                                class="text-decoration-none">

                                                                                <div class="d-flex align-items-center">

                                                                                    <div
                                                                                        class="avatar-text avatar-md bg-soft-primary me-3">
                                                                                        <%= employee.firstname?.charAt(0)
                                                                                            || employee.name.charAt(0)
                                                                                            %>
                                                                                    </div>

                                                                                    <div>

                                                                                        <div
                                                                                            class="fw-semibold text-dark">
                                                                                            <%= employee.name %>
                                                                                                <%= employee.firstname
                                                                                                    %>
                                                                                        </div>

                                                                                        <small class="text-muted">
                                                                                            <%= employee.matricule %>
                                                                                        </small>

                                                                                    </div>

                                                                                </div>

                                                                            </a>
                                                                        </td>
                                                                        <td style="width: 10%;" class="text-center">
                                                                            <span
                                                                                class="badge bg-soft-primary text-primary">
                                                                                <%= employee.section || '-' %>
                                                                            </span>
                                                                        </td>
                                                                        <td style="width: 10%;" class="text-center">
                                                                            <span
                                                                                class="badge bg-soft-success text-success">
                                                                                <%= employee.designation || '-' %>
                                                                            </span>
                                                                        </td>
                                                                        <td style="width: 30%;">
                                                                            <% if(employee.manager) { %>

                                                                                <div class="d-flex align-items-center">

                                                                                    <div
                                                                                        class="avatar-text avatar-sm bg-soft-warning me-2">
                                                                                        <%= employee.manager.firstName.charAt(0)
                                                                                            %>
                                                                                    </div>

                                                                                    <div>
                                                                                        <%= employee.manager.firstName
                                                                                            %>
                                                                                            <%= employee.manager.lastName
                                                                                                %>
                                                                                    </div>

                                                                                </div>

                                                                                <% } else { %>

                                                                                    <span class="text-muted">
                                                                                        Not assigned
                                                                                    </span>

                                                                                    <% } %>
                                                                        </td>
                                                                    </tr>
                                                                    <% }) %>
                                                                        <% if (data.length===0) { %>
                                                                            <tr>
                                                                                <td colspan="5"
                                                                                    class="text-center text-muted py-4">
                                                                                    Aucun résultat trouvé.</td>
                                                                            </tr>
                                                                            <% } %>
                                                            </tbody>
                                                        </table>
                                                    </div>

                                                    <!-- Pagination -->
                                                    <div class="d-flex align-items-center
            justify-content-between
            px-4 py-3
            border-top">
                                                        <small class="text-muted">
                                                            Showing
                                                            <strong>
                                                                <%= data.length %>
                                                            </strong>
                                                            of
                                                            <strong>
                                                                <%= total %>
                                                            </strong>
                                                            employees
                                                        </small>
                                                        <% if (totalPages> 1) { %>
                                                            <ul class="pagination mb-0">

                                                                <!-- Précédent -->
                                                                <li
                                                                    class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                                                                    <a class="page-link"
                                                                        href="?page=<%= currentPage - 1 %>&search=<%= search %>&startDate=<%= startDate %>&endDate=<%= endDate %>">
                                                                        <i class="feather-chevron-left"></i>
                                                                    </a>
                                                                </li>

                                                                <!-- Première page si hors plage -->
                                                                <% if (startPage> 1) { %>
                                                                    <li class="page-item">
                                                                        <a class="page-link"
                                                                            href="?page=1&search=<%= search %>&startDate=<%= startDate %>&endDate=<%= endDate %>">1</a>
                                                                    </li>
                                                                    <% if (startPage> 2) { %>
                                                                        <li class="page-item disabled"><span
                                                                                class="page-link">…</span></li>
                                                                        <% } %>
                                                                            <% } %>

                                                                                <!-- Pages numérotées -->
                                                                                <% for (let i=startPage; i <=endPage;
                                                                                    i++) { %>
                                                                                    <li
                                                                                        class="page-item <%= i === currentPage ? 'active' : '' %>">
                                                                                        <a class="page-link"
                                                                                            href="?page=<%= i %>&search=<%= search %>&startDate=<%= startDate %>&endDate=<%= endDate %>">
                                                                                            <%= i %>
                                                                                        </a>
                                                                                    </li>
                                                                                    <% } %>

                                                                                        <!-- Dernière page si hors plage -->
                                                                                        <% if (endPage < totalPages) {
                                                                                            %>
                                                                                            <% if (endPage < totalPages
                                                                                                - 1) { %>
                                                                                                <li
                                                                                                    class="page-item disabled">
                                                                                                    <span
                                                                                                        class="page-link">…</span>
                                                                                                </li>
                                                                                                <% } %>
                                                                                                    <li
                                                                                                        class="page-item">
                                                                                                        <a class="page-link"
                                                                                                            href="?page=<%= totalPages %>&search=<%= search %>&startDate=<%= startDate %>&endDate=<%= endDate %>">
                                                                                                            <%= totalPages
                                                                                                                %>
                                                                                                        </a>
                                                                                                    </li>
                                                                                                    <% } %>

                                                                                                        <!-- Suivant -->
                                                                                                        <li
                                                                                                            class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                                                                                                            <a class="page-link"
                                                                                                                href="?page=<%= currentPage + 1 %>&search=<%= search %>&startDate=<%= startDate %>&endDate=<%= endDate %>">
                                                                                                                <i
                                                                                                                    class="feather-chevron-right"></i>
                                                                                                            </a>
                                                                                                        </li>

                                                            </ul>
                                                            <% } %>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <%- include('partials/footer.ejs') %>
                </main>
    </body>