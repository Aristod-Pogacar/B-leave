<%- include('partials/head.ejs') %>

    <body>
        <%- include('partials/sidebar.ejs') %>
            <%- include('partials/header.ejs') %>
                <main class="nxl-container">
                    <div class="nxl-content">
                        <div class="page-header">
                            <div class="page-header-left d-flex align-items-center">
                                <div class="page-header-title">
                                    <h5 class="m-b-10">Be-Leave</h5>
                                </div>
                                <ul class="breadcrumb">
                                    <li class="breadcrumb-item">Leaves</li>
                                    <li class="breadcrumb-item">Simulate leave</li>
                                </ul>
                            </div>
                            <div class="page-header-right ms-auto">
                                <div class="page-header-right-items">
                                    <div class="d-flex d-md-none">
                                        <a href="javascript:void(0)" class="page-header-right-close-toggle">
                                            <i class="feather-arrow-left me-2"></i>
                                            <span>Back</span>
                                        </a>
                                    </div>
                                </div>
                                <div class="d-md-none d-flex align-items-center">
                                    <a href="javascript:void(0)" class="page-header-right-open-toggle">
                                        <i class="feather-align-right fs-20"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <!-- [ page-header ] end -->
                        <div class="bg-white py-3 border-bottom rounded-0 p-md-0 mb-0">
                            <div class="d-md-none d-flex align-items-center justify-content-between">
                                <a href="javascript:void(0)" class="page-content-left-open-toggle">
                                    <i class="feather-align-left fs-20"></i>
                                </a>
                            </div>
                        </div>
                        <!-- [ Main Content ] start -->
                        <div class="main-content">
                            <div class="tab-content">

                                <div class="tab-pane fade active show" id="overviewTab">

                                    <div class="card shadow-sm border-0">

                                        <div class="card-header">
                                            <h4 class="mb-0">
                                                Simulate Leave
                                            </h4>
                                        </div>

                                        <div class="card-body">

                                            <div class="d-none" role="alert" id="message1"></div>

                                            <div class="row g-4">

                                                <!-- Simulation Form -->
                                                <div class="col-lg-4">

                                                    <div class="card border-0 bg-light h-100">

                                                        <div class="card-header">
                                                            <h5 class="mb-0">
                                                                Simulation Parameters
                                                            </h5>
                                                        </div>

                                                        <div class="card-body">

                                                            <!-- Employee -->
                                                            <div class="mb-3">
                                                                <label class="form-label">
                                                                    Employee
                                                                </label>

                                                                <input type="text" class="form-control"
                                                                    id="employeeSearch1" autocomplete="off"
                                                                    placeholder="Search an employee..." required>

                                                                <input type="text" class="input" name="employee"
                                                                    id="employee1" hidden required>

                                                                <input type="text" class="input" name="matricule"
                                                                    id="matricule1" hidden required>

                                                                <ul id="employeeResults1"
                                                                    class="autocomplete-list ps-0 mt-2">
                                                                </ul>
                                                            </div>

                                                            <!-- Hidden Leave Type -->
                                                            <div class="mb-3 d-none">
                                                                <label class="form-label">
                                                                    Leave Type
                                                                </label>

                                                                <select class="form-select" name="leave_type"
                                                                    id="leave_type">

                                                                    <option value="Local_Leave_AMD" selected>

                                                                        Local Leave

                                                                    </option>

                                                                </select>
                                                            </div>

                                                            <div class="row g-3">

                                                                <div class="col-md-12">
                                                                    <label class="form-label">
                                                                        Simulation Date
                                                                    </label>

                                                                    <input type="date" class="form-control"
                                                                        name="simulate_date" id="simulate_date"
                                                                        required>
                                                                </div>

                                                                <div class="col-md-6">
                                                                    <label class="form-label">
                                                                        Days Taken
                                                                    </label>

                                                                    <input type="number" name="days_taken" value="1"
                                                                        min="0" max="30" id="days_taken"
                                                                        class="form-control" required>
                                                                </div>

                                                                <div class="col-md-6">
                                                                    <label class="form-label">
                                                                        Balance Type
                                                                    </label>

                                                                    <select name="balance_type" id="balance_type"
                                                                        class="form-select" required>

                                                                        <option value="Daily" selected>
                                                                            Daily
                                                                        </option>

                                                                        <option value="Monthly">
                                                                            Monthly
                                                                        </option>

                                                                    </select>
                                                                </div>

                                                                <!-- Hidden but required by JS -->
                                                                <div class="col-md-12 p-4 row d-none">
                                                                    <button type="button" class="btn btn-primary mt-2"
                                                                        id="simulateButton">

                                                                        Simulate

                                                                    </button>
                                                                </div>

                                                            </div>

                                                            <!-- Hidden dates required by JS -->
                                                            <div class="row d-none">

                                                                <div class="col-md-6">

                                                                    <label class="form-label">
                                                                        Starting Date
                                                                    </label>

                                                                    <input type="date" class="form-control"
                                                                        name="start_date" id="startDate1">

                                                                </div>

                                                                <div class="col-md-6">

                                                                    <label class="form-label">
                                                                        Ending Date
                                                                    </label>

                                                                    <input type="date" class="form-control"
                                                                        name="end_date" id="endDate1">

                                                                </div>

                                                            </div>

                                                            <!-- Hidden remarks -->
                                                            <div class="mb-3 d-none">

                                                                <label class="form-label">
                                                                    Remarks
                                                                </label>

                                                                <textarea class="form-control" name="reason1"
                                                                    rows="3"></textarea>

                                                            </div>

                                                        </div>

                                                    </div>

                                                </div>

                                                <!-- Results -->
                                                <div class="col-lg-8">

                                                    <div class="row g-4">

                                                        <!-- Current Balance -->
                                                        <div class="col-md-6">

                                                            <div class="card shadow-sm border-0 h-100">

                                                                <div class="card-header bg-light">
                                                                    <h5 class="mb-0">
                                                                        Current Leave Balance
                                                                    </h5>
                                                                </div>

                                                                <div class="card-body">

                                                                    <div
                                                                        class="d-flex justify-content-between py-2 border-bottom">
                                                                        <span>Carried Forward</span>
                                                                        <strong id="soldeDebut1">-</strong>
                                                                    </div>

                                                                    <div class="d-flex justify-content-between py-2 border-bottom"
                                                                        name="entitlement-day">

                                                                        <span>Entitlement To Date</span>
                                                                        <strong id="soldeCumule1">-</strong>

                                                                    </div>

                                                                    <div class="d-flex justify-content-between py-2 border-bottom d-none"
                                                                        name="entitlement-month">

                                                                        <span>Entitlement To Date</span>
                                                                        <strong id="soldeCumuleMensuel1">-</strong>

                                                                    </div>

                                                                    <div
                                                                        class="d-flex justify-content-between py-2 border-bottom">
                                                                        <span>Taken Permissions</span>
                                                                        <strong id="soldePermissions1">-</strong>
                                                                    </div>

                                                                    <div
                                                                        class="d-flex justify-content-between py-2 border-bottom">
                                                                        <span>Taken Leaves</span>
                                                                        <strong id="soldePris1">-</strong>
                                                                    </div>

                                                                    <div class="d-flex justify-content-between pt-3"
                                                                        name="entitlement-day">

                                                                        <span class="fw-semibold">
                                                                            Current Balance
                                                                        </span>

                                                                        <span id="soldeRestant1"
                                                                            class="badge bg-primary">

                                                                            -

                                                                        </span>

                                                                    </div>

                                                                    <div class="d-flex justify-content-between pt-3 d-none"
                                                                        name="entitlement-month">

                                                                        <span class="fw-semibold">
                                                                            Current Balance
                                                                        </span>

                                                                        <span id="soldeRestantMensuel1"
                                                                            class="badge bg-primary">

                                                                            -

                                                                        </span>

                                                                    </div>

                                                                </div>

                                                            </div>

                                                        </div>

                                                        <!-- Simulated Balance -->
                                                        <div class="col-md-6">

                                                            <div class="card shadow-sm border-0 h-100">

                                                                <div class="card-header bg-success text-white">
                                                                    <h5 class="mb-0">
                                                                        Simulated Leave Balance
                                                                    </h5>
                                                                </div>

                                                                <div class="card-body">

                                                                    <div
                                                                        class="d-flex justify-content-between py-2 border-bottom">
                                                                        <span>Carried Forward</span>
                                                                        <strong id="soldeDebut2">-</strong>
                                                                    </div>

                                                                    <div class="d-flex justify-content-between py-2 border-bottom"
                                                                        name="entitlement-day">

                                                                        <span>Entitlement To Date</span>
                                                                        <strong id="soldeCumule2">-</strong>

                                                                    </div>

                                                                    <div class="d-flex justify-content-between py-2 border-bottom d-none"
                                                                        name="entitlement-month">

                                                                        <span>Entitlement To Date</span>
                                                                        <strong id="soldeCumuleMensuel2">-</strong>

                                                                    </div>

                                                                    <div
                                                                        class="d-flex justify-content-between py-2 border-bottom">
                                                                        <span>Taken Permissions</span>
                                                                        <strong id="soldePermissions2">-</strong>
                                                                    </div>

                                                                    <div
                                                                        class="d-flex justify-content-between py-2 border-bottom">
                                                                        <span>Taken Leaves</span>
                                                                        <strong id="soldePris2">-</strong>
                                                                    </div>

                                                                    <div class="d-flex justify-content-between pt-3"
                                                                        name="entitlement-day">

                                                                        <span class="fw-semibold">
                                                                            Simulated Balance
                                                                        </span>

                                                                        <span id="soldeRestant2"
                                                                            class="badge bg-success">

                                                                            -

                                                                        </span>

                                                                    </div>

                                                                    <div class="d-flex justify-content-between pt-3 d-none"
                                                                        name="entitlement-month">

                                                                        <span class="fw-semibold">
                                                                            Simulated Balance
                                                                        </span>

                                                                        <span id="soldeRestantMensuel2"
                                                                            class="badge bg-success">

                                                                            -

                                                                        </span>

                                                                    </div>

                                                                    <% if (user.role==='TEST' ) { %>

                                                                        <hr>

                                                                        <div class="d-grid">

                                                                            <button type="submit" form="formSimulation"
                                                                                class="btn btn-success" disabled
                                                                                id="submit1">

                                                                                Planify

                                                                            </button>

                                                                        </div>

                                                                        <% } %>

                                                                </div>

                                                            </div>

                                                        </div>

                                                    </div>

                                                    <div class="mt-4">

                                                        <div id="message1" class="text-center fw-semibold">
                                                        </div>

                                                    </div>

                                                </div>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>
                        </div>
                    </div>
                    <%- include('partials/footer.ejs') %>
    </body>

    <%- include('partials/script-simulate-2.ejs') %>

        </html>