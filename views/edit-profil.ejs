<%- include('partials/head.ejs') %>

    <body>
        <%- include('partials/sidebar.ejs') %>
            <%- include('partials/header.ejs') %>

                <main class="nxl-container">
                    <div class="nxl-content">

                        <div class="page-header">
                            <div class="page-header-left d-flex align-items-center">
                                <div class="page-header-title">
                                    <h5 class="m-b-10">Be-Leave</h5>
                                </div>
                                <ul class="breadcrumb">
                                    <li class="breadcrumb-item">Account</li>
                                    <li class="breadcrumb-item">Edit profile</li>
                                </ul>
                            </div>
                        </div>

                        <div class="container-fluid py-4">

                            <form id="userForm" method="POST" action="/user/save-profile">

                                <!-- Header -->
                                <div class="card shadow-sm border-0 mb-4">
                                    <div class="card-body">

                                        <div
                                            class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">

                                            <div class="d-flex align-items-center gap-3">

                                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold"
                                                    style="width:70px;height:70px;font-size:1.5rem;">
                                                    <%= user.employee?.firstname.charAt(0).toUpperCase() %>
                                                        <%= user.employee?.name.charAt(0).toUpperCase() %>
                                                </div>

                                                <div>
                                                    <h2 class="mb-1">
                                                        <%= user.employee?.firstname %>
                                                            <%= user.employee?.name %>
                                                    </h2>

                                                    <div class="d-flex flex-wrap gap-2">

                                                        <span class="badge bg-primary">
                                                            <%= user.role %>
                                                        </span>

                                                        <span class="badge bg-secondary">
                                                            <%= user.site %>
                                                        </span>

                                                    </div>
                                                </div>

                                            </div>

                                            <a href="/user/edit-password" class="btn btn-outline-secondary">
                                                Edit password
                                            </a>

                                        </div>

                                    </div>
                                </div>

                                <div class="row g-4">

                                    <!-- Informations personnelles -->
                                    <div class="col-lg-6">

                                        <div class="card shadow-sm border-0 h-100">

                                            <div class="card-header bg-primary">
                                                <h5 class="mb-0 text-white">
                                                    Personal informations
                                                </h5>
                                            </div>

                                            <div class="card-body">

                                                <div class="row g-3">

                                                    <div class="col-md-12">
                                                        <label class="form-label">
                                                            Employee ID
                                                        </label>

                                                        <input type="text" class="form-control" name="matricule"
                                                            value="<%= user.employee?.matricule %> - <%= user.employee?.name %> <%= user.employee?.firstname %>"
                                                            disabled>
                                                    </div>

                                                    <div class="col-md-12">
                                                        <label class="form-label">
                                                            Email
                                                        </label>

                                                        <input type="email" class="form-control" name="email"
                                                            value="<%= user.email %>" required>
                                                    </div>

                                                    <div class="col-md-12">
                                                        <label class="form-label">
                                                            Phone
                                                        </label>

                                                        <input type="text" class="form-control" name="phone"
                                                            value="<%= user.phone %>" required>
                                                    </div>

                                                </div>

                                            </div>

                                        </div>

                                    </div>

                                    <!-- Compte -->
                                    <div class="col-lg-6">

                                        <div class="card shadow-sm border-0 h-100">

                                            <div class="card-header bg-primary">
                                                <h5 class="mb-0 text-white">
                                                    Account informations
                                                </h5>
                                            </div>

                                            <div class="card-body">

                                                <div class="row g-3">

                                                    <div class="col-md-12">
                                                        <label class="form-label">
                                                            Role
                                                        </label>

                                                        <input type="text" class="form-control" value="<%= user.role %>"
                                                            readonly>
                                                    </div>

                                                    <div class="col-md-12">
                                                        <label class="form-label">
                                                            Site
                                                        </label>

                                                        <input type="text" class="form-control" value="<%= user.site %>"
                                                            readonly>
                                                    </div>

                                                </div>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                                <!-- Footer -->
                                <div class="d-flex justify-content-end gap-2 mt-4">

                                    <a href="/user/my-profil" class="btn btn-outline-secondary">
                                        Cancel
                                    </a>

                                    <button type="submit" class="btn btn-primary">
                                        Save changes
                                    </button>

                                </div>

                            </form>

                        </div>

                    </div>
                    <%- include('partials/footer.ejs') %>
                </main>

    </body>

    </html>