<%- include('partials/head.ejs') %>

    <body>
        <%- include('partials/sidebar.ejs') %>
            <%- include('partials/header.ejs') %>

                <main class="nxl-container">
                    <div class="nxl-content">
                        <div class="page-header">
                            <div class="page-header-left d-flex align-items-center">
                                <div class="page-header-title">
                                    <h5 class="m-b-10">Be-Leave</h5>
                                </div>
                                <ul class="breadcrumb">
                                    <li class="breadcrumb-item">Employee</li>
                                    <li class="breadcrumb-item">Confirm archive</li>
                                </ul>
                            </div>
                            <div class="page-header-right ms-auto">
                                <div class="page-header-right-items">
                                    <div class="d-flex d-md-none">
                                        <a href="javascript:void(0)" class="page-header-right-close-toggle">
                                            <i class="feather-arrow-left me-2"></i>
                                            <span>Back</span>
                                        </a>
                                    </div>
                                </div>
                                <div class="d-md-none d-flex align-items-center">
                                    <a href="javascript:void(0)" class="page-header-right-open-toggle">
                                        <i class="feather-align-right fs-20"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <!-- [ page-header ] end -->
                        <div class="bg-white py-3 border-bottom rounded-0 p-md-0 mb-0">
                            <div class="d-md-none d-flex align-items-center justify-content-between">
                                <a href="javascript:void(0)" class="page-content-left-open-toggle">
                                    <i class="feather-align-left fs-20"></i>
                                </a>
                            </div>
                        </div>

                        <div class="container-fluid py-4">

                            <div class="row justify-content-center">

                                <div class="col-lg-8 col-xl-6">

                                    <div class="card shadow-sm border-0">

                                        <div class="card-header bg-danger text-white">
                                            <h4 class="mb-0">
                                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                                Deactivate Employee
                                            </h4>
                                        </div>

                                        <div class="card-body p-4">

                                            <div class="text-center mb-4">

                                                <div class="display-1 text-warning">
                                                    <i class="bi bi-archive"></i>
                                                </div>

                                                <h3 class="mt-3">
                                                    Are you sure?
                                                </h3>

                                                <div class="alert alert-warning mt-2 mb-4">

                                                    <strong>Warning:</strong>

                                                    Are you sure you want to deactivate this employee? They will be
                                                    marked as inactive and hidden from the active employee list.

                                                </div>

                                                <!-- <p class="text-muted">
                                                    You are about to archive the following employee.
                                                </p> -->

                                            </div>

                                            <div class="card bg-light border-0">

                                                <div class="card-body">

                                                    <div class="row g-3">

                                                        <div class="col-md-6">
                                                            <small class="text-muted">
                                                                Employee ID
                                                            </small>

                                                            <div class="fw-semibold">
                                                                <%= employee.matricule %>
                                                            </div>
                                                        </div>

                                                        <div class="col-md-6">
                                                            <small class="text-muted">
                                                                Job Level
                                                            </small>

                                                            <div class="fw-semibold">
                                                                Level <%= employee.job_level ?
                                                                    employee.job_level.substring(1) : '' %>
                                                            </div>
                                                        </div>

                                                        <div class="col-md-6">
                                                            <small class="text-muted">
                                                                Name
                                                            </small>

                                                            <div class="fw-semibold">
                                                                <%= employee.firstname %>
                                                                    <%= employee.name %>
                                                            </div>
                                                        </div>

                                                        <div class="col-md-6">
                                                            <small class="text-muted">
                                                                Department
                                                            </small>

                                                            <div class="fw-semibold">
                                                                <%= employee.departement || '-' %>
                                                            </div>
                                                        </div>

                                                        <div class="col-md-12">
                                                            <small class="text-muted">
                                                                Site
                                                            </small>

                                                            <div class="fw-semibold">
                                                                <%= employee.site %>
                                                            </div>
                                                        </div>

                                                    </div>

                                                </div>

                                            </div>

                                            <div class="card shadow-sm border-0 mt-4">
                                                <form method="POST"
                                                    action="/employee/confirm-archive/<%= employee.id %>"
                                                    class="d-inline" id="confirm-archive-form">
                                                    <div class="card-body">
                                                        <h6 class="card-title mb-3">
                                                            Date of resignation
                                                        </h6>
                                                        <input type="date" class="form-control" id="DOR" name="DOR"
                                                            required>
                                                    </div>

                                                </form>
                                            </div>

                                        </div>

                                        <div class="card-footer bg-white">

                                            <div class="d-flex justify-content-end gap-2">

                                                <a href="/employee/details/<%= employee.id %>"
                                                    class="btn btn-outline-secondary">

                                                    Cancel

                                                </a>

                                                <button type="submit" class="btn btn-danger"
                                                    form="confirm-archive-form">

                                                    <i class="bi bi-archive me-2"></i>
                                                    Deactivate

                                                </button>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                    <%- include('partials/footer.ejs') %>
                </main>

    </body>

    </html>