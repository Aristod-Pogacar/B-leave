<%- include('partials/head.ejs') %>

    <body>
        <%- include('partials/sidebar.ejs') %>
            <%- include('partials/header.ejs') %>
                <main class="nxl-container">
                    <div class="nxl-content">
                        <div class="page-header">
                            <div class="page-header-left d-flex align-items-center">
                                <div class="page-header-title">
                                    <h5 class="m-b-10">B-Leave</h5>
                                </div>
                                <ul class="breadcrumb">
                                    <li class="breadcrumb-item">Permission 2h</li>
                                    <li class="breadcrumb-item">List</li>
                                </ul>
                            </div>
                            <div class="page-header-right ms-auto">
                                <div class="d-md-none d-flex align-items-center">
                                    <a href="javascript:void(0)" class="page-header-right-open-toggle">
                                        <i class="feather-align-right fs-20"></i>
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div class="bg-white py-3 border-bottom rounded-0 p-md-0 mb-0">
                            <div class="d-md-none d-flex align-items-center justify-content-between">
                                <a href="javascript:void(0)" class="page-content-left-open-toggle">
                                    <i class="feather-align-left fs-20"></i>
                                </a>
                            </div>
                        </div>

                        <div class="main-content">
                            <div class="tab-content">
                                <div class="tab-pane fade active show" id="overviewTab">
                                    <div class="row">
                                        <div class="col-12">
                                            <div class="card stretch stretch-full">
                                                <div class="card-header">
                                                    <h5 class="card-title">2h Permissions History</h5>

                                                    <!-- Filtres -->
                                                    <form method="GET" action=""
                                                        class="d-flex align-items-end gap-5 mt-2 flex-wrap">
                                                        <div>
                                                            <label class="form-label mb-1">Search</label>
                                                            <input type="text" name="search" class="form-control"
                                                                placeholder="Employee ID, name..."
                                                                value="<%= search %>" />
                                                        </div>
                                                        <div>

                                                            <label
                                                                class="form-label mb-1 <% if (user.role== 'MANAGER' || user.role=='HR_LEAD' ) { %> d-none <% } %>">Site</label>
                                                            <select
                                                                class="form-select <% if (user.role== 'MANAGER' || user.role=='HR_LEAD' ) { %> d-none <% } %>"
                                                                name="site" id="site">
                                                                <option value="all">All</option>
                                                                <% allowedSites.forEach(function(st) { %>
                                                                    <% const maValeur=st ; const
                                                                        index=allowedSites.indexOf(maValeur); const
                                                                        maCle=(index !==-1) ? KEYS[index] : "Inconnu" ;
                                                                        %>
                                                                        <% if(st===site) { %>
                                                                            <option value="<%= st %>" selected>
                                                                                <%= maCle %>
                                                                            </option>
                                                                            <% } else { %>
                                                                                <option value="<%= st %>">
                                                                                    <%= maCle %>
                                                                                </option>
                                                                                <% } %>
                                                                                    <% }); %>
                                                            </select>
                                                        </div>
                                                        <div>
                                                            <label class="form-label mb-1">Start date</label>
                                                            <input type="date" name="startDate" class="form-control"
                                                                value="<%= startDate %>" />
                                                        </div>
                                                        <div>
                                                            <label class="form-label mb-1">End date</label>
                                                            <input type="date" name="endDate" class="form-control"
                                                                value="<%= endDate %>" />
                                                        </div>
                                                        <div class="d-flex gap-2">
                                                            <button type="submit" class="btn btn-primary">
                                                                <i class="feather-search me-1"></i> Filtrer
                                                            </button>
                                                            <a href="?" class="btn btn-outline-secondary">
                                                                <i class="feather-x me-1"></i> Reset
                                                            </a>
                                                        </div>
                                                    </form>
                                                </div>

                                                <div class="card-body custom-card-action p-0">
                                                    <div class="table-responsive mb-3">
                                                        <table class="table table-hover mb-0">
                                                            <thead>
                                                                <tr>
                                                                    <th style="width: 10%;">Employee ID</th>
                                                                    <th style="width: 40%;">Fullname</th>
                                                                    <th style="width: 20%;">Applied at</th>
                                                                    <th style="width: 10%;">Start time</th>
                                                                    <th style="width: 10%;">End time</th>
                                                                    <th style="width: 10%;">Status</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <% data.forEach(d=> {
                                                                    var leaveTypeClass = "";
                                                                    if (d.status === "pending") {
                                                                    leaveTypeClass = "bg-soft-primary text-primary";
                                                                    } else if (d.status === "approved") {
                                                                    leaveTypeClass = "bg-soft-success text-success";
                                                                    } else if (d.status === "rejected") {
                                                                    leaveTypeClass = "bg-soft-danger text-danger";
                                                                    }
                                                                    %>
                                                                    <tr>
                                                                        <td style="width: 10%;">
                                                                            <%= d.employee.matricule %>
                                                                        </td>
                                                                        <td style="width: 40%;">
                                                                            <a
                                                                                href="/employee/details/<%= d.employee.id %>">
                                                                                <%= d.employee.name %>
                                                                                    <%= d.employee.firstname %>
                                                                            </a>
                                                                        </td>
                                                                        <td style="width: 20%;">
                                                                            <%= d.applied_at.toLocaleDateString('en-GB',
                                                                                { weekday: 'long' , year: 'numeric' ,
                                                                                month: 'long' , day: 'numeric' }) %>
                                                                        </td>
                                                                        <td style="width: 10%;">
                                                                            <%= d.expectedStartTime %>
                                                                        </td>
                                                                        <td style="width: 10%;">
                                                                            <%= d.expectedEndTime %>
                                                                        </td>
                                                                        <td style="width: 10%;">
                                                                            <span class="badge <%= leaveTypeClass %>">
                                                                                <%= d.status %>
                                                                            </span>
                                                                        </td>
                                                                    </tr>
                                                                    <% }) %>
                                                                        <% if (data.length===0) { %>
                                                                            <tr>
                                                                                <td colspan="6"
                                                                                    class="text-center text-muted py-4">
                                                                                    Aucun résultat trouvé.</td>
                                                                            </tr>
                                                                            <% } %>
                                                            </tbody>
                                                        </table>
                                                    </div>

                                                    <!-- Pagination -->
                                                    <div
                                                        class="d-flex align-items-center justify-content-between px-3 pb-3">
                                                        <small class="text-muted">
                                                            Total : <strong>
                                                                <%= total %>
                                                            </strong> enregistrement(s)
                                                        </small>
                                                        <% if (totalPages> 1) { %>
                                                            <ul class="pagination mb-0">

                                                                <!-- Précédent -->
                                                                <li
                                                                    class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                                                                    <a class="page-link"
                                                                        href="?page=<%= currentPage - 1 %>&search=<%= search %>&startDate=<%= startDate %>&endDate=<%= endDate %>">
                                                                        <i class="feather-chevron-left"></i>
                                                                    </a>
                                                                </li>

                                                                <!-- Première page si hors plage -->
                                                                <% if (startPage> 1) { %>
                                                                    <li class="page-item">
                                                                        <a class="page-link"
                                                                            href="?page=1&search=<%= search %>&startDate=<%= startDate %>&endDate=<%= endDate %>">1</a>
                                                                    </li>
                                                                    <% if (startPage> 2) { %>
                                                                        <li class="page-item disabled"><span
                                                                                class="page-link">…</span></li>
                                                                        <% } %>
                                                                            <% } %>

                                                                                <!-- Pages numérotées -->
                                                                                <% for (let i=startPage; i <=endPage;
                                                                                    i++) { %>
                                                                                    <li
                                                                                        class="page-item <%= i === currentPage ? 'active' : '' %>">
                                                                                        <a class="page-link"
                                                                                            href="?page=<%= i %>&search=<%= search %>&startDate=<%= startDate %>&endDate=<%= endDate %>">
                                                                                            <%= i %>
                                                                                        </a>
                                                                                    </li>
                                                                                    <% } %>

                                                                                        <!-- Dernière page si hors plage -->
                                                                                        <% if (endPage < totalPages) {
                                                                                            %>
                                                                                            <% if (endPage < totalPages
                                                                                                - 1) { %>
                                                                                                <li
                                                                                                    class="page-item disabled">
                                                                                                    <span
                                                                                                        class="page-link">…</span>
                                                                                                </li>
                                                                                                <% } %>
                                                                                                    <li
                                                                                                        class="page-item">
                                                                                                        <a class="page-link"
                                                                                                            href="?page=<%= totalPages %>&search=<%= search %>&startDate=<%= startDate %>&endDate=<%= endDate %>">
                                                                                                            <%= totalPages
                                                                                                                %>
                                                                                                        </a>
                                                                                                    </li>
                                                                                                    <% } %>

                                                                                                        <!-- Suivant -->
                                                                                                        <li
                                                                                                            class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                                                                                                            <a class="page-link"
                                                                                                                href="?page=<%= currentPage + 1 %>&search=<%= search %>&startDate=<%= startDate %>&endDate=<%= endDate %>">
                                                                                                                <i
                                                                                                                    class="feather-chevron-right"></i>
                                                                                                            </a>
                                                                                                        </li>

                                                            </ul>
                                                            <% } %>
                                                    </div>

                                                </div>
                                                <% if (user.role==='SUPERADMIN' || user.role==='HR_LEAD' ) { %>
                                                    <div class="card-footer">
                                                        <div class="d-flex gap-2 justify-content-end">
                                                            <a href="/permission2h/export?search=<%= search %>&startDate=<%= startDate %>&endDate=<%= endDate %>&site=<%= site %>"
                                                                class="btn btn-primary"><i
                                                                    class="feather-download me-1"></i> Export</a>
                                                        </div>
                                                    </div>
                                                    <% } %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <%- include('partials/footer.ejs') %>
                </main>
    </body>