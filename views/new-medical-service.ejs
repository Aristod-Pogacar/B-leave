<%- include('partials/head.ejs') %>

    <body>
        <%- include('partials/sidebar.ejs') %>
            <%- include('partials/header.ejs') %>
                <main class="nxl-container">
                    <div class="nxl-content">
                        <div class="page-header">
                            <div class="page-header-left d-flex align-items-center">
                                <div class="page-header-title">
                                    <h5 class="m-b-10">B-Leave</h5>
                                </div>

                                <ul class="breadcrumb">
                                    <li class="breadcrumb-item">Medical Service</li>
                                    <li class="breadcrumb-item">Service Management</li>
                                    <li class="breadcrumb-item">New Service</li>
                                </ul>
                            </div>
                            <div class="page-header-right ms-auto">
                                <div class="page-header-right-items">
                                    <div class="d-flex d-md-none">
                                        <a href="javascript:void(0)" class="page-header-right-close-toggle">
                                            <i class="feather-arrow-left me-2"></i>
                                            <span>Back</span>
                                        </a>
                                    </div>
                                </div>
                                <div class="d-md-none d-flex align-items-center">
                                    <a href="javascript:void(0)" class="page-header-right-open-toggle">
                                        <i class="feather-align-right fs-20"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <!-- [ page-header ] end -->
                        <div class="bg-white py-3 border-bottom rounded-0 p-md-0 mb-0">
                            <div class="d-md-none d-flex align-items-center justify-content-between">
                                <a href="javascript:void(0)" class="page-content-left-open-toggle">
                                    <i class="feather-align-left fs-20"></i>
                                </a>
                            </div>
                        </div>
                        <!-- [ Main Content ] start -->
                        <div class="main-content">
                            <div class="tab-content">
                                <div class="tab-pane fade active show" id="overviewTab">
                                    <div class="row">

                                        <div class="col-12">
                                            <div class="card stretch stretch-full">
                                                <div class="card-body border-bottom border-1">
                                                    <div
                                                        class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">

                                                        <div>
                                                            <h3 class="fw-bold mb-1">
                                                                New Medical Service
                                                            </h3>

                                                            <p class="text-muted mb-0">
                                                                Create a new medical service available for employee
                                                                consultations.
                                                            </p>
                                                        </div>

                                                    </div>
                                                </div>

                                                <div class="card-body">

                                                    <% if (locals.error) { %>
                                                        <div class="alert alert-danger mb-4" role="alert" id="message">
                                                            <i class="feather-alert-circle me-2"></i>
                                                            <%= error %>
                                                        </div>
                                                        <% } %>

                                                            <form id="userForm" method="POST"
                                                                action="/medical-service/new-medical-service">

                                                                <div class="border rounded-3 p-4">

                                                                    <h6 class="fw-bold mb-3">
                                                                        <i
                                                                            class="feather-plus-square me-2 text-primary"></i>
                                                                        Service Information
                                                                    </h6>

                                                                    <div class="row">

                                                                        <div class="col-lg-8">
                                                                            <label class="form-label">
                                                                                Service Name
                                                                                <span class="text-danger">*</span>
                                                                            </label>

                                                                            <input type="text" class="form-control"
                                                                                id="name" name="name"
                                                                                placeholder="e.g. General Consultation, Vaccination, Laboratory Test..."
                                                                                required>
                                                                        </div>

                                                                    </div>

                                                                </div>

                                                            </form>

                                                </div>

                                                <div class="card-footer d-flex justify-content-end gap-2">
                                                    <a href="/medical-service/list" class="btn btn-light">
                                                        Cancel
                                                    </a>

                                                    <button type="submit" form="userForm" class="btn btn-primary"
                                                        id="submit">
                                                        <i class="feather-save me-2"></i>
                                                        Save Service
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <%- include('partials/new-leave-modal-test') %>
                        <%- include('partials/footer.ejs') %>
    </body>

    </html>