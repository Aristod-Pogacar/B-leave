<%- include('partials/head.ejs') %>

    <body>
        <%- include('partials/sidebar.ejs') %>
            <%- include('partials/header.ejs') %>
                <main class="nxl-container">
                    <div class="nxl-content">
                        <div class="page-header">
                            <div class="page-header-left d-flex align-items-center">
                                <div class="page-header-title">
                                    <h5 class="m-b-10">Be-Leave</h5>
                                </div>
                                <ul class="breadcrumb">
                                    <li class="breadcrumb-item">Employee</li>
                                    <li class="breadcrumb-item">Edit employee</li>
                                </ul>
                            </div>
                            <div class="page-header-right ms-auto">
                                <div class="page-header-right-items">
                                    <div class="d-flex d-md-none">
                                        <a href="javascript:void(0)" class="page-header-right-close-toggle">
                                            <i class="feather-arrow-left me-2"></i>
                                            <span>Back</span>
                                        </a>
                                    </div>
                                </div>
                                <div class="d-md-none d-flex align-items-center">
                                    <a href="javascript:void(0)" class="page-header-right-open-toggle">
                                        <i class="feather-align-right fs-20"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <!-- [ page-header ] end -->
                        <div class="bg-white py-3 border-bottom rounded-0 p-md-0 mb-0">
                            <div class="d-md-none d-flex align-items-center justify-content-between">
                                <a href="javascript:void(0)" class="page-content-left-open-toggle">
                                    <i class="feather-align-left fs-20"></i>
                                </a>
                            </div>
                        </div>
                        <!-- [ Main Content ] start -->
                        <div class="container-fluid py-4">

                            <% if (locals.error) { %>
                                <div class="alert alert-danger">
                                    <%= error %>
                                </div>
                                <% } %>

                                    <form id="userForm" method="POST" action="/employee/edit/<%= employee.id %>">

                                        <!-- Header -->
                                        <div class="card shadow-sm border-0 mb-4">
                                            <div class="card-body">
                                                <div
                                                    class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">

                                                    <div>
                                                        <h2 class="mb-1">
                                                            Edit employee
                                                        </h2>

                                                        <div class="text-muted">
                                                            <%= employee.name %>
                                                                <%= employee.firstname %>
                                                        </div>
                                                    </div>

                                                    <span class="badge text-dark fs-6">
                                                        <%= employee.matricule %>
                                                    </span>

                                                </div>
                                            </div>
                                        </div>

                                        <div class="row g-4">

                                            <!-- Informations personnelles -->
                                            <div class="col-12">
                                                <div class="card shadow-sm border-0">
                                                    <div class="card-header bg-primary">
                                                        <h5 class="mb-0 text-light">Personnal informations</h5>
                                                    </div>

                                                    <div class="card-body">

                                                        <div class="row g-3">

                                                            <div class="col-md-2">
                                                                <label class="form-label">Matricule</label>
                                                                <input type="text" class="form-control" name="matricule"
                                                                    value="<%= employee.matricule %>" required>
                                                            </div>

                                                            <div class="col-md-4">
                                                                <label class="form-label">Name</label>
                                                                <input type="text" class="form-control" name="name"
                                                                    value="<%= employee.name %>" required>
                                                            </div>

                                                            <div class="col-md-4">
                                                                <label class="form-label">First name</label>
                                                                <input type="text" class="form-control" name="firstname"
                                                                    value="<%= employee.firstname %>" required>
                                                            </div>

                                                            <div class="col-md-2">
                                                                <label class="form-label">Gender</label>

                                                                <select name="gender" class="form-select" required>

                                                                    <option value="Male" <%=employee.gender==='Male'
                                                                        ? 'selected' : '' %>>
                                                                        Male
                                                                    </option>

                                                                    <option value="Female" <%=employee.gender==='Female'
                                                                        ? 'selected' : '' %>>
                                                                        Female
                                                                    </option>

                                                                </select>
                                                            </div>

                                                        </div>

                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Organisation -->
                                            <div class="col-lg-6">
                                                <div class="card shadow-sm border-0 h-100">
                                                    <div class="card-header bg-primary">
                                                        <h5 class="mb-0 text-light">Organisation</h5>
                                                    </div>

                                                    <div class="card-body">

                                                        <div class="row g-3">

                                                            <div class="col-md-12">
                                                                <label class="form-label">Site</label>

                                                                <select name="site" class="form-select" required>

                                                                    <% allowedSites.forEach(function(site) { %>

                                                                        <% const index=allowedSites.indexOf(site); %>
                                                                            <% const label=index !==-1 ? KEYS[index] :
                                                                                site; %>

                                                                                <option value="<%= site %>"
                                                                                    <%=employee.site===site ? 'selected'
                                                                                    : '' %>>
                                                                                    <%= label %>
                                                                                </option>

                                                                                <% }) %>

                                                                </select>
                                                            </div>

                                                            <div class="col-md-6">
                                                                <label class="form-label">Department</label>
                                                                <input type="text" class="form-control"
                                                                    name="departement"
                                                                    value="<%= employee.departement %>">
                                                            </div>

                                                            <div class="col-md-6">
                                                                <label class="form-label">Section</label>
                                                                <input type="text" class="form-control" name="section"
                                                                    value="<%= employee.section %>">
                                                            </div>

                                                            <div class="col-md-6">
                                                                <label class="form-label">Division</label>
                                                                <input type="text" class="form-control" name="division"
                                                                    value="<%= employee.division %>">
                                                            </div>

                                                            <div class="col-md-6">
                                                                <label class="form-label">Designation</label>
                                                                <input type="text" class="form-control"
                                                                    name="designation"
                                                                    value="<%= employee.designation %>">
                                                            </div>

                                                            <div class="col-md-12">
                                                                <label class="form-label">Line</label>

                                                                <select name="line" class="form-select">

                                                                    <%
                                                                        ['L1','L2','L3','L4','L5','L6','NULL'].forEach(line=>
                                                                        { %>
                                                                        <option value="<%= line %>"
                                                                            <%=employee.line===line ? 'selected' : '' %>
                                                                            >
                                                                            <%= line %>
                                                                        </option>
                                                                        <% }) %>

                                                                </select>
                                                            </div>

                                                        </div>

                                                    </div>
                                                </div>
                                            </div>

                                            <!-- RH -->
                                            <div class="col-lg-6">
                                                <div class="card shadow-sm border-0 h-100">
                                                    <div class="card-header bg-primary">
                                                        <h5 class="mb-0 text-light">HR informations</h5>
                                                    </div>

                                                    <div class="card-body">

                                                        <div class="row g-3">

                                                            <div class="col-md-6">
                                                                <label class="form-label">Job Level</label>
                                                                <input type="text" class="form-control" name="job_level"
                                                                    value="<%= employee.job_level?.slice(1) || '' %>">
                                                            </div>

                                                            <div class="col-md-6">
                                                                <label class="form-label">Type</label>
                                                                <input type="text" class="form-control" name="type"
                                                                    value="<%= employee.type %>">
                                                            </div>

                                                            <div class="col-md-12">
                                                                <label class="form-label">Date of entry</label>
                                                                <input type="date" class="form-control" name="DOE"
                                                                    value="<%= employee.DOE %>">
                                                            </div>

                                                            <div class="col-md-12">
                                                                <label class="form-label">Manager</label>

                                                                <input type="text" class="form-control"
                                                                    id="managerSearch"
                                                                    placeholder="Rechercher un manager..."
                                                                    value="<%= employee.manager ? employee.manager.matricule + ' - ' + employee.manager.firstName + ' ' + employee.manager.name : '' %>">

                                                                <input type="hidden" name="managerId" id="manager"
                                                                    value="<%= employee.manager ? employee.manager.id : '' %>">

                                                                <ul id="managerResults" class="list-group mt-2">
                                                                </ul>
                                                            </div>

                                                        </div>

                                                    </div>
                                                </div>
                                            </div>

                                        </div>

                                        <!-- Footer -->
                                        <div class="d-flex justify-content-end gap-2 mt-4">
                                            <a href="/employee/details/<%= employee.id %>"
                                                class="btn btn-outline-secondary">
                                                Cancel
                                            </a>

                                            <button type="submit" class="btn btn-primary">
                                                Save
                                            </button>
                                        </div>

                                    </form>

                        </div>
                    </div>
                    <%- include('partials/new-leave-modal-test') %>
                        <%- include('partials/footer.ejs') %>
    </body>
    <script>
        let skip = 0;
        const take = 10;
        let isLoading = false;
        let hasMore = true;
        let currentEmployeeId = null;
        let solde = 0;
        const results = document.getElementById('managerResults');
        const input = document.getElementById('managerSearch');
        const hiddenInput = document.getElementById('manager');
        let timeout = null;

        input.addEventListener('input', () => {
            if (input.value.trim() === '') {
                results.innerHTML = '';
                hiddenInput.value = '';
                return;
            }
            clearTimeout(timeout);

            const query = input.value.trim();
            if (query.length < 2) {
                results.innerHTML = '';
                return;
            }

            timeout = setTimeout(async () => {
                try {
                    const res = await fetch(`/user/search-manager?search=${query}`);

                    if (!res.ok) {
                        console.error('HTTP error', res.status);
                        return;
                    }

                    const data = await res.json();


                    results.innerHTML = '';
                    data.forEach(manager => {
                        const li = document.createElement('li');
                        li.classList.add('list-group-item');
                        li.textContent = `${manager.matricule} - ${manager.firstName} ${manager.name}`;
                        li.onclick = async () => {
                            input.value = li.textContent;
                            console.log("MANAGER ID:", manager.id);
                            hiddenInput.value = manager.id;
                            results.innerHTML = '';
                            skip = 0;
                            hasMore = true;
                        };
                        results.appendChild(li);
                    });

                } catch (err) {
                    console.error('Autocomplete error:', err);
                }
            }, 300);
        });
    </script>

    </html>