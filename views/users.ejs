<%- include('partials/head.ejs') %>

    <body>
        <%- include('partials/sidebar.ejs') %>
            <%- include('partials/header.ejs') %>
                <main class="nxl-container">
                    <div class="nxl-content">
                        <div class="page-header">
                            <div class="page-header-left d-flex align-items-center">
                                <div class="page-header-title">
                                    <h5 class="m-b-10">Be-Leave</h5>
                                </div>
                                <ul class="breadcrumb">
                                    <li class="breadcrumb-item">Users</li>
                                    <li class="breadcrumb-item">List</li>
                                </ul>
                            </div>
                            <div class="page-header-right ms-auto">
                                <div class="page-header-right-items">
                                    <div class="d-flex d-md-none">
                                        <a href="javascript:void(0)" class="page-header-right-close-toggle">
                                            <i class="feather-arrow-left me-2"></i>
                                            <span>Back</span>
                                        </a>
                                    </div>
                                </div>
                                <div class="d-md-none d-flex align-items-center">
                                    <a href="javascript:void(0)" class="page-header-right-open-toggle">
                                        <i class="feather-align-right fs-20"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <!-- [ page-header ] end -->
                        <div class="bg-white py-3 border-bottom rounded-0 p-md-0 mb-0">
                            <div class="d-md-none d-flex align-items-center justify-content-between">
                                <a href="javascript:void(0)" class="page-content-left-open-toggle">
                                    <i class="feather-align-left fs-20"></i>
                                </a>
                            </div>
                        </div>
                        <!-- [ Main Content ] start -->
                        <div class="main-content">
                            <div class="tab-content">
                                <div class="tab-pane fade active show" id="overviewTab">
                                    <div class="row">

                                        <div class="col-12">
                                            <div class="card stretch stretch-full">
                                                <div class="card-body border-bottom border-1">
                                                    <div
                                                        class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">

                                                        <div>
                                                            <h3 class="fw-bold mb-1">
                                                                User Directory
                                                            </h3>

                                                            <p class="text-muted mb-0">
                                                                Manage application users and permissions.
                                                            </p>
                                                            <span
                                                                class="badge bg-soft-primary text-primary fs-12 px-3 py-2">
                                                                <% if (users.length==0) { %>
                                                                    No User
                                                                    <% } else if (users.length==1) { %>
                                                                        <%= users.length %> User
                                                                            <% } else { %>
                                                                                <%= users.length %> Users
                                                                                    <% } %>
                                                            </span>
                                                        </div>

                                                        <div class="d-flex gap-2">

                                                            <a href="/user/new-user" class="btn btn-primary">
                                                                <i class="feather-plus me-2"></i>
                                                                New User
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="card-body custom-card-action p-0">
                                                    <div class="table-responsive">
                                                        <table class="table table-hover align-middle mb-0">
                                                            <thead>
                                                                <tr>
                                                                    <th style="width:25%;">User</th>
                                                                    <th style="width:10%;" class="text-center">Site</th>
                                                                    <th style="width:15%;" class="text-center">Phone
                                                                    </th>
                                                                    <th style="width:20%;">Email</th>
                                                                    <th style="width:15%;" class="text-center">Role</th>

                                                                    <% if(user.role !=="PAYROLL" ) { %>
                                                                        <th style="width:15%;" class="text-center">
                                                                            Actions</th>
                                                                        <% } %>
                                                                </tr>
                                                            </thead>

                                                            <tbody>
                                                                <!-- <tr>
                                                                <td>1</td>
                                                                <td>
                                                                    <div
                                                                        class="fs-11 d-flex justify-content-between mb-1">
                                                                        Super</div>
                                                                </td>
                                                                <td>
                                                                    <div class="hstack gap-3">
                                                                        Admin
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <div class="hstack gap-3">
                                                                        ADMIN
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <div class="hstack gap-3">
                                                                        -
                                                                    </div>
                                                                </td>
                                                                <td>stagedp@aquarabe.mg</td>
                                                                <td class="text-center"><span
                                                                        class="badge bg-soft-danger text-danger">Super
                                                                        Admin</span>
                                                                </td>
                                                                <% if(user.role !=="PAYROLL" ) { %>
                                                                    <td class="text-center">
                                                                    </td>
                                                                    <% } %>
                                                            </tr> -->
                                                                <% var i=1 %>
                                                                    <% users.forEach(users=> { var roleColor="primary"
                                                                        if (users.role==userRole.SUPERADMIN)
                                                                        {
                                                                        roleColor="danger"
                                                                        } else if (users.role==userRole.ADMIN) {
                                                                        roleColor="warning"
                                                                        } else if (users.role==userRole.PAYROLL) {
                                                                        roleColor="info"
                                                                        } else if (users.role==userRole.HR_LEAD) {
                                                                        roleColor="success"
                                                                        } %>
                                                                        <tr>

                                                                            <td style="width:25%;">
                                                                                <div class="d-flex align-items-center">

                                                                                    <div
                                                                                        class="avatar-text avatar-md bg-soft-primary me-3">
                                                                                        <%= users.firstName?.charAt(0)
                                                                                            || users.name?.charAt(0) %>
                                                                                    </div>

                                                                                    <div>
                                                                                        <div
                                                                                            class="fw-semibold text-dark">
                                                                                            <%= users.firstName %>
                                                                                                <%= users.name %>
                                                                                        </div>

                                                                                        <small class="text-muted">
                                                                                            <%= users.matricule %>
                                                                                        </small>
                                                                                    </div>

                                                                                </div>
                                                                            </td>

                                                                            <td class="text-center" style="width:10%;">
                                                                                <% const maValeur=users.site ; const
                                                                                    index=allValues.indexOf(maValeur);
                                                                                    const maCle=(index !==-1) ?
                                                                                    keys[index] : "Inconnu" ; %>
                                                                                    <span
                                                                                        class="badge bg-soft-info text-info">
                                                                                        <%= maCle %>
                                                                                    </span>
                                                                            </td>

                                                                            <td class="text-center" style="width:15%;">
                                                                                <%= users.phone || '-' %>
                                                                            </td>

                                                                            <td style="width:20%;">
                                                                                <%= users.email || '-' %>
                                                                            </td>

                                                                            <td class="text-center" style="width:15%;">
                                                                                <span
                                                                                    class="badge bg-soft-<%= roleColor %> text-<%= roleColor %>">
                                                                                    <%= users.role %>
                                                                                </span>
                                                                            </td>

                                                                            <% if(user.role !=="PAYROLL" ) { %>
                                                                                <td class="text-center">

                                                                                    <% if(users.id !=='superadmin' ) {
                                                                                        %>

                                                                                        <div
                                                                                            class="d-flex justify-content-center gap-2">

                                                                                            <a href="/user/edit-user/<%= users.id %>"
                                                                                                class="btn btn-primary">

                                                                                                <i
                                                                                                    class="feather-edit-2"></i>
                                                                                            </a>

                                                                                            <a href="/user/delete-user/<%= users.id %>"
                                                                                                class="btn btn-danger">

                                                                                                <i
                                                                                                    class="feather-trash-2"></i>
                                                                                            </a>

                                                                                        </div>

                                                                                        <% } %>

                                                                                </td>
                                                                                <% } %>

                                                                        </tr>
                                                                        <% }) %>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <%- include('partials/footer.ejs') %>