<%- include('partials/head.ejs') %>

    <body>
        <%- include('partials/sidebar.ejs') %>
            <%- include('partials/header.ejs') %>
                <main class="nxl-container">
                    <div class="nxl-content">
                        <div class="page-header">
                            <div class="page-header-left d-flex align-items-center">
                                <div class="page-header-title">
                                    <h5 class="m-b-10">B-Leave</h5>
                                </div>
                                <ul class="breadcrumb">
                                    <li class="breadcrumb-item">Leaves</li>
                                    <li class="breadcrumb-item">History</li>
                                </ul>
                            </div>
                            <div class="page-header-right ms-auto">
                                <div class="page-header-right-items">
                                    <div class="d-flex d-md-none">
                                        <a href="javascript:void(0)" class="page-header-right-close-toggle">
                                            <i class="feather-arrow-left me-2"></i>
                                            <span>Back</span>
                                        </a>
                                    </div>
                                </div>
                                <div class="d-md-none d-flex align-items-center">
                                    <a href="javascript:void(0)" class="page-header-right-open-toggle">
                                        <i class="feather-align-right fs-20"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <!-- [ page-header ] end -->
                        <div class="bg-white py-3 border-bottom rounded-0 p-md-0 mb-0">
                            <div class="d-md-none d-flex align-items-center justify-content-between">
                                <a href="javascript:void(0)" class="page-content-left-open-toggle">
                                    <i class="feather-align-left fs-20"></i>
                                </a>
                            </div>
                        </div>
                        <!-- [ Main Content ] start -->
                        <div class="main-content">
                            <div class="tab-content">
                                <div class="tab-pane fade active show" id="overviewTab">
                                    <div class="row">

                                        <div class="col-xl-12">
                                            <div class="card stretch stretch-full d-flex">
                                                <div class="card-header">
                                                    <div class="d-flex align-items-center">
                                                        <div class="avatar-text avatar-lg bg-soft-primary me-3">
                                                            <i class="feather-clock"></i>
                                                        </div>

                                                        <div>
                                                            <h4 class="mb-1">Leave History</h4>
                                                            <p class="text-muted mb-0">
                                                                Search and review employee leave records.
                                                            </p>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="card-body border-bottom bg-light">

                                                    <!-- ===== LEFT: FORM ===== -->
                                                    <div class="col-md-12">

                                                        <!-- Recherche Employé -->
                                                        <div class="mb-0">
                                                            <div class="row">
                                                                <div class="col-md-12 mb-3">
                                                                    <label class=" form-label">Employee</label>
                                                                    <input type="text" class="form-control"
                                                                        id="employeeSearch" autocomplete="off"
                                                                        placeholder="Search an employee...">
                                                                    <input type="text" class="input" name="employee"
                                                                        id="employee" hidden required>
                                                                    <ul id="employeeResults"
                                                                        class="autocomplete-list ps-0 w-100 z-200">
                                                                    </ul>
                                                                </div>
                                                                <div class="col-md-4">
                                                                    <label for="status" class="form-label">Start</label>
                                                                    <input type="date" class="form-control"
                                                                        id="startDate" name="startDate">
                                                                </div>
                                                                <div class="col-md-4">
                                                                    <label for="status" class="form-label">End</label>
                                                                    <input type="date" class="form-control" id="endDate"
                                                                        name="endDate">
                                                                </div>
                                                                <div class="col-md-4">
                                                                    <label for="status"
                                                                        class="form-label">Status</label>
                                                                    <select name="status" id="status"
                                                                        class="form-select">
                                                                        <option value="all">All</option>
                                                                        <option value="pending">Pending
                                                                        </option>
                                                                        <option value="approved">Approved
                                                                        </option>
                                                                        <option value="rejected">Rejected
                                                                        </option>
                                                                    </select>
                                                                </div>
                                                            </div>
                                                        </div>

                                                    </div>
                                                    <!-- ===== RIGHT: INFOS ===== -->
                                                    <div class="col-md-6 d-none">

                                                        <div class="card mb-3 shadow-sm">
                                                            <div class="card-header text-center fw-bold">
                                                                Employee information
                                                            </div>
                                                            <div class="card-body">
                                                                <p class="mb-2">
                                                                    <strong>Fullname :</strong>
                                                                    <span id="fullname">-</span>
                                                                </p>
                                                                <p class="mb-2">
                                                                    <strong>Employee ID :</strong>
                                                                    <span id="matricule">-</span>
                                                                </p>
                                                                <p class="mb-2">
                                                                    <strong>Site :</strong>
                                                                    <span id="site">-</span>
                                                                </p>
                                                                <p class="mb-2">
                                                                    <strong>Line :</strong>
                                                                    <span id="line">-</span>
                                                                </p>
                                                                <p class="mb-2">
                                                                    <strong>Departement :</strong>
                                                                    <span id="departement">-</span>
                                                                </p>
                                                                <p class="mb-2">
                                                                    <strong>Section :</strong>
                                                                    <span id="section">-</span>
                                                                </p>
                                                                <p class="mb-2">
                                                                    <strong>Cumulated leave solde :</strong>
                                                                    <span id="soldeCumule">-</span>
                                                                </p>
                                                                <p class="mb-2">
                                                                    <strong>Taken leave :</strong>
                                                                    <span id="soldePris">-</span>
                                                                </p>
                                                                <p class="mb-2">
                                                                    <strong>Leaves remaining :</strong>
                                                                    <span id="soldeRestant"
                                                                        class="fw-bold text-primary">-</span>
                                                                </p>
                                                                <p class="mb-0">
                                                                    <strong>Taken permission :</strong>
                                                                    <span id="soldePermission"
                                                                        class="fw-bold text-success">-</span>
                                                                </p>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="row mt-2 d-none">
                                                        <div class="col-md-12 text-center">
                                                            <p id="message" class="fw-bold"></p>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="card-body">

                                                    <div class="modal-body">
                                                        <div class="row mt-4">
                                                            <div class="col-12 pt-3">
                                                                <div class="table-responsive" id="leaveHistoryWrapper">
                                                                    <table class="table table-hover align-middle mb-0">
                                                                        <thead>
                                                                            <tr>
                                                                                <!-- <th style="width:25%;">Employee</th> -->
                                                                                <th style="width:15%;">Leave
                                                                                    Information</th>
                                                                                <th style="width:10%;">Schedule</th>
                                                                                <th style="width:10%;"
                                                                                    class="text-center">Status</th>
                                                                                <th style="width:20%;">
                                                                                    Approved/Rejected by</th>
                                                                            </tr>
                                                                        </thead>

                                                                        <tbody id="leaveHistoryBody">
                                                                            <!-- Injected by JavaScript -->
                                                                        </tbody>
                                                                    </table>
                                                                </div>
                                                            </div>
                                                        </div>

                                                    </div>
                                                </div>
                                                <div class="card-footer d-none" <% if (user.role==='SUPERADMIN' ||
                                                    user.role==='PAYROLL' || user.role=="HR_LEAD" ) { %>
                                                    id="footer-export" <% } %>>
                                                        <form action="/leave/export-employee-leaves" method="get">
                                                            <input type="hidden" name="employeeId"
                                                                id="exportEmployeeId">
                                                            <input type="hidden" name="start" id="exportStartDate">
                                                            <input type="hidden" name="end" id="exportEndDate">
                                                            <input type="hidden" name="status" id="exportStatus"
                                                                value="all">
                                                            <button class="btn btn-primary" type="submit">
                                                                Export as Excel file
                                                            </button>
                                                        </form>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <%- include('partials/footer.ejs') %>
    </body>
    <script>

        let skip = 0;
        const take = 10;
        let isLoading = false;
        let hasMore = true;
        let currentEmployeeId = null;
        let solde = 0;

        var soldePermissionNumber = 0;

        const wrapper = document.getElementById("leaveHistoryWrapper");
        const tbody = document.getElementById("leaveHistoryBody");
        let footer = null;
        try {
            footer = document.getElementById("footer-export");
        } catch (error) {
            console.log(error);
        }
        // const exportBTN = document.getElementById("export-btn");
        const exportEmployeeId = document.getElementById("exportEmployeeId");

        var message = "";

        const input = document.getElementById('employeeSearch');
        const results = document.getElementById('employeeResults');
        const hiddenInput = document.getElementById('employee');
        let timeout = null;

        const startDate = document.getElementById('startDate');
        const endDate = document.getElementById('endDate');
        const exportStartDate = document.getElementById('exportStartDate');
        const exportEndDate = document.getElementById('exportEndDate');

        startDate.value = new Date().toISOString().split("T")[0];
        endDate.value = new Date().toISOString().split("T")[0];

        exportStartDate.value = startDate.value;
        exportEndDate.value = endDate.value;

        const status = document.getElementById('status');
        const exportStatus = document.getElementById('exportStatus');

        status.addEventListener('change', () => {
            console.log("STATUS:", status.value);
            exportStatus.value = status.value;
            skip = 0;
            hasMore = true;
            tbody.innerHTML = "";
            loadEmployeeLeaves(currentEmployeeId);
        });

        startDate.addEventListener('change', () => {
            console.log("START DATE:", startDate.value);
            exportStartDate.value = startDate.value;
            skip = 0;
            hasMore = true;
            tbody.innerHTML = "";
            loadEmployeeLeaves(currentEmployeeId);
        });

        endDate.addEventListener('change', () => {
            console.log("END DATE:", endDate.value);
            exportEndDate.value = endDate.value;
            skip = 0;
            hasMore = true;
            tbody.innerHTML = "";
            loadEmployeeLeaves(currentEmployeeId);
        });

        // const startDate = document.getElementById('startDate');
        // startDate.value = new Date().toISOString().split("T")[0];
        // const endDate = document.getElementById('endDate');
        // endDate.value = new Date().toISOString().split("T")[0];
        // const hiddenInput = document.getElementById('employee');

        const fullname = document.getElementById('fullname');
        const matricule = document.getElementById('matricule');
        const site = document.getElementById('site');
        const line = document.getElementById('line');
        const departement = document.getElementById('departement');
        const section = document.getElementById('section');
        const soldeCumule = document.getElementById('soldeCumule');
        const soldePris = document.getElementById('soldePris');
        const soldeRestant = document.getElementById('soldeRestant');
        const soldePermission = document.getElementById('soldePermission');

        input.addEventListener('input', () => {
            console.log("INPUT :", input.value);
            clearTimeout(timeout);

            const query = input.value.trim();
            if (query.length < 2) {
                results.innerHTML = '';
                return;
            }

            timeout = setTimeout(async () => {
                try {
                    const res = await fetch(`/employee/finding/search-list?q=${query}`);

                    if (!res.ok) {
                        console.error('HTTP error', res.status);
                        return;
                    }

                    const data = await res.json();

                    results.innerHTML = '';
                    console.log("DATA:", data);
                    data.forEach(emp => {
                        const li = document.createElement('li');
                        li.classList.add('list-group-item');
                        // li.classList.add('autocomplete-list-item');
                        li.textContent = `${emp.matricule} - ${emp.name + " " + emp.firstname}`;
                        li.onclick = async () => {
                            console.log("EMP:", emp);
                            input.value = li.textContent;
                            hiddenInput.value = emp.id;
                            fullname.textContent = emp.name + " " + emp.firstname;
                            matricule.textContent = emp.matricule;
                            site.textContent = emp.site;
                            line.textContent = emp.line;
                            departement.textContent = emp.departement;
                            section.textContent = emp.section;
                            soldeCumule.textContent = emp.solde_cumul + " day(s)";
                            soldePris.textContent = emp.solde_pris + " day(s)";
                            soldeRestant.textContent = emp.solde_restant + " day(s)";
                            soldePermission.textContent = emp.permissions + " day(s)";
                            solde = emp.solde_restant;
                            soldePermissionNumber = emp.permissions;
                            results.innerHTML = '';
                            skip = 0;
                            hasMore = true;
                            tbody.innerHTML = "";
                            currentEmployeeId = emp.id;
                            loadEmployeeLeaves(currentEmployeeId);
                            if (footer !== null) {
                                footer.className = "card-footer";
                            }
                            exportEmployeeId.value = emp.id;
                            // const historyResponse = await fetch(`/leave/employee-leaves/paginate/${emp.id}?skip=0&take=10`);
                            // const historyData = await historyResponse.json();
                            console.log("soldePermissionNumber:", soldePermissionNumber);
                        };
                        results.appendChild(li);
                    });

                } catch (err) {
                    console.error('Autocomplete error:', err);
                }
            }, 300);
        });

        async function loadEmployeeLeaves(employeeId) {
            console.log("HAS MORE:", hasMore);
            console.log("IS LOADING:", isLoading);
            console.log("EMPLOYEE ID:", employeeId);

            if (isLoading || !hasMore || !employeeId) return;

            isLoading = true;
            const url = `/leave/employee-leaves/paginate/${employeeId}?skip=${skip}&take=${take}&startDate=${startDate.value}&endDate=${endDate.value}&status=${status.value}`;
            console.log(url);

            try {
                const res = await fetch(url);

                if (!res.ok) return;

                const data = await res.json();
                console.log("DATA:", data.data);

                if (data.data.length < take) {
                    hasMore = false;
                }

                appendLeavesToTable(data.data);

                skip += take;

            } catch (err) {
                console.error("Pagination error:", err);
            }

            isLoading = false;
        }

        function formatDate(dateString) {
            if (!dateString) return "-";
            return new Date(dateString).toLocaleDateString("fr-FR");
        }

        function appendLeavesToTable(leaves) {
            var i = 1;

            leaves.forEach(leave => {
                console.log("LEAVE:", leave);

                const row = document.createElement("tr");
                var status = "waiting";
                var statusClass = "bg-primary";
                const today = new Date();
                const startDate = new Date(leave.start_date);
                startDate.setHours(0, 0, 0, 0);
                const endDate = new Date(leave.end_date);
                endDate.setHours(23, 59, 59, 999);

                if (leave.status == "pending") {
                    status = "pending";
                    statusClass = "bg-warning";
                } else if (leave.status == "approved") {
                    status = "approved";
                    statusClass = "bg-success";
                } else if (leave.status == "rejected") {
                    status = "rejected";
                    statusClass = "bg-danger";
                }

                var leaveTypeClass = "";
                if (leave.leave_type === "Local_Leave_AMD") {
                    leaveTypeClass = "bg-soft-primary text-primary";
                } else if (leave.leave_type === "Permission_AMD") {
                    leaveTypeClass = "bg-soft-success text-success";
                } else if (leave.leave_type === "Indisponibilite_AMD") {
                    leaveTypeClass = "bg-soft-danger text-danger";
                }

                const approver = leave.approver ? leave.approver.employee.name + " " + leave.approver.employee.firstname : "-";
                let approvedDate = "-";
                const returnDate = new Date(leave.end_date);
                returnDate.setDate(returnDate.getDate() + 1);
                if (leave.approved_date) {
                    approvedDate = new Date(leave.approved_date).toLocaleDateString("en-US",
                        {
                            year: "numeric",
                            month: "short",
                            day: "numeric",
                            hour: "numeric",
                            minute: "numeric",
                            second: "numeric",
                        }
                    );
                }

                row.innerHTML = `

    <td style="width:15%;">
        <div
            class="small">

            <div
                class="mb-1 mt-0 ms-4">
                <span
                    class="badge bg-soft-primary text-primary">

                    ${leave.leave_type.replace("_AMD", "").replace("_", " ")}
                </span>

            </div>

            <div
                class="
                        mb-1">

                        <i
                            class="feather-message-circle text-success me-2"></i>

                        <strong>Reason
                            :</strong>

                        ${leave.reason}

            </div>

            <div
                class="mb-1">

                <i
                    class="feather-corner-down-right text-warning me-2"></i>

                <strong>Duration
                    :</strong>

                ${leave.duration} day(s)

            </div>

        </div>
    </td>

    <td style="width:10%;">
        <div
            class="small">

            <div
                class="mb-1">

                <i
                    class="feather-edit-3 text-primary me-2"></i>

                <strong>Applied
                    :</strong>

                    ${new Date(leave.created_at).toLocaleDateString("fr-FR")}
            </div>

            <div
                class="mb-1">

                <i
                    class="feather-play text-success me-2"></i>

                <strong>Start
                    :</strong>

                ${new
                        Date(leave.start_date).toLocaleDateString("fr-FR")}

            </div>

            <div
                class="mb-1">

                <i
                    class="feather-corner-down-right text-warning me-2"></i>

                <strong>Return
                    :</strong>

                ${returnDate.toLocaleDateString("fr-FR")}

            </div>

        </div>
    </td>

    <td class="text-center" style="width:10%;">
        <span class="badge ${statusClass}">
            ${status}
        </span>
    </td>

    <td style="width:20%;">
        ${leave.approver ?
                        `
        <div
            class="d-flex align-items-center">

            <div
                class="avatar-text avatar-md bg-soft-warning text-warning me-3">

                ${leave.approver?.employee?.name.charAt(0) + leave.approver?.employee?.firstname.charAt(0)}

            </div>

            <div>

                <div
                    class="fw-semibold">

                        ${leave.approver?.employee?.name}
                            ${leave.approver?.employee?.firstname}

                </div>

                <small
                    class="text-muted">

                    <i
                        class="feather-clock me-1"></i>

                    ${approvedDate}

                </small>

            </div>

        </div>
            `
                        :
                        `<span class="text-muted">-</span>`
                    }
    </td>
`;

                tbody.appendChild(row);
                i++;
            });
        }
        wrapper.addEventListener("scroll", () => {

            const scrollPosition = wrapper.scrollTop + wrapper.clientHeight;
            const threshold = wrapper.scrollHeight - 5;

            if (scrollPosition >= threshold) {
                loadEmployeeLeaves();
            }
        });
    </script>

    </html>