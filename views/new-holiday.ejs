<%- include('partials/head.ejs') %>

    <body>
        <%- include('partials/sidebar.ejs') %>
            <%- include('partials/header.ejs') %>
                <main class="nxl-container">
                    <div class="nxl-content">
                        <div class="page-header">
                            <div class="page-header-left d-flex align-items-center">
                                <div class="page-header-title">
                                    <h5 class="m-b-10">B-Leave</h5>
                                </div>
                                <ul class="breadcrumb">
                                    <li class="breadcrumb-item">Leave</li>
                                    <li class="breadcrumb-item">New holiday</li>
                                </ul>
                            </div>
                            <div class="page-header-right ms-auto">
                                <div class="page-header-right-items">
                                    <div class="d-flex d-md-none">
                                        <a href="javascript:void(0)" class="page-header-right-close-toggle">
                                            <i class="feather-arrow-left me-2"></i>
                                            <span>Back</span>
                                        </a>
                                    </div>
                                </div>
                                <div class="d-md-none d-flex align-items-center">
                                    <a href="javascript:void(0)" class="page-header-right-open-toggle">
                                        <i class="feather-align-right fs-20"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <!-- [ page-header ] end -->
                        <div class="bg-white py-3 border-bottom rounded-0 p-md-0 mb-0">
                            <div class="d-md-none d-flex align-items-center justify-content-between">
                                <a href="javascript:void(0)" class="page-content-left-open-toggle">
                                    <i class="feather-align-left fs-20"></i>
                                </a>
                            </div>
                        </div>
                        <!-- [ Main Content ] start -->
                        <div class="main-content py-4">
                            <div class="container-fluid">

                                <% if (locals.error) { %>
                                    <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4"
                                        role="alert">
                                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                        <%= error %>
                                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                    </div>
                                    <% } %>

                                        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                                            <div class="card-body border-bottom border-1">
                                                <div
                                                    class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">

                                                    <div>
                                                        <h3 class="fw-bold mb-1">
                                                            New holiday
                                                        </h3>

                                                        <p class="text-muted mb-0">
                                                            Create a new holiday and assign holiday information.
                                                        </p>
                                                    </div>

                                                    <div class="d-flex gap-2">

                                                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                                                            style="width:64px;height:64px;">
                                                            <i class="bi bi-calendar-plus-fill fs-3"></i>
                                                        </div>

                                                    </div>

                                                </div>
                                            </div>

                                            <div class="card-body p-4">

                                                <form id="userForm" method="POST" action="/holiday/new-holiday">

                                                    <!-- Personal Information -->
                                                    <div class="mb-4">
                                                        <h5 class="fw-semibold mb-3">
                                                            <i class="bi bi-person me-2 text-primary"></i>
                                                            Holiday Information
                                                        </h5>

                                                        <div class="row g-3">

                                                            <div class="col-lg-8">
                                                                <label class="form-label fw-medium">
                                                                    Name
                                                                </label>
                                                                <input type="text" class="form-control" id="name"
                                                                    name="name" placeholder="Ex: Easter, Christmas, etc"
                                                                    required>
                                                            </div>

                                                            <div class="col-lg-4">
                                                                <label class="form-label fw-medium">
                                                                    Date
                                                                </label>
                                                                <input type="date" class="form-control" id="date"
                                                                    name="date" placeholder="Enter date" required>
                                                            </div>

                                                        </div>
                                                    </div>

                                                </form>

                                            </div>

                                            <div class="card-footer bg-light border-0 p-4">
                                                <div class="d-flex justify-content-end gap-2">

                                                    <a href="/holiday/holidays" class="btn btn-outline-secondary px-4">
                                                        Cancel
                                                    </a>

                                                    <button type="submit" form="userForm" class="btn btn-primary px-4"
                                                        id="submit">
                                                        <i class="bi bi-check-circle me-2"></i>
                                                        Create holiday
                                                    </button>

                                                </div>
                                            </div>

                                        </div>

                            </div>
                        </div>
                    </div>
                    <%- include('partials/footer.ejs') %>
    </body>

    </html>