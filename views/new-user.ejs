<%- include('partials/head.ejs') %>

    <body>
        <%- include('partials/sidebar.ejs') %>
            <%- include('partials/header.ejs') %>
                <main class="nxl-container">
                    <div class="nxl-content">
                        <div class="page-header">
                            <div class="page-header-left d-flex align-items-center">
                                <div class="page-header-title">
                                    <h5 class="m-b-10">B-Leave</h5>
                                </div>
                                <ul class="breadcrumb">
                                    <li class="breadcrumb-item">Users</li>
                                    <li class="breadcrumb-item">New user</li>
                                </ul>
                            </div>
                            <div class="page-header-right ms-auto">
                                <div class="page-header-right-items">
                                    <div class="d-flex d-md-none">
                                        <a href="javascript:void(0)" class="page-header-right-close-toggle">
                                            <i class="feather-arrow-left me-2"></i>
                                            <span>Back</span>
                                        </a>
                                    </div>
                                </div>
                                <div class="d-md-none d-flex align-items-center">
                                    <a href="javascript:void(0)" class="page-header-right-open-toggle">
                                        <i class="feather-align-right fs-20"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <!-- [ page-header ] end -->
                        <div class="bg-white py-3 border-bottom rounded-0 p-md-0 mb-0">
                            <div class="d-md-none d-flex align-items-center justify-content-between">
                                <a href="javascript:void(0)" class="page-content-left-open-toggle">
                                    <i class="feather-align-left fs-20"></i>
                                </a>
                            </div>
                        </div>
                        <!-- [ Main Content ] start -->
                        <div class="main-content">
                            <div class="tab-content">
                                <div class="tab-pane fade active show" id="overviewTab">
                                    <div class="row">
                                        <div class="col-12">
                                            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                                                <!-- Header -->
                                                <div class="bg-gradient p-4 border-bottom border-1">
                                                    <div
                                                        class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                                                        <div>
                                                            <h3 class="mb-1 fw-semibold">
                                                                New User
                                                            </h3>
                                                            <p class="mb-0">
                                                                Create a new application account and assign permissions.
                                                            </p>
                                                        </div>

                                                        <div class="bg-white bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center"
                                                            style="width:64px;height:64px;">
                                                            <i class="bi bi-person-plus-fill text-white fs-3"></i>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="card-body">
                                                    <div class="row">
                                                        <% if (locals.error) { %>
                                                            <div class="alert alert-danger">
                                                                <i class="feather-alert-circle me-2"></i>
                                                                <%= error %>
                                                            </div>
                                                            <% } %>

                                                                <!-- ===== LEFT: FORM ===== -->
                                                                <div class="col-12">
                                                                    <form id="userForm" method="POST"
                                                                        action="/user/new-user">

                                                                        <!-- Recherche Employé -->
                                                                        <div class="mb-4">
                                                                            <h5 class="fw-semibold mb-3">
                                                                                <i
                                                                                    class="bi bi-person me-2 text-primary"></i>
                                                                                Personal Information
                                                                            </h5>

                                                                            <div class="row g-3">
                                                                                <div class="col-lg-2">
                                                                                    <label class="form-label fw-medium">
                                                                                        Employee ID *
                                                                                    </label>
                                                                                    <input type="text"
                                                                                        class="form-control"
                                                                                        id="matricule" name="matricule"
                                                                                        placeholder="AMAA000000"
                                                                                        required>
                                                                                </div>

                                                                                <div class="col-lg-4">
                                                                                    <label class="form-label fw-medium">
                                                                                        Last Name *
                                                                                    </label>
                                                                                    <input type="text"
                                                                                        class="form-control" id="name"
                                                                                        name="name"
                                                                                        placeholder="Enter last name"
                                                                                        required>
                                                                                </div>

                                                                                <div class="col-lg-4">
                                                                                    <label class="form-label">First
                                                                                        Name</label>
                                                                                    <input type="text"
                                                                                        class="form-control"
                                                                                        id="firstName"
                                                                                        placeholder="Enter first name"
                                                                                        name="firstName">
                                                                                </div>

                                                                                <div class="col-lg-2">
                                                                                    <label class="form-label">Phone
                                                                                        *</label>
                                                                                    <input type="text"
                                                                                        class="form-control" id="phone"
                                                                                        name="phone"
                                                                                        placeholder="Enter phone number"
                                                                                        required>
                                                                                </div>

                                                                            </div>
                                                                        </div>

                                                                        <hr>
                                                                        <!-- Recherche Employé -->
                                                                        <div class="mb-4">
                                                                            <h5 class="fw-semibold mb-3">
                                                                                <i
                                                                                    class="bi bi-person-badge me-2 text-primary"></i>
                                                                                Access & Permissions
                                                                            </h5>

                                                                            <div class="row g-3">

                                                                                <div class="col-lg-4">
                                                                                    <label
                                                                                        class="form-label">Email</label>
                                                                                    <input type="email"
                                                                                        class="form-control" id="email"
                                                                                        name="email"
                                                                                        placeholder="example@company.com">
                                                                                </div>

                                                                                <div class="col-lg-4">
                                                                                    <label class="form-label">Role
                                                                                        *</label>
                                                                                    <select class="form-select"
                                                                                        id="role" name="role" required>

                                                                                        <%
                                                                                            Object.keys(userRole).forEach(key=>
                                                                                            { %>
                                                                                            <option
                                                                                                value="<%= userRole[key] %>">
                                                                                                <%= userRole[key] %>
                                                                                            </option>
                                                                                            <% }) %>

                                                                                    </select>
                                                                                </div>

                                                                                <div class="col-lg-4">
                                                                                    <label class="form-label">Site
                                                                                        *</label>
                                                                                    <select class="form-select"
                                                                                        id="site" name="site" required>

                                                                                        <%
                                                                                            Object.keys(sites).forEach(key=>
                                                                                            { %>
                                                                                            <option
                                                                                                value="<%= sites[key] %>">
                                                                                                <%= allowedKeys[key] %>
                                                                                            </option>
                                                                                            <% }) %>

                                                                                    </select>
                                                                                </div>

                                                                            </div>
                                                                        </div>

                                                                        <hr>
                                                                        <!-- Recherche Employé -->
                                                                        <div>
                                                                            <h5 class="fw-semibold mb-3">
                                                                                <i
                                                                                    class="feather-lock me-2 text-primary"></i>
                                                                                Security
                                                                            </h5>

                                                                            <div class="row g-3">

                                                                                <div class="col-lg-6">
                                                                                    <label class="form-label">
                                                                                        Password *
                                                                                    </label>

                                                                                    <div class="input-group">
                                                                                        <input type="password"
                                                                                            class="form-control"
                                                                                            id="password"
                                                                                            name="password" required>

                                                                                        <button
                                                                                            class="btn btn-outline-secondary"
                                                                                            type="button"
                                                                                            onclick="togglePassword('password')">

                                                                                            <i class="feather-eye"></i>
                                                                                        </button>
                                                                                    </div>
                                                                                </div>

                                                                                <div class="col-lg-6">
                                                                                    <label class="form-label">
                                                                                        Confirm Password *
                                                                                    </label>

                                                                                    <div class="input-group">
                                                                                        <input type="password"
                                                                                            class="form-control"
                                                                                            id="confirmPassword"
                                                                                            name="confirmPassword"
                                                                                            required>

                                                                                        <button
                                                                                            class="btn btn-outline-secondary"
                                                                                            type="button"
                                                                                            onclick="togglePassword('confirmPassword')">

                                                                                            <i class="feather-eye"></i>
                                                                                        </button>
                                                                                    </div>
                                                                                </div>

                                                                            </div>
                                                                        </div>

                                                                    </form>
                                                                </div>

                                                    </div>

                                                </div>

                                                <div class="card-footer border-top bg-light">
                                                    <div class="d-flex justify-content-end gap-2">

                                                        <a href="/user/list" class="btn btn-light">
                                                            Cancel
                                                        </a>

                                                        <button type="submit" form="userForm" class="btn btn-primary">

                                                            <i class="feather-save me-2"></i>
                                                            Create User
                                                        </button>

                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    </div>
                    <%- include('partials/new-leave-modal-test') %>
                        <%- include('partials/footer.ejs') %>
    </body>
    <script>
        const roleSelect = document.getElementById("role");
        const siteSelect = document.getElementById("site");

        // Sauvegarder toutes les options originales
        const allSiteOptions = Array.from(siteSelect.options);

        function filterSites() {
            const role = roleSelect.value;

            // Roles limités
            const restrictedRoles = ["HR_LEAD", "MANAGER", "ADMIN", "PAYROLL"];

            // Sites autorisés pour ces rôles
            const allowedSites = ["TANA", "ABE 1", "ABE 2"];

            // Vider les options actuelles
            siteSelect.innerHTML = "";

            let filteredOptions;

            if (restrictedRoles.includes(role)) {
                filteredOptions = allSiteOptions.filter(option =>
                    allowedSites.includes(option.value)
                );
            } else {
                filteredOptions = allSiteOptions;
            }

            // Réajouter les options filtrées
            filteredOptions.forEach(option => {
                siteSelect.appendChild(option.cloneNode(true));
            });
        }

        // Déclencher au changement du rôle
        roleSelect.addEventListener("change", filterSites);

        // Exécuter au chargement de la page
        filterSites();
    </script>
    <script>
        function togglePassword(id) {
            const input = document.getElementById(id);

            input.type =
                input.type === "password"
                    ? "text"
                    : "password";
        }
    </script>

    </html>