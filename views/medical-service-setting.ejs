<%- include('partials/head.ejs') %>

    <body>
        <%- include('partials/sidebar.ejs') %>
            <%- include('partials/header.ejs') %>
                <main class="nxl-container">
                    <div class="nxl-content">
                        <div class="page-header">
                            <div class="page-header-left d-flex align-items-center">
                                <div class="page-header-title">
                                    <h5 class="m-b-10">B-Leave</h5>
                                </div>
                                <ul class="breadcrumb">
                                    <li class="breadcrumb-item">Medical service</li>
                                    <li class="breadcrumb-item">Settings</li>
                                </ul>
                            </div>
                            <div class="page-header-right ms-auto">
                                <div class="page-header-right-items">
                                    <div class="d-flex d-md-none">
                                        <a href="javascript:void(0)" class="page-header-right-close-toggle">
                                            <i class="feather-arrow-left me-2"></i>
                                            <span>Back</span>
                                        </a>
                                    </div>
                                </div>
                                <div class="d-md-none d-flex align-items-center">
                                    <a href="javascript:void(0)" class="page-header-right-open-toggle">
                                        <i class="feather-align-right fs-20"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <!-- [ page-header ] end -->
                        <div class="bg-white py-3 border-bottom rounded-0 p-md-0 mb-0">
                            <div class="d-md-none d-flex align-items-center justify-content-between">
                                <a href="javascript:void(0)" class="page-content-left-open-toggle">
                                    <i class="feather-align-left fs-20"></i>
                                </a>
                            </div>
                        </div>
                        <!-- [ Main Content ] start -->
                        <div class="main-content">
                            <div class="tab-content">
                                <div class="tab-pane fade active show" id="overviewTab">
                                    <div class="row">

                                        <div class="col-12">
                                            <div class="card stretch stretch-full">
                                                <div class="card-body border-bottom border-1">
                                                    <div
                                                        class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">

                                                        <div>
                                                            <h3 class="fw-bold mb-1">
                                                                Medical Services
                                                            </h3>

                                                            <p class="text-muted mb-0">
                                                                Manage available medical services used by the medical
                                                                department.
                                                            </p>
                                                            <span
                                                                class="badge bg-soft-primary text-primary fs-12 px-3 py-2">
                                                                <%= data.length %> Service(s)
                                                            </span>
                                                        </div>

                                                        <div class="d-flex gap-2">

                                                            <a href="/medical-service/new-medical-service"
                                                                class="btn btn-primary">
                                                                <i class="feather-plus me-2"></i>
                                                                New Service
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="card-body p-0">

                                                    <% if(data.length> 0){ %>

                                                        <div class="table-responsive">
                                                            <table class="table table-hover align-middle mb-0">

                                                                <thead class="table-light">
                                                                    <tr>
                                                                        <th style="width:80px;" class="text-center">
                                                                            #
                                                                        </th>

                                                                        <th>
                                                                            Service Name
                                                                        </th>

                                                                        <th class="text-end">
                                                                            Actions
                                                                        </th>
                                                                    </tr>
                                                                </thead>

                                                                <tbody>

                                                                    <% var i=1; %>

                                                                        <% data.forEach(service=> { %>

                                                                            <tr>

                                                                                <td style="width:80px;" class="text-center fw-semibold
                                                                                    text-muted">
                                                                                    <%= i++ %>
                                                                                </td>

                                                                                <td>
                                                                                    <div
                                                                                        class="d-flex align-items-center">

                                                                                        <div
                                                                                            class="avatar-text avatar-md bg-soft-primary text-primary m-0 me-3">
                                                                                            <i
                                                                                                class="feather-plus-square"></i>
                                                                                        </div>

                                                                                        <div>
                                                                                            <div class="fw-semibold">
                                                                                                <%= service.name %>
                                                                                            </div>

                                                                                            <small class="text-muted">
                                                                                                Medical Service
                                                                                            </small>
                                                                                        </div>

                                                                                    </div>
                                                                                </td>

                                                                                <td>

                                                                                    <div
                                                                                        class="d-flex justify-content-end gap-2 m-0 p-0">

                                                                                        <a href="/medical-service/edit-medical-service/<%= service.id %>"
                                                                                            class="btn btn-primary"
                                                                                            title="Edit">

                                                                                            <i
                                                                                                class="feather-edit-2"></i>
                                                                                        </a>

                                                                                        <form
                                                                                            action="/medical-service/delete-medical-service/<%= service.id %>"
                                                                                            method="post"
                                                                                            onsubmit="return confirm('Delete this service?')">

                                                                                            <button type="submit"
                                                                                                class="btn btn-outline-danger"
                                                                                                title="Delete">

                                                                                                <i
                                                                                                    class="feather-trash-2"></i>
                                                                                            </button>

                                                                                        </form>

                                                                                    </div>

                                                                                </td>

                                                                            </tr>

                                                                            <% }) %>

                                                                </tbody>

                                                            </table>
                                                        </div>

                                                        <% } else { %>

                                                            <div class="text-center py-5">

                                                                <div class="mb-3">
                                                                    <i class="feather-folder fs-1 text-muted"></i>
                                                                </div>

                                                                <h5>No Medical Services Found</h5>

                                                                <p class="text-muted mb-4">
                                                                    Create your first medical service to get started.
                                                                </p>

                                                                <a href="/medical-service/new-medical-service"
                                                                    class="btn btn-primary">
                                                                    <i class="feather-plus me-2"></i>
                                                                    Create Service
                                                                </a>

                                                            </div>

                                                            <% } %>

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <%- include('partials/footer.ejs') %>